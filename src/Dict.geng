module Dict exposing
    ( Dict
    , empty, singleton, set, update, updateWithDefault, remove
    , isEmpty, count, get, member, first, last, findFirst, findLast, any, all
    , keys, values
    , map, foldl, foldr, keepIf, mapAndKeepJust, partition
    , union, intersect, diff, merge
    , fromStringPairs
    )

{-| A dictionary mapping unique keys to values. The keys can be any type with
an `Ord` instance. This includes `Int`, `Float`, `Char` and `String`.

Set, remove, and query operations all take _O(log n)_ time.


@docs Dict


@docs empty, singleton, set, update, updateWithDefault, remove


## Query

@docs isEmpty, count, get, member, first, last, findFirst, findLast, any, all


## Arrays

@docs keys, values


## Transform

@docs map, foldl, foldr, keepIf, mapAndKeepJust, partition


## Combine

@docs union, intersect, diff, merge


## Kernel

@docs fromStringPairs

-}


import Array exposing (Array)
import Array.Builder
import Basics exposing (..)
import Inspect exposing (Inspect)
import Maybe exposing (..)
import String exposing (String)



-- DICTIONARIES
-- The color of a node. Leaves are considered Black.


type NColor
    = Red
    | Black


{-| A dictionary of keys and values. So a `Dict String User` is a dictionary
that lets you look up a `String` (such as user names) and find the associated
`User`.

    import Dict exposing ( Dict )

    users : Dict String User
    users =
        Dict.empty
            |> Dict.set "Alice" (makeUser "Alice" 28 1.65)
            |> Dict.set "Bob" (makeUser "Bob" 19 1.82)
            |> Dict.set "Chuck" (makeUser "Chuck" 33 1.75)

    type alias User =
        { name : String
        , age : Int
        , height : Float
        }

    makeUser : String -> Int -> Float -> User
    makeUser name age height =
        { name = name
        , age = age
        , height = height
        }
-}
type Dict k v
    = RBNode_gren_builtin { color : NColor, key : k, value : v, left : (Dict k v), right : (Dict k v) }
    | RBEmpty_gren_builtin


{-| Create an empty dictionary.
-}
empty : Dict k v
empty =
    RBEmpty_gren_builtin


node : NColor -> k -> v -> Dict k v -> Dict k v -> Dict k v
node color key value left right =
    RBNode_gren_builtin
        { color = color
        , key = key
        , value = value
        , left = left
        , right = right
        }


{-| Get the value associated with a key. If the key is not found, return
`Nothing`. This is useful when you are not sure if a key will be in the
dictionary.

    animals = Dict.empty |> Dict.set "Tom" Cat |> Dict.set "Jerry" Mouse

    get "Tom"   animals == Just Cat
    get "Jerry" animals == Just Mouse
    get "Spike" animals == Nothing

-}
get : Ord k => k -> Dict k v -> Maybe v
get targetKey dict =
    when dict is
        RBEmpty_gren_builtin ->
            Nothing

        RBNode_gren_builtin { key, value, left, right } ->
            when compare targetKey key is
                LT ->
                    get targetKey left

                EQ ->
                    Just value

                GT ->
                    get targetKey right


{-| Determine if a key is in a dictionary.
-}
member : Ord k => k -> Dict k v -> Bool
member key dict =
    when get key dict is
        Just _ ->
            True

        Nothing ->
            False


{-| Determine the number of key-value pairs in the dictionary.
-}
count : Dict k v -> Int
count dict =
    countHelp 0 dict


countHelp : Int -> Dict k v -> Int
countHelp n dict =
    when dict is
        RBEmpty_gren_builtin ->
            n

        RBNode_gren_builtin { left, right } ->
            countHelp (countHelp (n + 1) right) left


{-| Retrieve the first, or lowest, key-value pair.
-}
first : Dict k v -> Maybe { key : k, value : v }
first dict =
    when dict is
        RBEmpty_gren_builtin ->
            Nothing

        RBNode_gren_builtin { key, value, left = RBEmpty_gren_builtin } ->
            Just { key = key, value = value }

        RBNode_gren_builtin { left } ->
            first left


{-| Retrieve the last, or highest, key-value pair.
-}
last : Dict k v -> Maybe { key : k, value : v }
last dict =
    when dict is
        RBEmpty_gren_builtin ->
            Nothing

        RBNode_gren_builtin { key, value, right = RBEmpty_gren_builtin } ->
            Just { key = key, value = value }

        RBNode_gren_builtin { right } ->
            last right


{-| Find the first key-value pair that passes the test.
-}
findFirst : (k -> v -> Bool) -> Dict k v -> Maybe { key : k, value : v }
findFirst fn dict =
    when dict is
        RBEmpty_gren_builtin ->
            Nothing

        RBNode_gren_builtin { key, value, left, right } ->
            when findFirst fn left is
                Nothing ->
                    if fn key value then
                        Just { key = key, value = value }

                    else
                        findFirst fn right

                foundValue ->
                    foundValue


{-| Find the last key-value pair that passes the test.
-}
findLast : (k -> v -> Bool) -> Dict k v -> Maybe { key : k, value : v }
findLast fn dict =
    when dict is
        RBEmpty_gren_builtin ->
            Nothing

        RBNode_gren_builtin { key, value, left, right } ->
            when findLast fn right is
                Nothing ->
                    if fn key value then
                        Just { key = key, value = value }

                    else
                        findLast fn left

                foundValue ->
                    foundValue


{-| Checks if any key-value pair in the dictionary passes the test.
-}
any : (k -> v -> Bool) -> Dict k v -> Bool
any fn dict =
    when findFirst fn dict is
        Just _ ->
            True

        Nothing ->
            False


{-| Checks if all key-value pairs in the dictionary passes the test.
-}
all : (k -> v -> Bool) -> Dict k v -> Bool
all fn dict =
    when findFirst (\key value -> not <| fn key value) dict is
        Just _ ->
            False

        Nothing ->
            True


-- Kernel code cannot pass a witness (`docs/m1b-classes.md` §G29). A constrained
-- binding takes its witnesses before its first real argument, so JavaScript
-- that writes `A3(__Dict_set, key, value, dict)` now has the arity wrong and
-- builds a partial application instead of a dictionary. The JavaScript that
-- has to build a `Dict String v` -- environment variables, HTTP headers --
-- hands its pairs to this instead, where `Ord String` is resolved at a known
-- type and nothing is abstracted over.


{-| Build a `Dict String v` from an array of pairs.

This exists for kernel code and there is no reason to reach for it: `Array.foldl`
and `set` say the same thing and read better.
-}
fromStringPairs : Array { key : String, value : v } -> Dict String v
fromStringPairs pairs =
    Array.foldl (\pair dict -> set pair.key pair.value dict) empty pairs


{-| Determine if a dictionary is empty.

    isEmpty empty == True

-}
isEmpty : Dict k v -> Bool
isEmpty dict =
    when dict is
        RBEmpty_gren_builtin ->
            True

        RBNode_gren_builtin _ ->
            False


{-| Sets a value for a given key. Existing values will be replaced.
If the key isn't already registered, the key-value pair will be inserted.
-}
set : Ord k => k -> v -> Dict k v -> Dict k v
set setKey setValue dict =
    -- Root node is always Black
    when setHelp setKey setValue dict is
        RBNode_gren_builtin { color = Red, key, value, left, right } ->
            node Black key value left right

        x ->
            x


setHelp : Ord k => k -> v -> Dict k v -> Dict k v
setHelp key value dict =
    when dict is
        RBEmpty_gren_builtin ->
            -- New nodes are always red. If it violates the rules, it will be fixed
            -- when balancing.
            node Red key value RBEmpty_gren_builtin RBEmpty_gren_builtin

        RBNode_gren_builtin { color = nColor, key = nKey, value = nValue, left =  nLeft, right = nRight } ->
            when compare key nKey is
                LT ->
                    balance nColor nKey nValue (setHelp key value nLeft) nRight

                EQ ->
                    node nColor nKey value nLeft nRight

                GT ->
                    balance nColor nKey nValue nLeft (setHelp key value nRight)


balance : NColor -> k -> v -> Dict k v -> Dict k v -> Dict k v
balance color key value left right =
    when right is
        RBNode_gren_builtin { color = Red, key = rK, value = rV, left = rLeft, right = rRight } ->
            when left is
                RBNode_gren_builtin { color = Red, key = lK, value = lV, left = lLeft, right = lRight } ->
                    node Red key value (node Black lK lV lLeft lRight) (node Black rK rV rLeft rRight)

                _ ->
                    node color rK rV (node Red key value left rLeft) rRight

        _ ->
            when left is
                RBNode_gren_builtin { color = Red, key = lK, value = lV, left = RBNode_gren_builtin { color = Red, key = llK, value = llV, left = llLeft, right = llRight }, right = lRight } ->
                    node Red lK lV (node Black llK llV llLeft llRight) (node Black key value lRight right)

                _ ->
                    node color key value left right


{-| Remove a key-value pair from a dictionary. If the key is not found,
no changes are made.
-}
remove : Ord k => k -> Dict k v -> Dict k v
remove key dict =
    -- Root node is always Black
    when removeHelp key dict is
        RBNode_gren_builtin { color = Red, key = nKey, value, left, right } ->
            node Black nKey value left right

        x ->
            x


{-| The easiest thing to remove from the tree, is a red node. However, when searching for the
node to remove, we have no way of knowing if it will be red or not. This remove implementation
makes sure that the bottom node is red by moving red colors down the tree through rotation
and color flips. Any violations this will cause, can easily be fixed by balancing on the way
up again.
-}
removeHelp : Ord k => k -> Dict k v -> Dict k v
removeHelp targetKey dict =
    when dict is
        RBEmpty_gren_builtin ->
            RBEmpty_gren_builtin

        RBNode_gren_builtin { color, key, value, left, right } ->
            if targetKey < key then
                when left is
                    RBNode_gren_builtin { color = Black, left = lLeft } ->
                        when lLeft is
                            RBNode_gren_builtin { color = Red } ->
                                node color key value (removeHelp targetKey left) right

                            _ ->
                                when moveRedLeft dict is
                                    RBNode_gren_builtin { color = nColor, key = nKey, value = nValue, left = nLeft, right = nRight } ->
                                        balance nColor nKey nValue (removeHelp targetKey nLeft) nRight

                                    RBEmpty_gren_builtin ->
                                        RBEmpty_gren_builtin

                    _ ->
                        node color key value (removeHelp targetKey left) right

            else
                removeHelpEQGT targetKey (removeHelpPrepEQGT targetKey dict color key value left right)


removeHelpPrepEQGT : Ord k => k -> Dict k v -> NColor -> k -> v -> Dict k v -> Dict k v -> Dict k v
removeHelpPrepEQGT targetKey dict color key value left right =
    when left is
        RBNode_gren_builtin { color = Red, key = lK, value = lV, left = lLeft, right = lRight } ->
            node color lK lV lLeft (node Red key value lRight right)

        _ ->
            when right is
                RBNode_gren_builtin { color = Black, left = RBNode_gren_builtin { color = Black } } ->
                    moveRedRight dict

                RBNode_gren_builtin { color = Black, left = RBEmpty_gren_builtin } ->
                    moveRedRight dict

                _ ->
                    dict


{-| When we find the node we are looking for, we can remove by replacing the key-value
pair with the key-value pair of the left-most node on the right side (the closest pair).
-}
removeHelpEQGT : Ord k => k -> Dict k v -> Dict k v
removeHelpEQGT targetKey dict =
    when dict is
        RBNode_gren_builtin { color, key, value, left, right } ->
            -- `compare ... is EQ` rather than `targetKey == key`, which is what
            -- this said while `==` was the kernel's structural walker. A `Dict`
            -- is ordered by `compare` and searched by it a few lines above
            -- (`getHelp`), so asking a second question here was a latent
            -- disagreement as well as an `Eq k` this signature does not carry.
            when compare targetKey key is
                EQ ->
                    when getMin right is
                        RBNode_gren_builtin { key = minKey, value = minValue } ->
                            balance color minKey minValue left (removeMin right)

                        RBEmpty_gren_builtin ->
                            RBEmpty_gren_builtin

                _ ->
                    balance color key value left (removeHelp targetKey right)

        RBEmpty_gren_builtin ->
            RBEmpty_gren_builtin


getMin : Dict k v -> Dict k v
getMin dict =
    when dict is
        RBNode_gren_builtin { left = ((RBNode_gren_builtin _) as left) } ->
            getMin left

        _ ->
            dict


removeMin : Dict k v -> Dict k v
removeMin dict =
    when dict is
        RBNode_gren_builtin { color, key, value, left = ((RBNode_gren_builtin { color = lColor, left = lLeft }) as left), right } ->
            when lColor is
                Black ->
                    when lLeft is
                        RBNode_gren_builtin { color = Red } ->
                            node color key value (removeMin left) right

                        _ ->
                            when moveRedLeft dict is
                                RBNode_gren_builtin { color = nColor, key = nKey, value = nValue, left = nLeft, right = nRight } ->
                                    balance nColor nKey nValue (removeMin nLeft) nRight

                                RBEmpty_gren_builtin ->
                                    RBEmpty_gren_builtin

                _ ->
                    node color key value (removeMin left) right

        _ ->
            RBEmpty_gren_builtin


moveRedLeft : Dict k v -> Dict k v
moveRedLeft dict =
    when dict is
        RBNode_gren_builtin { color = clr, key = k, value = v, left = RBNode_gren_builtin { color = lClr, key = lK, value = lV, left = lLeft, right = lRight }, right = RBNode_gren_builtin { color = rClr, key = rK, value = rV, left = (RBNode_gren_builtin { color = Red, key = rlK, value = rlV, left = rlL, right = rlR }) as rLeft, right = rRight } } ->
            node
                Red
                rlK
                rlV
                (node Black k v (node Red lK lV lLeft lRight) rlL)
                (node Black rK rV rlR rRight)

        RBNode_gren_builtin { color = clr, key = k, value = v, left = RBNode_gren_builtin { color = lClr, key = lK, value = lV, left = lLeft, right = lRight }, right = RBNode_gren_builtin { color = rClr, key = rK, value = rV, left = rLeft, right = rRight } } ->
            node
                Black
                k
                v
                (node Red lK lV lLeft lRight)
                (node Red rK rV rLeft rRight)

        _ ->
            dict


moveRedRight : Dict k v -> Dict k v
moveRedRight dict =
    when dict is
        RBNode_gren_builtin { color = clr, key = k, value = v, left = RBNode_gren_builtin { color = lClr, key = lK, value = lV, left = RBNode_gren_builtin { color = Red, key = llK, value = llV, left = llLeft, right = llRight }, right = lRight }, right = RBNode_gren_builtin { color = rClr, key = rK, value = rV, left = rLeft, right = rRight } } ->
            node
                Red
                lK
                lV
                (node Black llK llV llLeft llRight)
                (node Black k v lRight (node Red rK rV rLeft rRight))

        RBNode_gren_builtin { color = clr, key = k, value = v, left = RBNode_gren_builtin { color = lClr, key = lK, value = lV, left = lLeft, right = lRight }, right = RBNode_gren_builtin { color = rClr, key = rK, value = rV, left = rLeft, right = rRight } } ->
            node
                Black
                k
                v
                (node Red lK lV lLeft lRight)
                (node Red rK rV rLeft rRight)

        _ ->
            dict


{-| Update the value of a dictionary for a specific key with a given function.
-}
update : Ord k => k -> (Maybe v -> Maybe v) -> Dict k v -> Dict k v
update targetKey alter dictionary =
    -- One descent: `alter` runs where the key is, or where it would go, and
    -- the path is rebuilt on the way back up (geng-lang m2-beam-toptier.md
    -- §TT14.3). Only a removal walks the tree a second time.
    when updateHelp targetKey alter dictionary is
        Unchanged ->
            dictionary

        Changed (RBNode_gren_builtin { color = Red, key, value, left, right }) ->
            node Black key value left right

        Changed changed ->
            changed

        Removed ->
            remove targetKey dictionary


type Updated k v
    = Unchanged
    | Changed (Dict k v)
    | Removed


updateHelp : Ord k => k -> (Maybe v -> Maybe v) -> Dict k v -> Updated k v
updateHelp key alter dict =
    when dict is
        RBEmpty_gren_builtin ->
            when alter Nothing is
                Just value ->
                    Changed (node Red key value RBEmpty_gren_builtin RBEmpty_gren_builtin)

                Nothing ->
                    Unchanged

        RBNode_gren_builtin { color = nColor, key = nKey, value = nValue, left = nLeft, right = nRight } ->
            when compare key nKey is
                LT ->
                    when updateHelp key alter nLeft is
                        Changed newLeft ->
                            Changed (balance nColor nKey nValue newLeft nRight)

                        other ->
                            other

                EQ ->
                    when alter (Just nValue) is
                        Just value ->
                            Changed (node nColor nKey value nLeft nRight)

                        Nothing ->
                            Removed

                GT ->
                    when updateHelp key alter nRight is
                        Changed newRight ->
                            Changed (balance nColor nKey nValue nLeft newRight)

                        other ->
                            other


{-| Same as [update](#update) but if the key doesn't exist in the dictionary, a default value
is passed to the provided update function instead of a `Maybe`.
-}
updateWithDefault : Ord k => k -> v -> (v -> v) -> Dict k v -> Dict k v
updateWithDefault targetKey defaultValue alter dictionary =
    update targetKey
        (\found ->
            when found is
                Just value ->
                    Just (alter value)

                Nothing ->
                    Just (alter defaultValue)
        )
        dictionary


{-| Create a dictionary with one key-value pair.
-}
singleton : Ord k => k -> v -> Dict k v
singleton key value =
    -- Root node is always Black
    node Black key value RBEmpty_gren_builtin RBEmpty_gren_builtin



-- TRANSIENT
--
-- A loop that threads a `Dict` through itself and keeps no old version of it
-- updates the tree in place (geng-lang D579, D582, `m3-fold.md` §FL10). The
-- compiler's `Core.Pass.Transient` finds the loop, takes an owner where the
-- loop is entered, and calls the twins below where the loop calls `set`,
-- `update`, `updateWithDefault` and `remove`. Nothing else calls them.
--
-- Each twin is its original case for case, with `node c k v l r` replaced by
-- `dictEdit` of the node the case took apart, which writes that node if this
-- loop made it and copies it once if not, carrying the owner: Clojure's
-- editable nodes (`m3-inplace.md` §IP3). Every argument handed to an edit is a
-- name bound where a node was matched, never a field read after a write, so
-- the order a backend evaluates arguments in cannot see one. Each primitive
-- answers the node it made or wrote and only that answer is used, so where
-- nothing is written in place (the BEAM, or owner 0) they are the originals.


{-| A fresh owner, or 0 where nothing is written in place. -}
@prim("dict_owner")
dictOwner : {} -> Int


{-| A node carrying the owner. -}
@prim("dict_node")
dictNode : Int -> NColor -> k -> v -> Dict k v -> Dict k v -> Dict k v


{-| A node with its colour and children replaced: written if it carries the
owner, itself if nothing changes, a copy carrying the owner otherwise. -}
@prim("dict_edit")
dictEdit : Int -> Dict k v -> NColor -> Dict k v -> Dict k v -> Dict k v


{-| A node with its value replaced, the same way. -}
@prim("dict_edit_value")
dictEditValue : Int -> Dict k v -> v -> Dict k v


{-| `set`'s twin. -}
setT : Ord k => Int -> k -> v -> Dict k v -> Dict k v
setT owner setKey setValue dict =
    blackenT owner (setHelpT owner setKey setValue dict)


blackenT : Int -> Dict k v -> Dict k v
blackenT owner dict =
    when dict is
        RBNode_gren_builtin { color = Red, left, right } ->
            dictEdit owner dict Black left right

        _ ->
            dict


setHelpT : Ord k => Int -> k -> v -> Dict k v -> Dict k v
setHelpT owner key value dict =
    when dict is
        RBEmpty_gren_builtin ->
            dictNode owner Red key value RBEmpty_gren_builtin RBEmpty_gren_builtin

        RBNode_gren_builtin { color = nColor, key = nKey, left = nLeft, right = nRight } ->
            when compare key nKey is
                LT ->
                    balanceT owner dict nColor (setHelpT owner key value nLeft) nRight

                EQ ->
                    dictEditValue owner dict value

                GT ->
                    balanceT owner dict nColor nLeft (setHelpT owner key value nRight)


{-| `balance color key value left right`, where `color`, `key` and `value`
are `n`'s and `color` was read before anything was written. -}
balanceT : Int -> Dict k v -> NColor -> Dict k v -> Dict k v -> Dict k v
balanceT owner n color left right =
    when right is
        RBNode_gren_builtin { color = Red, left = rLeft, right = rRight } ->
            when left is
                RBNode_gren_builtin { color = Red, left = lLeft, right = lRight } ->
                    dictEdit owner n Red (dictEdit owner left Black lLeft lRight) (dictEdit owner right Black rLeft rRight)

                _ ->
                    dictEdit owner right color (dictEdit owner n Red left rLeft) rRight

        _ ->
            when left is
                RBNode_gren_builtin { color = Red, left = (RBNode_gren_builtin { color = Red, left = llLeft, right = llRight }) as ll, right = lRight } ->
                    dictEdit owner left Red (dictEdit owner ll Black llLeft llRight) (dictEdit owner n Black lRight right)

                _ ->
                    dictEdit owner n color left right


{-| `update`'s twin, which answers no `Updated`: its help answers the empty
dictionary where `updateHelp` answers `Unchanged` or `Removed`, which `member`
then tells apart, since `alter` has been called and must not be again. -}
updateT : Ord k => Int -> k -> (Maybe v -> Maybe v) -> Dict k v -> Dict k v
updateT owner targetKey alter dictionary =
    when updateHelpT owner targetKey alter dictionary is
        RBEmpty_gren_builtin ->
            if member targetKey dictionary then
                removeT owner targetKey dictionary

            else
                dictionary

        changed ->
            blackenT owner changed


updateHelpT : Ord k => Int -> k -> (Maybe v -> Maybe v) -> Dict k v -> Dict k v
updateHelpT owner key alter dict =
    when dict is
        RBEmpty_gren_builtin ->
            when alter Nothing is
                Just value ->
                    dictNode owner Red key value RBEmpty_gren_builtin RBEmpty_gren_builtin

                Nothing ->
                    RBEmpty_gren_builtin

        RBNode_gren_builtin { color = nColor, key = nKey, value = nValue, left = nLeft, right = nRight } ->
            when compare key nKey is
                LT ->
                    when updateHelpT owner key alter nLeft is
                        RBEmpty_gren_builtin ->
                            RBEmpty_gren_builtin

                        newLeft ->
                            balanceT owner dict nColor newLeft nRight

                EQ ->
                    when alter (Just nValue) is
                        Just value ->
                            dictEditValue owner dict value

                        Nothing ->
                            RBEmpty_gren_builtin

                GT ->
                    when updateHelpT owner key alter nRight is
                        RBEmpty_gren_builtin ->
                            RBEmpty_gren_builtin

                        newRight ->
                            balanceT owner dict nColor nLeft newRight


{-| `updateWithDefault`'s twin. -}
updateWithDefaultT : Ord k => Int -> k -> v -> (v -> v) -> Dict k v -> Dict k v
updateWithDefaultT owner targetKey defaultValue alter dictionary =
    updateT owner
        targetKey
        (\found ->
            when found is
                Just value ->
                    Just (alter value)

                Nothing ->
                    Just (alter defaultValue)
        )
        dictionary


{-| `remove`'s twin. -}
removeT : Ord k => Int -> k -> Dict k v -> Dict k v
removeT owner key dict =
    blackenT owner (removeHelpT owner key dict)


removeHelpT : Ord k => Int -> k -> Dict k v -> Dict k v
removeHelpT owner targetKey dict =
    when dict is
        RBEmpty_gren_builtin ->
            RBEmpty_gren_builtin

        RBNode_gren_builtin { color, key, left, right } ->
            if targetKey < key then
                when left is
                    RBNode_gren_builtin { color = Black, left = lLeft } ->
                        when lLeft is
                            RBNode_gren_builtin { color = Red } ->
                                dictEdit owner dict color (removeHelpT owner targetKey left) right

                            _ ->
                                when moveRedLeftT owner dict is
                                    (RBNode_gren_builtin { color = nColor, left = nLeft, right = nRight }) as moved ->
                                        balanceT owner moved nColor (removeHelpT owner targetKey nLeft) nRight

                                    RBEmpty_gren_builtin ->
                                        RBEmpty_gren_builtin

                    _ ->
                        dictEdit owner dict color (removeHelpT owner targetKey left) right

            else
                removeHelpEQGTT owner targetKey (removeHelpPrepEQGTT owner dict color left right)


removeHelpPrepEQGTT : Int -> Dict k v -> NColor -> Dict k v -> Dict k v -> Dict k v
removeHelpPrepEQGTT owner dict color left right =
    when left is
        RBNode_gren_builtin { color = Red, left = lLeft, right = lRight } ->
            dictEdit owner left color lLeft (dictEdit owner dict Red lRight right)

        _ ->
            when right is
                RBNode_gren_builtin { color = Black, left = RBNode_gren_builtin { color = Black } } ->
                    moveRedRightT owner dict

                RBNode_gren_builtin { color = Black, left = RBEmpty_gren_builtin } ->
                    moveRedRightT owner dict

                _ ->
                    dict


{-| The node a removal takes the key of is replaced by a node of its own
carrying the leftmost key and value of its right side, since an edit keeps a
node's key. -}
removeHelpEQGTT : Ord k => Int -> k -> Dict k v -> Dict k v
removeHelpEQGTT owner targetKey dict =
    when dict is
        RBNode_gren_builtin { color, key, value, left, right } ->
            when compare targetKey key is
                EQ ->
                    when getMin right is
                        RBNode_gren_builtin { key = minKey, value = minValue } ->
                            let
                                rest =
                                    removeMinT owner right
                            in
                            balanceT owner (dictNode owner color minKey minValue left rest) color left rest

                        RBEmpty_gren_builtin ->
                            RBEmpty_gren_builtin

                _ ->
                    balanceT owner dict color left (removeHelpT owner targetKey right)

        RBEmpty_gren_builtin ->
            RBEmpty_gren_builtin


removeMinT : Int -> Dict k v -> Dict k v
removeMinT owner dict =
    when dict is
        RBNode_gren_builtin { color, left = ((RBNode_gren_builtin { color = lColor, left = lLeft }) as left), right } ->
            when lColor is
                Black ->
                    when lLeft is
                        RBNode_gren_builtin { color = Red } ->
                            dictEdit owner dict color (removeMinT owner left) right

                        _ ->
                            when moveRedLeftT owner dict is
                                (RBNode_gren_builtin { color = nColor, left = nLeft, right = nRight }) as moved ->
                                    balanceT owner moved nColor (removeMinT owner nLeft) nRight

                                RBEmpty_gren_builtin ->
                                    RBEmpty_gren_builtin

                _ ->
                    dictEdit owner dict color (removeMinT owner left) right

        _ ->
            RBEmpty_gren_builtin


moveRedLeftT : Int -> Dict k v -> Dict k v
moveRedLeftT owner dict =
    when dict is
        RBNode_gren_builtin { left = (RBNode_gren_builtin { left = lLeft, right = lRight }) as left, right = (RBNode_gren_builtin { left = (RBNode_gren_builtin { color = Red, left = rlL, right = rlR }) as rLeft, right = rRight }) as right } ->
            dictEdit owner rLeft Red (dictEdit owner dict Black (dictEdit owner left Red lLeft lRight) rlL) (dictEdit owner right Black rlR rRight)

        RBNode_gren_builtin { left = (RBNode_gren_builtin { left = lLeft, right = lRight }) as left, right = (RBNode_gren_builtin { left = rLeft, right = rRight }) as right } ->
            dictEdit owner dict Black (dictEdit owner left Red lLeft lRight) (dictEdit owner right Red rLeft rRight)

        _ ->
            dict


moveRedRightT : Int -> Dict k v -> Dict k v
moveRedRightT owner dict =
    when dict is
        RBNode_gren_builtin { left = (RBNode_gren_builtin { left = (RBNode_gren_builtin { color = Red, left = llLeft, right = llRight }) as ll, right = lRight }) as left, right = (RBNode_gren_builtin { left = rLeft, right = rRight }) as right } ->
            dictEdit owner left Red (dictEdit owner ll Black llLeft llRight) (dictEdit owner dict Black lRight (dictEdit owner right Red rLeft rRight))

        RBNode_gren_builtin { left = (RBNode_gren_builtin { left = lLeft, right = lRight }) as left, right = (RBNode_gren_builtin { left = rLeft, right = rRight }) as right } ->
            dictEdit owner dict Black (dictEdit owner left Red lLeft lRight) (dictEdit owner right Red rLeft rRight)

        _ ->
            dict



-- COMBINE


{-| Combine two dictionaries. If there is a collision, preference is given
to the first dictionary.

Each pair of the first dictionary is set into the second, so the union costs
the size of the first.
-}
union : Ord k => Dict k v -> Dict k v -> Dict k v
union t1 t2 =
    foldl set t2 t1


{-| Keep a key-value pair when its key appears in the second dictionary.
Preference is given to values in the first dictionary.
-}
intersect : Ord k => Dict k v -> Dict k v -> Dict k v
intersect t1 t2 =
    keepIf (\k _ -> member k t2) t1


{-| Keep a key-value pair when its key does not appear in the second dictionary.
-}
diff : Ord k => Dict k a -> Dict k b -> Dict k a
diff t1 t2 =
    foldl (\k v t -> remove k t) t1 t2



-- TRANSFORM


{-| Apply a function to all values in a dictionary.
-}
map : (k -> a -> b) -> Dict k a -> Dict k b
map func dict =
    when dict is
        RBEmpty_gren_builtin ->
            RBEmpty_gren_builtin

        RBNode_gren_builtin { color, key, value, left, right } ->
            node color key (func key value) (map func left) (map func right)


{-| Fold over the key-value pairs in a dictionary from lowest key to highest key.

    import Dict exposing (Dict)

    getAges : Dict String User -> Array String
    getAges users =
        Dict.foldl addAge [] users

    addAge : String -> User -> Array String -> Array String
    addAge _ user ages =
        user.age :: ages

    -- getAges users == [33,19,28]

-}
foldl : (k -> v -> b -> b) -> b -> Dict k v -> b
foldl func acc dict =
    when dict is
        RBEmpty_gren_builtin ->
            acc

        RBNode_gren_builtin { key, value, left, right } ->
            foldl func (func key value (foldl func acc left)) right


{-| Fold over the key-value pairs in a dictionary from highest key to lowest key.

    import Dict exposing (Dict)

    getAges : Dict String User -> Array String
    getAges users =
        Dict.foldr addAge [] users

    addAge : String -> User -> Array String -> Array String
    addAge _ user ages =
        user.age :: ages

    -- getAges users == [28,19,33]

-}
foldr : (k -> v -> b -> b) -> b -> Dict k v -> b
foldr func acc t =
    when t is
        RBEmpty_gren_builtin ->
            acc

        RBNode_gren_builtin { key, value, left, right } ->
            foldr func (func key value (foldr func acc right)) left


{-| Keep only the key-value pairs that pass the given test.
-}
keepIf : Ord k => (k -> v -> Bool) -> Dict k v -> Dict k v
keepIf isGood dict =
    foldl
        (\k v d ->
            if isGood k v then
                set k v d

            else
                d
        )
        empty
        dict


{-| Remove unwanted results of a map operation.
-}
mapAndKeepJust : Ord k => (k -> v -> Maybe x) -> Dict k v -> Dict k x
mapAndKeepJust toMaybe dict =
    foldl
        (\k v d ->
            when toMaybe k v is
                Just newValue ->
                    set k newValue d

                Nothing ->
                    d
        )
        empty
        dict


{-| Partition a dictionary according to some test. The first dictionary
contains all key-value pairs which passed the test, and the second contains
the pairs that did not.
-}
partition : Ord k => (k -> v -> Bool) -> Dict k v -> { trues : Dict k v, falses : Dict k v }
partition isGood dict =
    let
        add key value { trues, falses } =
            if isGood key value then
                { trues = set key value trues
                , falses = falses
                }

            else
                { trues = trues
                , falses = set key value falses
                }
    in
    foldl add { trues = empty, falses = empty } dict



-- ARRAYS


{-| Get all of the keys in a dictionary, sorted from lowest to highest.

    keys (Dict.empty |> Dict.set 0 "Alice" |> Dict.set 1 "Bob") == [ 0, 1 ]

-}
keys : Dict k v -> Array k
keys dict =
    foldl (\key _ builder -> Array.Builder.pushLast key builder) (Array.Builder.empty 0) dict
        |> Array.Builder.toArray


{-| Get all of the values in a dictionary, in the order of their keys.

    values (Dict.empty |> Dict.set 0 "Alice" |> Dict.set 1 "Bob") == [ "Alice", "Bob" ]

-}
values : Dict k v -> Array v
values dict =
    foldl (\_ value builder -> Array.Builder.pushLast value builder) (Array.Builder.empty 0) dict
        |> Array.Builder.toArray


{-| The most general way of combining two dictionaries. You provide three
accumulators for when a given key appears:

1.  Only in the left dictionary.
2.  In both dictionaries.
3.  Only in the right dictionary.
    You then traverse all the keys from lowest to highest, building up whatever
    you want.

-}
merge :
    Ord k
    => (k -> a -> result -> result)
    -> (k -> a -> b -> result -> result)
    -> (k -> b -> result -> result)
    -> Dict k a
    -> Dict k b
    -> result
    -> result
merge leftStep bothStep rightStep leftDict rightDict initialResult =
    let
        stepState rKey rValue { array, result } =
            when Array.popFirst array is
                Nothing ->
                    { array = array
                    , result = rightStep rKey rValue result
                    }

                Just { first = { key = lKey, value = lValue }, rest } ->
                    if lKey < rKey then
                        stepState rKey rValue 
                            { array = rest
                            , result = leftStep lKey lValue result
                            }

                    else if lKey > rKey then
                        { array = array
                        , result = rightStep rKey rValue result
                        }

                    else
                        { array = rest
                        , result = bothStep lKey lValue rValue result
                        }

        { array = leftovers, result = intermediateResult } =
            foldl stepState { array = toKeyValues leftDict, result = initialResult } rightDict
    in
    Array.foldl (\{ key, value } result -> leftStep key value result) intermediateResult leftovers



{-| The entries in key order, built through the transient: `Array.pushLast`
copies, so a fold over it is quadratic (`docs/m1b-str.md` §T21.1, D163).
-}
toKeyValues : Dict k v -> Array { key : k, value : v }
toKeyValues dict =
    foldl (\key value builder -> Array.Builder.pushLast { key = key, value = value } builder) (Array.Builder.empty 0) dict
        |> Array.Builder.toArray



-- Two dictionaries with the same contents have the same *contents* and
-- different *shapes*: a red-black tree records the order its keys arrived in,
-- so `set 1 .. |> set 2 ..` and `set 2 .. |> set 1 ..` are structurally
-- different values that must compare equal. That is `classes.md` §2.5's
-- headline and the reason `Dict` is one of the two types the spec names as
-- writing its own instance rather than deriving one — the derived answer is
-- not merely private here, it is wrong. Stock Gren corrects it by matching
-- constructor tags inside `_Utils_eqHelp`; that walker is deleted (D142) and
-- this is what replaces the correction.
--
-- The in-order traversal is what both sides are reduced to, and it is
-- canonical because the tree is ordered by `Ord k` and there is only one
-- `Ord k` to order it by (§8.6, an instance is global). `keys` before `values`
-- because a difference in the keys is the common one, and `&&` does not
-- evaluate the second traversal when the first has already answered.
--
-- The context is `Eq`, not `Ord`: ordering built the tree, but comparing two
-- built trees only ever asks whether two elements are the same.


instance (Eq k, Eq v) => Eq (Dict k v) where
    eq a b =
        keys a == keys b && values a == values b


-- `representation.md` R5: `Dict { "a" = 1 }`, which is the record shape with the
-- keys rendered by their own instance rather than written as identifiers. This
-- is what replaces the `Gren/Kernel/Debug.js` special case that printed a
-- red-black tree as a dictionary -- an ordinary instance, in the module that
-- owns the type, exactly as `classes.md` §2.5 asks (`m1b-classes.md` §G43).


instance (Inspect k, Inspect v) => Inspect (Dict k v) where
    inspect dict =
        Inspect.ctor
            "Dict"
            [ Inspect.record
                (foldl
                    (\key value entries ->
                        Array.Builder.pushLast { name = inspect key, value = inspect value } entries
                    )
                    (Array.Builder.empty 0)
                    dict
                    |> Array.Builder.toArray
                )
            ]

    inspectAnnotation _ =
        Inspect.none
