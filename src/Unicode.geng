module Unicode exposing (version)

{-| The Unicode version `core` was built against.

**Generated by `scripts/unicode-tables.py` in the `geng-lang` repository — do
not edit.**

## Costs

This module exposes one value, the version of the Unicode Character Database
that `core`'s tables were generated from. The tables are compiled into `core`,
are the same on every target, and are read with a binary search of fixed size,
so each function that uses them costs a constant a character. Those functions
are `String.toUpper`, `toLower`, `trim`, `words` and the grapheme functions,
and `inspect`'s escaping. Costs are per call.

-}

import String exposing (String)


{-| The version of the Unicode Character Database that every
Unicode-dependent function in `core` answers from — case mapping, whitespace,
and what `inspect` calls non-printable.

    Unicode.version == "17.0.0"

`docs/unicode.md` U3: `core` pins one version, and it is bumped at a minor
version of the language and never at a patch, because a bump changes what
programs print.

It costs O(1).

-}
version : String
version =
    "17.0.0"
