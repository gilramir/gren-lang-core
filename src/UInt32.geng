module UInt32 exposing
    ( minValue, maxValue
    , fromInt, fromIntWrap, fromIntChecked
    , toInt, toIntWrap, toIntChecked
    , fromInt64, fromInt64Wrap, fromInt64Checked
    , fromUInt64, fromUInt64Wrap, fromUInt64Checked
    , toFloat
    , round, floor, ceiling, truncate
    )

{-| The bounds and the conversions of a 32-bit unsigned integer.

The **type** is [Basics.UInt32](Basics#UInt32), for the reason
[Int64](Int64) gives: `+`, `//`, `modBy` and `Bitwise.shiftLeftBy` all work on
a `UInt32` with no import at all.

**When to use one.** For a value that is a bit pattern rather than a quantity:
a hash, a PCG generator's state, a protobuf `fixed32`, four colour channels
packed into a word. Arithmetic wraps at `2^32` the way an `Int`'s wraps at
`2^31` (`docs/arithmetic.md` A6), both right shifts are the logical one, and
`//` and `divFloor` are the same division because there is no sign for them to
disagree about (A11).


## Bounds

@docs minValue, maxValue


## From an `Int`

An `Int` is signed and a `UInt32` is not, so the only `Int` a `UInt32` cannot
hold is a negative one -- and the three names are the three things to do with
it.

@docs fromInt, fromIntWrap, fromIntChecked


## To an `Int`

An `Int` holds 31 bits of magnitude and a `UInt32` holds 32, so the only
`UInt32` an `Int` cannot hold is one above `2147483647`.

**`shiftRightZfBy 0` is not this conversion**, and in Gren before this type
existed it was the thing people reached for. It produced a value typed `Int`
that no 32-bit signed integer can hold; `core`'s own `Random` was built on it
(`docs/m1b-int.md` §I12.4). [toIntWrap](#toIntWrap) is what it was standing in
for, read in the other direction.

@docs toInt, toIntWrap, toIntChecked


## From another width

D151 puts a conversion in the module of the type it **produces**, so this is
every width a `UInt32` can be made from; a `UInt32` goes to another width
through [Int64.fromUInt32](Int64#fromUInt32) and
[UInt64.fromUInt32](UInt64#fromUInt32), which are both exact and have one name
each.

@docs fromInt64, fromInt64Wrap, fromInt64Checked
@docs fromUInt64, fromUInt64Wrap, fromUInt64Checked


## To a float

@docs toFloat


## From a float

A10's float-to-integer family, at this width: each **saturates** at
[minValue](#minValue) and [maxValue](#maxValue), a `NaN` is `0`, and each takes
a `Float` only, a `Float32` widening first. [Math](Math)'s four of these names
are the same operations at `Int` (D152).

@docs round, floor, ceiling, truncate

-}

import Basics exposing (Bool, Float, Int, Int64, UInt32, UInt64, Num, Ord, (<), (>))
import Int64
import Maybe exposing (Maybe(..))


-- BOUNDS


{-| `0`.
-}
minValue : UInt32
minValue =
    0


{-| `4294967295`.
-}
maxValue : UInt32
maxValue =
    4294967295



-- FROM AN INT


{-| Widen an `Int`, **saturating** at `0`.

    UInt32.fromInt 42 == UInt32.fromInt 42

    UInt32.fromInt -1 == UInt32.minValue

-}
fromInt : Int -> UInt32
fromInt n =
    if n < 0 then
        0

    else
        fromIntWrap n


{-| Reinterpret an `Int`'s 32 bits as unsigned.

    UInt32.fromIntWrap -1 == UInt32.maxValue

-}
@prim("i32_as_u32")
fromIntWrap : Int -> UInt32


{-| Widen an `Int`, or `Nothing` when it is negative.

    UInt32.fromIntChecked 42 == Just (UInt32.fromInt 42)

    UInt32.fromIntChecked -1 == Nothing

-}
fromIntChecked : Int -> Maybe UInt32
fromIntChecked n =
    if n < 0 then
        Nothing

    else
        Just (fromIntWrap n)



-- TO AN INT


{-| Narrow to an `Int`, **saturating** at `2147483647`.

    UInt32.toInt (UInt32.fromInt 42) == 42

    UInt32.toInt UInt32.maxValue == 2147483647

-}
toInt : UInt32 -> Int
toInt n =
    if n > maxIntAsUInt32 then
        2147483647

    else
        toIntWrap n


{-| Reinterpret a `UInt32`'s 32 bits as signed.

    UInt32.toIntWrap UInt32.maxValue == -1

-}
@prim("u32_as_i32")
toIntWrap : UInt32 -> Int


{-| Narrow to an `Int`, or `Nothing` when it does not fit.

    UInt32.toIntChecked (UInt32.fromInt 42) == Just 42

    UInt32.toIntChecked UInt32.maxValue == Nothing

-}
toIntChecked : UInt32 -> Maybe Int
toIntChecked n =
    if n > maxIntAsUInt32 then
        Nothing

    else
        Just (toIntWrap n)


maxIntAsUInt32 : UInt32
maxIntAsUInt32 =
    2147483647


-- FROM ANOTHER WIDTH


{-| Narrow an `Int64`, **saturating** at both of this type's bounds. An `Int64`
below `0` becomes [minValue](#minValue) and one above `4294967295` becomes
[maxValue](#maxValue).

    UInt32.fromInt64 (Int64.fromInt 42) == UInt32.fromInt 42

    UInt32.fromInt64 Int64.minValue == UInt32.minValue

    UInt32.fromInt64 Int64.maxValue == UInt32.maxValue

-}
fromInt64 : Int64 -> UInt32
fromInt64 n =
    if n < zeroAsInt64 then
        minValue

    else if n > maxValueAsInt64 then
        maxValue

    else
        fromInt64Wrap n


{-| Narrow an `Int64` by keeping its **low 32 bits**.

Composed rather than primitive, and the composition is the whole of what it
means: drop to 32 bits, then read those bits as unsigned.

    UInt32.fromInt64Wrap (Int64.fromInt -1) == UInt32.maxValue

-}
fromInt64Wrap : Int64 -> UInt32
fromInt64Wrap n =
    fromIntWrap (Int64.toIntWrap n)


{-| Narrow an `Int64`, or `Nothing` when it does not fit.

    UInt32.fromInt64Checked Int64.maxValue == Nothing

-}
fromInt64Checked : Int64 -> Maybe UInt32
fromInt64Checked n =
    if n < zeroAsInt64 then
        Nothing

    else if n > maxValueAsInt64 then
        Nothing

    else
        Just (fromInt64Wrap n)


{-| Narrow a `UInt64`, **saturating** at [maxValue](#maxValue). Both types are
unsigned, so there is no lower bound to saturate at.

    UInt32.fromUInt64 UInt64.maxValue == UInt32.maxValue

-}
fromUInt64 : UInt64 -> UInt32
fromUInt64 n =
    if n > maxValueAsUInt64 then
        maxValue

    else
        fromUInt64Wrap n


{-| Narrow a `UInt64` by keeping its **low 32 bits**.

    UInt32.fromUInt64Wrap UInt64.maxValue == UInt32.maxValue

-}
@prim("u64_to_u32")
fromUInt64Wrap : UInt64 -> UInt32


{-| Narrow a `UInt64`, or `Nothing` when it is above [maxValue](#maxValue).
-}
fromUInt64Checked : UInt64 -> Maybe UInt32
fromUInt64Checked n =
    if n > maxValueAsUInt64 then
        Nothing

    else
        Just (fromUInt64Wrap n)


-- This width's bounds, at the two widths they are compared against. Digits
-- rather than conversions, for D149's reason.


zeroAsInt64 : Int64
zeroAsInt64 =
    0


maxValueAsInt64 : Int64
maxValueAsInt64 =
    4294967295


maxValueAsUInt64 : UInt64
maxValueAsUInt64 =
    4294967295



-- TO A FLOAT


{-| Convert to a `Float`. Exact: 32 bits of magnitude fit in a `Float`'s 53
with room to spare.

    UInt32.toFloat UInt32.maxValue == 4294967295.0

-}
toFloat : UInt32 -> Float
toFloat n =
    Int64.toFloat (Int64.fromUInt32 n)


-- The path through `Int64` is not an accident of this module: `Core.Prim` has
-- no `u32_to_f64`, and 32 bits of magnitude reach a `Float` exactly by any
-- path, so the one through the widest integer is the path every backend
-- already has.


-- FROM A FLOAT


{-| Round to the nearest `UInt32`, **saturating** at this type's bounds. A tie
goes towards positive infinity.

    UInt32.round 1.5 == UInt32.fromInt 2

    UInt32.round -1.5 == UInt32.minValue

    UInt32.round 1.0e30 == UInt32.maxValue

-}
round : Float -> UInt32
round x =
    fromInt64 (Int64.round x)


{-| Round down to a `UInt32`, **saturating** at this type's bounds.

    UInt32.floor 1.5 == UInt32.fromInt 1

-}
floor : Float -> UInt32
floor x =
    fromInt64 (Int64.floor x)


{-| Round up to a `UInt32`, **saturating** at this type's bounds.

    UInt32.ceiling 1.5 == UInt32.fromInt 2

-}
ceiling : Float -> UInt32
ceiling x =
    fromInt64 (Int64.ceiling x)


{-| Round towards zero to a `UInt32`, **saturating** at this type's bounds.

    UInt32.truncate -0.5 == UInt32.minValue

-}
truncate : Float -> UInt32
truncate x =
    fromInt64 (Int64.truncate x)


-- These four are a composition rather than four more copies of the rounding and
-- the saturation, and the composition is exact: every `UInt32` is an `Int64`,
-- so `Int64`'s answer saturates at bounds that are outside this type's, and
-- narrowing it saturates again at the ones that are not. A `NaN` is `0` at both
-- steps and a negative value is `0` at the second.
--
-- It is the same path `toFloat` above takes and for the same reason: the way
-- between a `UInt32` and a `Float` that every backend already has runs through
-- the widest integer. What it costs on JavaScript is a `BigInt` round trip,
-- which is what `Math`'s four go out of their way to avoid -- and the
-- difference between the two modules is traffic. `round` at `Int` is in every
-- program; `round` at `UInt32` converts a measurement into a bit pattern.
