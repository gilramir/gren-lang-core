{-| Functions for working with sequences of bytes.

## Costs

A `Bytes` is a `DataView` over a range of an `ArrayBuffer` on JavaScript, a
length and a pointer into a block natively, the same struct as a `String`,
which is UTF-8 there, and a binary on the BEAM, where a `String` is UTF-8 too.
A slice is a view on every target and keeps all of what it was cut from alive.
Reading a byte is O(1) everywhere, and two `Bytes` compare in O(n), byte by
byte. Each cost is per call, n being the length in bytes.

@docs Bytes, empty, isEmpty, length

## Endianness
@docs Endianness, getHostEndianness

## Strings
@docs fromString, toString, toStringLossy, toHexString

## Combine
@docs flatten

## Reading
@docs get, getAt, slice

-}


import Array exposing (Array)
import Array.Builder
import Basics exposing (..)
import Bitwise
import Inspect exposing (Inspect)
import Maybe exposing (Maybe(..))
import String exposing (String)
import Task exposing (Task)
import Bytes.Transient exposing (Transient)


-- BYTES


{-| A sequence of bytes.

A byte is a chunk of eight bits. For example, the letter `j` is usually
represented as the byte `01101010`, and the letter `k` is `01101011`.

Seeing each byte as a stream of zeros and ones can be quite confusing though,
so it is common to use hexidecimal numbers instead:

```
| Binary | Hex |
+--------+-----+
|  0000  |  0  |
|  0001  |  1  |
|  0010  |  2  |
|  0011  |  3  |     j = 01101010
|  0100  |  4  |         \__/\__/
|  0101  |  5  |           |   |
|  0110  |  6  |           6   A
|  0111  |  7  |
|  1000  |  8  |     k = 01101011
|  1001  |  9  |         \__/\__/
|  1010  |  A  |           |   |
|  1011  |  B  |           6   B
|  1100  |  C  |
|  1101  |  D  |
|  1110  |  E  |
|  1111  |  F  |
```

So `j` is `6A` and `k` is `6B` in hexidecimal. This more compact representation
is great when you have a sequence of bytes. You can see this even in a short
string like `"jazz"`:

```
binary                                 hexidecimal
01101010 01100001 01111010 01111010 => 6A 61 7A 7A
```

Anyway, the point is that `Bytes` is a sequence of bytes!
-}
type Bytes = Bytes


-- Two `Bytes` are equal when they hold the same bytes. A `Bytes` is a view, so
-- a slice out of `Bytes.Decode.bytes` and a fresh copy of the same bytes are
-- different objects with the same contents, and they compare equal. Without
-- this instance no record holding a `Bytes` had `Eq` at all, which is every
-- message `geng protobuf` generates (`m1b-protobuf.md` §Q13).


instance Eq Bytes where
    eq =
        primEq


-- `representation.md` R5: `Bytes [106, 97, 122, 122]`, the bytes in order as
-- `Int`s, which is `Set`'s shape. Decimal rather than hex because `inspect` on
-- an `Array Int` is decimal, and one rendering of a byte is less to remember.


instance Inspect Bytes where
    inspect bytes =
        Inspect.ctor "Bytes" [ inspect (toArray bytes) ]

    inspectAnnotation _ =
        Inspect.none


{-| The byte at an index, or `Nothing` outside the bytes, a negative index
included.

    get 0 (fromString "abc") == Just 97
    get 3 (fromString "abc") == Nothing
    get -1 (fromString "abc") == Nothing

Unlike [`Array.get`](Array#get), a negative index does not count from the end:
that rule takes `get` past what the native inliner opens, and a byte read in a
loop then allocates a `Just` a byte (geng-lang `m3-bytes-access.md` D543).
[`slice`](#slice) keeps it.

It costs O(1).

-}
get : Int -> Bytes -> Maybe UInt8
get index bytes =
  if index >= 0 && index < primLength bytes then
    Just (primGetU8 bytes index)

  else
    Nothing


{-| The byte at an index that is inside the bytes.

    getAt 0 (fromString "abc") == 97

The index is refined: a program is built only when every call is shown to give
an index from 0 up to the length of the bytes, and one where that cannot be
shown is refused, with the reason. Use it where a test the program makes
anyway keeps the index in range, as `i < Bytes.length bytes` does in a loop
that counts up from 0; elsewhere [`get`](#get) answers `Nothing`.

It costs O(1), with no test of the index.

-}
getAt : (index : Int where 0 <= index && index < Bytes.length bytes) -> (bytes : Bytes) -> UInt8
getAt index bytes =
  primGetU8 bytes index


{-| The bytes from `start` up to, but not including, `end`, by
[`Array.slice`](Array#slice)'s rule: a negative index counts from the end,
each is clamped to the bytes, and an impossible slice is empty. A slice shares
its bytes with what it was cut from, so it copies nothing.

    slice 1 3 (fromString "abcd") == fromString "bc"
    slice 0 -1 (fromString "abcd") == fromString "abc"

It costs O(1), a view that keeps all of the bytes it was cut from alive.

-}
slice : Int -> Int -> Bytes -> Bytes
slice from to bytes =
  let
    count =
      primLength bytes

    start =
      sliceBound from count

    end =
      sliceBound to count
  in
  if start < end then
    primSlice bytes start end

  else
    empty


sliceBound : Int -> (count : Int where 0 <= count) -> (r : Int where 0 <= r && r <= count)
sliceBound index count =
  if index < 0 then
    max 0 (count + index)

  else
    min count index


toArray : Bytes -> Array Int
toArray bytes =
    toArrayFrom bytes (primLength bytes) 0 (Array.Builder.empty (primLength bytes))


{-| A loop of its own rather than `Array.initialize`, whose callback's index
nothing refines, since `initialize`'s offset can wrap it (geng-lang
`m4-refine.md` §RF27).
-}
toArrayFrom : Bytes -> Int -> Int -> Array.Builder.Builder Int -> Array Int
toArrayFrom bytes count index builder =
    if index < count then
        toArrayFrom bytes count (index + 1) (Array.Builder.pushLast (byteAt bytes index) builder)

    else
        Array.Builder.toArray builder


{-| The sequence with exactly 0 bytes.

It costs O(1).

-}
empty : Bytes
empty =
  primToBytes (Bytes.Transient.new 0)


{-| Check if the given byte sequence has 0 bytes in it.

It costs O(1).

-}
isEmpty : Bytes -> Bool
isEmpty bytes =
  length bytes == 0


{-| Get the length of a sequence of bytes.

So if a sequence has four-hundred bytes, then `length bytes` would give back
`400`. That may be 400 unsigned 8-bit integers, 100 signed 32-bit integers, or
even a UTF-8 string. The content does not matter. This is just figuring out
how many bytes there are!

It costs O(1).

-}
length : Bytes -> Int
length =
  primLength



-- ENDIANNESS


{-| Different computers store integers and floats slightly differently in
memory. Say we have the integer `0x1A2B3C4D` in our program. It needs four
bytes (32 bits) in memory. It may seem reasonable to lay them out in order:

```
   Big-Endian (BE)      (Obvious Order)
+----+----+----+----+
| 1A | 2B | 3C | 4D |
+----+----+----+----+
```

But some people thought it would be better to store the bytes in the opposite
order:

```
  Little-Endian (LE)    (Shuffled Order)
+----+----+----+----+
| 4D | 3C | 2B | 1A |
+----+----+----+----+
```

Notice that **the _bytes_ are shuffled, not the bits.** It is like if you cut a
photo into four strips and shuffled the strips. It is not a mirror image.
The theory seems to be that an 8-bit `0x1A` and a 32-bit `0x0000001A` both have
`1A` as the first byte in this scheme. Maybe this was helpful when processors
handled one byte at a time.

**Most processors use little-endian (LE) layout.** This seems to be because
Intel did it this way, and other chip manufactures followed their convention.
**Most network protocols use big-endian (BE) layout.** I suspect this is
because if you are trying to debug a network protocol, it is nice if your
integers are not all shuffled.

**Note:** Endianness is relevant for integers and floats, but not strings.
UTF-8 specifies the order of bytes explicitly.

**Note:** The terms little-endian and big-endian are a reference to an egg joke
in Gulliver's Travels. They first appeared in 1980 in [this essay][essay], and
you can decide for yourself if they stood the test of time. I personally find
these terms quite unhelpful, so I say “Obvious Order” and “Shuffled Order” in
my head. I remember which is more common by asking myself, “if things were
obvious, would I have to ask this question?”

[essay]: http://www.ietf.org/rfc/ien/ien137.txt
-}
type Endianness = LE | BE


{-| Is this program running on a big-endian or little-endian machine?

It costs O(1).

-}
getHostEndianness : Task x Endianness
getHostEndianness =
  hostEndianness LE BE


-- D234: the one name here that asks the host something, so an extern with no
-- Geng body. A constructor does not cross (D192), so the two answers go in.


@extern(js, "Bytes", "hostEndianness")
@extern(erlang, "geng_core_bytes", "hostEndianness")
@extern(c, "geng_core_bytes_hostEndianness")
hostEndianness : endianness -> endianness -> Task x endianness


-- STRINGS


{-| Convert a `String` to a `Bytes`. The resulting bytes will be in the
UTF-8 encoding.

Some characters take one byte, while others can take up to four. Read more
about [UTF-8](https://en.wikipedia.org/wiki/UTF-8) to learn the details!

It costs O(n) on JavaScript, where it encodes the string as UTF-8, and O(1)
natively and on the BEAM, where a string is UTF-8 bytes already, but for a
string grown at the front on the BEAM, which it joins first, O(n).

-}
fromString : String -> Bytes
fromString =
  primToUtf8


{-| Convert UTF-8 encoded `Bytes` to `String`. If the byte sequence isn't
valid UTF-8, `Nothing` will be returned.

It costs O(n), checking that the bytes are UTF-8, and on JavaScript decoding
them as well.

-}
toString : Bytes -> Maybe String
toString bytes =
  if primUtf8Valid bytes then
    Maybe.Just (primFromUtf8 bytes)

  else
    Maybe.Nothing


{-| Convert `Bytes` to `String`, with U+FFFD in place of what is not UTF-8:
one for each maximal subpart, Unicode's recommended practice (§3.9, "U+FFFD
Substitution of Maximal Subparts"), and what WHATWG's decoder, and so
JavaScript's `TextDecoder`, does. A lead byte and the continuation bytes that
could still have been one character are one U+FFFD, so the bytes `E2 82`, the
start of `€`, are one, and `ED A0 80`, which would be a surrogate, are three.

This is for showing bytes that ought to be text, such as a file name or a
program's argument, which the operating system does not promise is UTF-8. Two
different `Bytes` can give the same `String`, so keep the bytes when they are
to be handed back.

    toStringLossy (fromString "café") == "café"

It costs O(n).

-}
toStringLossy : Bytes -> String
toStringLossy bytes =
  if primUtf8Valid bytes then
    primFromUtf8 bytes

  else
    primFromUtf8 (flatten (lossyFrom bytes (primLength bytes) 0 0 (Array.Builder.empty 8)))


{-| Convert any `Bytes` to a hex-encoded `String`, two lower-case digits a
byte. Setting `padding` to `True` puts a space between every byte, which is
easier for humans to read.

    toHexString { padding = False } (fromString "Hi") == "4869"

    toHexString { padding = True } (fromString "Hi") == "48 69"

It costs O(n).

-}
toHexString : { padding : Bool } -> Bytes -> String
toHexString { padding } bytes =
  let
    count =
      primLength bytes

    width =
      if padding then
        3

      else
        2

    size =
      if count == 0 then
        0

      else
        count * width - (width - 2)
  in
  primFromUtf8 (primToBytes (hexFrom bytes count width 0 (Bytes.Transient.new size)))


{-| Writes byte `index` and every one after it at `index * width`, a space
after each but the last when `width` is 3. Hex digits and the space are ASCII,
so the bytes written are UTF-8.
-}
hexFrom : Bytes -> Int -> Int -> Int -> Transient -> Transient
hexFrom bytes count width index transient =
  if index == count then
    transient

  else
    let
      byte =
        byteAt bytes index

      offset =
        index * width

      digits =
        Bytes.Transient.setU8 (Bytes.Transient.setU8 transient offset (hexDigit (Bitwise.shiftRightZfBy 4 byte))) (offset + 1) (hexDigit (Bitwise.and 15 byte))

      spaced =
        if width == 3 && index + 1 < count then
          Bytes.Transient.setU8 digits (offset + 2) 32

        else
          digits
    in
    hexFrom bytes count width (index + 1) spaced


hexDigit : Int -> Int
hexDigit digit =
  if digit < 10 then
    48 + digit

  else
    87 + digit


{-| The pieces of the repaired bytes: each run that is UTF-8 as a slice, and
U+FFFD's three bytes for each maximal subpart between two (geng-lang
`m3-os.md` D547). `start` is where the current run began.
-}
lossyFrom : (bytes : Bytes) -> (count : Int where count == Bytes.length bytes) -> (start : Int where 0 <= start && start <= index) -> (index : Int where index <= count) -> Array.Builder.Builder Bytes -> Array Bytes
lossyFrom bytes count start index found =
  if index >= count then
    Array.Builder.toArray (Array.Builder.pushLast (primSlice bytes start count) found)

  else
    let
      lead =
        byteAt bytes index
    in
    if lead < 0x80 then
      lossyFrom bytes count start (index + 1) found

    else
      let
        needed =
          sequenceLength lead
      in
      if needed == 0 then
        replaced bytes count start index 1 found

      else
        let
          taken =
            continuations bytes count index needed 1 (secondLow lead) (secondHigh lead)
        in
        if taken == needed then
          lossyFrom bytes count start (index + needed) found

        else
          replaced bytes count start index taken found


{-| The run from `start` to `index` kept, and the `taken` bytes at `index`, a
maximal subpart, replaced by one U+FFFD.
-}
replaced : (bytes : Bytes) -> (count : Int where count == Bytes.length bytes) -> (start : Int where 0 <= start && start <= index) -> (index : Int where index <= count) -> (taken : Int where 0 <= taken && index + taken <= count) -> Array.Builder.Builder Bytes -> Array Bytes
replaced bytes count start index taken found =
  lossyFrom bytes count (index + taken) (index + taken)
    (found
      |> Array.Builder.pushLast (primSlice bytes start index)
      |> Array.Builder.pushLast replacementBytes
    )


{-| How many of the `needed` bytes of the character at `start` are there and
in range, counting the lead: the second byte's range is the lead's (Unicode's
Table 3-7), and every later one is `80` to `BF`.
-}
continuations : (bytes : Bytes) -> (count : Int where count == Bytes.length bytes) -> (start : Int where 0 <= start && start < count) -> Int -> (taken : Int where 1 <= taken && start + taken <= count) -> Int -> Int -> (r : Int where 1 <= r && start + r <= count)
continuations bytes count start needed taken low high =
  if taken == needed || start + taken >= count then
    taken

  else
    let
      byte =
        byteAt bytes (start + taken)
    in
    if byte >= low && byte <= high then
      continuations bytes count start needed (taken + 1) 0x80 0xBF

    else
      taken


{-| How many bytes a character with this lead takes, and 0 for a byte that
cannot lead one: a continuation byte, `C0`, `C1`, or `F5` and above.
-}
sequenceLength : Int -> Int
sequenceLength lead =
  if lead >= 0xC2 && lead <= 0xDF then
    2

  else if lead >= 0xE0 && lead <= 0xEF then
    3

  else if lead >= 0xF0 && lead <= 0xF4 then
    4

  else
    0


secondLow : Int -> Int
secondLow lead =
  if lead == 0xE0 then
    0xA0

  else if lead == 0xF0 then
    0x90

  else
    0x80


secondHigh : Int -> Int
secondHigh lead =
  if lead == 0xED then
    0x9F

  else if lead == 0xF4 then
    0x8F

  else
    0xBF


replacementBytes : Bytes
replacementBytes =
  primToUtf8 "\u{FFFD}"


byteAt : (bytes : Bytes) -> (index : Int where 0 <= index && index < Bytes.length bytes) -> Int
byteAt bytes index =
  primU8ToI32 (primGetU8 bytes index)


-- COMBINE


{-| Flatten all `Bytes` in an `Array` into a single `Bytes`.

It costs O(n) in the total length, copying every piece, so `flatten [ acc,
piece ]` in a loop is quadratic; to append bytes a piece at a time, collect the
pieces in an array and flatten it once, or build a
[`Bytes.Encode.sequence`](Bytes-Encode#sequence) and encode it once.

-}
flatten : Array Bytes -> Bytes
flatten arrayOfBytes =
  let
    total =
      Array.foldl (\b sum -> sum + length b) 0 arrayOfBytes
  in
  primToBytes (flattenFrom arrayOfBytes (Array.length arrayOfBytes) 0 0 (Bytes.Transient.new total))


{-| Each piece copied in at its offset. A loop rather than a fold, so that the
transient and the offset travel as two arguments and not as a record built
for every piece (geng-lang `m3-bytes-access.md` §BA9).
-}
flattenFrom : Array Bytes -> Int -> Int -> Int -> Transient -> Transient
flattenFrom pieces count index offset transient =
  if index == count then
    transient

  else
    let
      piece =
        primArrGet pieces index
    in
    flattenFrom pieces count (index + 1) (offset + primLength piece) (primSetBytes transient offset piece)


-- PRIMITIVES
--
-- UTF-8, which is `docs/core.md` C13's one place a `String`'s encoding shows,
-- and which D211 builds with the `str_` group (`docs/m1b-str-prim.md` §Z9).
-- `str_from_utf8`'s precondition is `str_utf8_valid`, so `toString` asks
-- first. A leading U+FEFF is a character, not a byte-order mark
-- (`m1b-protobuf.md` §Q14), in both.


@prim("str_to_utf8")
primToUtf8 : String -> Bytes


@prim("str_utf8_valid")
primUtf8Valid : Bytes -> Bool


@prim("str_from_utf8")
primFromUtf8 : Bytes -> String


-- `docs/m1b-bytes-prim.md` D233's group. Equality is content, not identity: a
-- slice out of `Bytes.Decode.bytes` shares its parent's storage and compares
-- equal to a fresh copy.


@prim("bt_set_bytes")
primSetBytes : Transient -> Int -> Bytes -> Transient


@prim("bt_to_bytes")
primToBytes : Transient -> Bytes


@prim("bytes_eq")
primEq : Bytes -> Bytes -> Bool


@prim("bytes_length")
primLength : Bytes -> Int


@prim("bytes_get_u8")
primGetU8 : (b : Bytes) -> (i : Int where 0 <= i && i < Bytes.length b) -> UInt8


@prim("u8_to_i32")
primU8ToI32 : UInt8 -> Int


-- `arr_get`, as `Array.unsafeGet` and `Array.Builder` declare it.
@prim("arr_get")
primArrGet : (arr : Array Bytes) -> (i : Int where 0 <= i && i < Array.length arr) -> Bytes


@prim("bytes_slice")
primSlice : (b : Bytes) -> (from : Int where 0 <= from && from <= to) -> (to : Int where to <= Bytes.length b) -> (r : Bytes where Bytes.length r == to - from)

