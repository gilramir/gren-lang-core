-- k_tan.c


{-| `__kernel_tan(x, y, k)`: `tan` on `[-pi/4, pi/4]` when `k` is 1, and
`-1/tan` when it is -1.
-}
kernelTan : Float -> Float -> Int -> Float
kernelTan x0 y0 iy =
    let
        hx =
            highWord x0

        ix =
            Bitwise.and hx 0x7FFFFFFF
    in
    if ix < 0x3E300000 then
        -- x < 2**-28; fdlibm's `(int) x == 0` is always true here
        if Bitwise.or (Bitwise.or ix (lowWord x0)) (iy + 1) == 0 then
            1.0 / fabs x0

        else if iy == 1 then
            x0

        else
            -- compute -1 / (x+y) carefully
            let
                w =
                    x0 + y0

                z =
                    fromWords (highWord w) 0

                v =
                    y0 - (z - x0)

                a =
                    -1.0 / w

                t =
                    fromWords (highWord a) 0

                s =
                    1.0 + t * z
            in
            t + a * (s + t * v)

    else
        let
            big =
                ix >= 0x3FE59428

            -- |x| >= 0.6744
            { x, y } =
                if big then
                    let
                        xs =
                            if hx < 0 then
                                -x0

                            else
                                x0

                        ys =
                            if hx < 0 then
                                -y0

                            else
                                y0
                    in
                    { x = (pio4 - xs) + (pio4lo - ys), y = 0.0 }

                else
                    { x = x0, y = y0 }

            z =
                x * x

            w =
                z * z

            -- Break x^5*(T[1]+x^2*T[2]+...) into
            -- x^5(T[1]+x^4*T[3]+...+x^20*T[11]) +
            -- x^5(x^2*(T[2]+x^4*T[4]+...+x^22*[T12]))
            r0 =
                tanT1 + w * (tanT3 + w * (tanT5 + w * (tanT7 + w * (tanT9 + w * tanT11))))

            v =
                z * (tanT2 + w * (tanT4 + w * (tanT6 + w * (tanT8 + w * (tanT10 + w * tanT12)))))

            s =
                z * x

            r =
                (y + z * (s * (r0 + v) + y)) + tanT0 * s

            sum =
                x + r
        in
        if big then
            let
                fy =
                    toFloat iy
            in
            toFloat (1 - Bitwise.and (Bitwise.shiftRightBy 30 hx) 2)
                * (fy - 2.0 * (x - (sum * sum / (sum + fy) - r)))

        else if iy == 1 then
            sum

        else
            -- compute -1.0 / (x+r) accurately
            let
                z2 =
                    fromWords (highWord sum) 0

                -- z+v = r+x
                v2 =
                    r - (z2 - x)

                a =
                    -1.0 / sum

                t =
                    fromWords (highWord a) 0

                s2t =
                    1.0 + t * z2
            in
            t + a * (s2t + t * v2)


