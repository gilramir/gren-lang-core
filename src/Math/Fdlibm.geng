-- s_sin.c, s_cos.c and s_tan.c


{-| `sin(x)`. `x` is reduced to `[-pi/4, pi/4]` by `remPio2`, and the
quadrant picks the kernel and the sign. `sin` of an infinity or `NaN` is
`NaN`.
-}
sin : Float -> Float
sin x =
    let
        ix =
            Bitwise.and (highWord x) 0x7FFFFFFF
    in
    if ix <= 0x3FE921FB then
        -- |x| ~< pi/4
        kernelSin x 0.0 0

    else if ix >= 0x7FF00000 then
        -- sin(Inf or NaN) is NaN
        x - x

    else
        let
            r =
                remPio2 x
        in
        when Bitwise.and r.n 3 is
            0 ->
                kernelSin r.y0 r.y1 1

            1 ->
                kernelCos r.y0 r.y1

            2 ->
                -(kernelSin r.y0 r.y1 1)

            _ ->
                -(kernelCos r.y0 r.y1)


{-| `cos(x)`, as [sin](#sin) is, a quadrant over.
-}
cos : Float -> Float
cos x =
    let
        ix =
            Bitwise.and (highWord x) 0x7FFFFFFF
    in
    if ix <= 0x3FE921FB then
        -- |x| ~< pi/4
        kernelCos x 0.0

    else if ix >= 0x7FF00000 then
        -- cos(Inf or NaN) is NaN
        x - x

    else
        let
            r =
                remPio2 x
        in
        when Bitwise.and r.n 3 is
            0 ->
                kernelCos r.y0 r.y1

            1 ->
                -(kernelSin r.y0 r.y1 1)

            2 ->
                -(kernelCos r.y0 r.y1)

            _ ->
                kernelSin r.y0 r.y1 1


{-| `tan(x)`: the reduced argument's tangent, or minus its cotangent in an odd
quadrant.
-}
tan : Float -> Float
tan x =
    let
        ix =
            Bitwise.and (highWord x) 0x7FFFFFFF
    in
    if ix <= 0x3FE921FB then
        -- |x| ~< pi/4
        kernelTan x 0.0 1

    else if ix >= 0x7FF00000 then
        -- tan(Inf or NaN) is NaN
        x - x

    else
        let
            r =
                remPio2 x
        in
        -- 1 -- n even, -1 -- n odd
        kernelTan r.y0 r.y1 (1 - Bitwise.shiftLeftBy 1 (Bitwise.and r.n 1))



-- e_rem_pio2.c


{-| `__ieee754_rem_pio2(x, y)`: `x - n*pi/2` as the pair `y0 + y1`, and `n`.

Three ways, by size: one subtraction of `pi/2` near it, a Cody–Waite
reduction with `pi/2` in three 33-bit pieces up to `2^19*pi/2`, and past that
Payne–Hanek, which is [kernelRemPio2](#kernelRemPio2).
-}
remPio2 : Float -> { n : Int, y0 : Float, y1 : Float }
remPio2 x =
    let
        hx =
            highWord x

        ix =
            Bitwise.and hx 0x7FFFFFFF
    in
    if ix <= 0x3FE921FB then
        -- |x| ~<= pi/4 , no need for reduction
        { n = 0, y0 = x, y1 = 0.0 }

    else if ix < 0x4002D97C then
        -- |x| < 3pi/4, special case with n=+-1
        if hx > 0 then
            let
                z =
                    x - pio2_1
            in
            if ix /= 0x3FF921FB then
                -- 33+53 bit pi is good enough
                let
                    y0 =
                        z - pio2_1t
                in
                { n = 1, y0 = y0, y1 = (z - y0) - pio2_1t }

            else
                -- near pi/2, use 33+33+53 bit pi
                let
                    z2 =
                        z - pio2_2

                    y0 =
                        z2 - pio2_2t
                in
                { n = 1, y0 = y0, y1 = (z2 - y0) - pio2_2t }

        else
            -- negative x
            let
                z =
                    x + pio2_1
            in
            if ix /= 0x3FF921FB then
                -- 33+53 bit pi is good enough
                let
                    y0 =
                        z + pio2_1t
                in
                { n = -1, y0 = y0, y1 = (z - y0) + pio2_1t }

            else
                -- near pi/2, use 33+33+53 bit pi
                let
                    z2 =
                        z + pio2_2

                    y0 =
                        z2 + pio2_2t
                in
                { n = -1, y0 = y0, y1 = (z2 - y0) + pio2_2t }

    else if ix <= 0x413921FB then
        -- |x| ~<= 2^19*(pi/2), medium size
        let
            t =
                fabs x

            n =
                truncateInt (t * invpio2 + 0.5)

            fn =
                toFloat n

            r =
                t - fn * pio2_1

            -- 1st round good to 85 bit
            w =
                fn * pio2_1t

            reduced =
                if n < 32 && ix /= npio2Hw (n - 1) then
                    -- quick check no cancellation
                    { r = r, w = w, y0 = r - w }

                else
                    remPio2Medium ix fn r w
        in
        let
            y1 =
                (reduced.r - reduced.y0) - reduced.w
        in
        if hx < 0 then
            { n = -n, y0 = -reduced.y0, y1 = -y1 }

        else
            { n = n, y0 = reduced.y0, y1 = y1 }

    else if ix >= 0x7FF00000 then
        -- x is inf or NaN
        { n = 0, y0 = x - x, y1 = x - x }

    else
        -- all other (large) arguments
        let
            -- e0 = ilogb(z)-23
            e0 =
                Bitwise.shiftRightBy 20 ix - 1046

            -- set z = scalbn(|x|,ilogb(x)-23)
            z0 =
                fromWords (ix - Bitwise.shiftLeftBy 20 e0) (lowWord x)

            tx0 =
                toFloat (truncateInt z0)

            z1 =
                (z0 - tx0) * two24

            tx1 =
                toFloat (truncateInt z1)

            tx2 =
                (z1 - tx1) * two24

            -- skip zero terms
            tx =
                if tx2 /= 0.0 then
                    [ tx0, tx1, tx2 ]

                else if tx1 /= 0.0 then
                    [ tx0, tx1 ]

                else
                    [ tx0 ]

            r =
                kernelRemPio2 tx e0
        in
        if hx < 0 then
            { n = -r.n, y0 = -r.y0, y1 = -r.y1 }

        else
            r


{-| The medium case's second and third iterations, when the first lost too
many bits to cancellation.
-}
remPio2Medium : Int -> Float -> Float -> Float -> { r : Float, w : Float, y0 : Float }
remPio2Medium ix fn r1 w1 =
    let
        j =
            Bitwise.shiftRightBy 20 ix

        y01 =
            r1 - w1

        exponentOf y =
            Bitwise.and (Bitwise.shiftRightBy 20 (highWord y)) 0x07FF
    in
    if j - exponentOf y01 > 16 then
        -- 2nd iteration needed, good to 118
        let
            w2a =
                fn * pio2_2

            r2 =
                r1 - w2a

            w2 =
                fn * pio2_2t - ((r1 - r2) - w2a)

            y02 =
                r2 - w2
        in
        if j - exponentOf y02 > 49 then
            -- 3rd iteration need, 151 bits acc
            let
                w3a =
                    fn * pio2_3

                r3 =
                    r2 - w3a

                w3 =
                    fn * pio2_3t - ((r2 - r3) - w3a)
            in
            { r = r3, w = w3, y0 = r3 - w3 }

        else
            { r = r2, w = w2, y0 = y02 }

    else
        { r = r1, w = w1, y0 = y01 }


two24 : Float
two24 =
    1.67772160000000000000e7


invpio2 : Float
invpio2 =
    6.36619772367581382433e-1


pio2_1 : Float
pio2_1 =
    1.57079632673412561417e0


