sinS2 =
    8.33333333332248946124e-3


sinS3 : Float
sinS3 =
    -1.98412698298579493134e-4


sinS4 : Float
sinS4 =
    2.75573137070700676789e-6


sinS5 : Float
sinS5 =
    -2.50507602534068634195e-8


sinS6 : Float
sinS6 =
    1.58969099521155010221e-10



-- k_cos.c


{-| `__kernel_cos(x, y)`: `cos` on `[-pi/4, pi/4]`, where `x + y` is the
reduced argument.
-}
kernelCos : Float -> Float -> Float
kernelCos x y =
    let
        ix =
            Bitwise.and (highWord x) 0x7FFFFFFF
    in
    if ix < 0x3E400000 then
        -- if x < 2**27, where fdlibm raises inexact and answers one
        1.0

    else
        let
            z =
                x * x

            r =
                z * (cosC1 + z * (cosC2 + z * (cosC3 + z * (cosC4 + z * (cosC5 + z * cosC6)))))
        in
        if ix < 0x3FD33333 then
            -- if |x| < 0.3
            1.0 - (0.5 * z - (z * r - x * y))

        else
            let
                qx =
                    if ix > 0x3FE90000 then
                        -- x > 0.78125
                        0.28125

                    else
                        -- x/4
                        fromWords (ix - 0x00200000) 0

                hz =
                    0.5 * z - qx

                a =
                    1.0 - qx
            in
            a - (hz - (z * r - x * y))


