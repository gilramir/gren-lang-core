-- k_rem_pio2.c
--
-- The C keeps five arrays and rewrites them in place, with a `goto recompute`
-- when too few chunks of 2/pi were used. Two of the arrays are never really
-- mutable: every write sets `f[i]` to `ipio2[jv-jx+i]`, and the first `q[i]` is
-- the same sum whenever it is computed, so both are functions of `i` here. The
-- `goto` is a call: everything after `recompute:` is a function of `jz`. The
-- rest are `Array`s built in the order the C writes them. Only `prec == 2` is
-- ported, which is the only precision `e_rem_pio2.c` asks for, so `jk` and
-- `jp` are both 4.


{-| `__kernel_rem_pio2(x, y, e0, nx, 2, two_over_pi)`: `n mod 8` and the
double-double `y0 + y1` with `x*2^e0 = n*pi/2 + y0 + y1`, for `x` given as
its 24-bit chunks in `tx`.
-}
kernelRemPio2 : Array Float -> Int -> { n : Int, y0 : Float, y1 : Float }
kernelRemPio2 tx e0 =
    let
        jx =
            Array.length tx - 1

        -- determine jx,jv,q0, note that 3>q0
        jv =
            max 0 ((e0 - 3) // 24)

        q0 =
            e0 - 24 * (jv + 1)

        -- f[i] = ipio2[jv-jx+i], zero below the table
        f i =
            let
                j =
                    jv - jx + i
            in
            if j < 0 then
                0.0

            else
                toFloat (intAt j twoOverPi)

        -- q[i] = sum over j of x[j]*f[jx+i-j], in the C's order
        q i =
            Array.foldl
                (\xj { j, fw } -> { j = j + 1, fw = fw + xj * f (jx + i - j) })
                { j = 0, fw = 0.0 }
                tx
                |> .fw
    in
    remPio2Recompute q q0 kRemJk


kRemJk : Int
kRemJk =
    4


remPio2Recompute : (Int -> Float) -> Int -> Int -> { n : Int, y0 : Float, y1 : Float }
remPio2Recompute q q0 jz =
    let
        -- distill q[] into iq[] reversingly
        distilled =
            distill q jz jz (q jz) []

        z1 =
            scalbn distilled.z q0

        -- trim off integer >= 8
        z2 =
            z1 - 8.0 * floorFloat (z1 * 0.125)

        n0 =
            truncateInt z2

        z3 =
            z2 - toFloat n0

        -- need iq[jz-1] to determine n
        { n1, iq1, ih } =
            let
                last =
                    intAt (jz - 1) distilled.iq
            in
            if q0 > 0 then
                let
                    i =
                        Bitwise.shiftRightBy (24 - q0) last

                    trimmed =
                        last - Bitwise.shiftLeftBy (24 - q0) i
                in
                { n1 = n0 + i
                , iq1 = Array.set (jz - 1) trimmed distilled.iq
                , ih = Bitwise.shiftRightBy (23 - q0) trimmed
                }

            else if q0 == 0 then
                { n1 = n0, iq1 = distilled.iq, ih = Bitwise.shiftRightBy 23 last }

            else if z3 >= 0.5 then
                { n1 = n0, iq1 = distilled.iq, ih = 2 }

            else
                { n1 = n0, iq1 = distilled.iq, ih = 0 }

        -- q > 0.5
        { n, iq, z } =
            if ih > 0 then
                let
                    -- compute 1-q
                    complemented =
                        Array.foldl
                            (\j acc ->
                                if acc.carry == 0 then
                                    if j /= 0 then
                                        { carry = 1, iq = Array.pushLast (0x01000000 - j) acc.iq }

                                    else
                                        { carry = 0, iq = Array.pushLast j acc.iq }

                                else
                                    { carry = acc.carry, iq = Array.pushLast (0x00FFFFFF - j) acc.iq }
                            )
                            { carry = 0, iq = [] }
                            iq1

                    -- rare case: chance is 1 in 12
                    masked =
                        when q0 is
                            1 ->
                                Array.set (jz - 1) (Bitwise.and (intAt (jz - 1) complemented.iq) 0x007FFFFF) complemented.iq

                            2 ->
                                Array.set (jz - 1) (Bitwise.and (intAt (jz - 1) complemented.iq) 0x003FFFFF) complemented.iq

                            _ ->
                                complemented.iq

                    zc =
                        if ih == 2 then
                            if complemented.carry /= 0 then
                                (1.0 - z3) - scalbn 1.0 q0

                            else
                                1.0 - z3

                        else
                            z3
                in
                { n = n1 + 1, iq = masked, z = zc }

            else
                { n = n1, iq = iq1, z = z3 }
    in
    -- check if recomputation is needed
    if z == 0.0 && orFrom (jz - 1) kRemJk iq == 0 then
        -- k = no. of terms needed
        remPio2Recompute q q0 (jz + termsNeeded iq 1)

    else
        remPio2Finish n ih q0 jz iq z


{-| The distilling loop: `iq[i] = (int)(z - two24*fw)` for `j` from `jz` down,
with `z` carried into `q[j-1]`.
-}
distill : (Int -> Float) -> Int -> Int -> Float -> Array Int -> { iq : Array Int, z : Float }
distill q jz j z iq =
    if j > 0 then
        let
            fw =
                toFloat (truncateInt (twon24 * z))
        in
        distill q jz (j - 1) (q (j - 1) + fw) (Array.pushLast (truncateInt (z - two24 * fw)) iq)

    else
        { iq = iq, z = z }


{-| `j |= iq[i]` for `i` from `from` down to `to`.
-}
orFrom : Int -> Int -> Array Int -> Int
orFrom from to iq =
    if from >= to then
        Bitwise.or (intAt from iq) (orFrom (from - 1) to iq)

    else
        0


{-| `for(k=1;iq[jk-k]==0;k++);`
-}
termsNeeded : Array Int -> Int -> Int
termsNeeded iq k =
    if intAt (kRemJk - k) iq == 0 then
        termsNeeded iq (k + 1)

    else
        k


remPio2Finish : Int -> Int -> Int -> Int -> Array Int -> Float -> { n : Int, y0 : Float, y1 : Float }
remPio2Finish n ih q0Start jzStart iqStart z =
    let
        -- chop off zero terms, or break z into 24-bit if necessary
        { jz, q0, iq } =
            if z == 0.0 then
                chopZeros iqStart (jzStart - 1) (q0Start - 24)

            else
                let
                    zs =
                        scalbn z (negate q0Start)
                in
                if zs >= two24 then
                    let
                        fw =
                            toFloat (truncateInt (twon24 * zs))
                    in
                    { jz = jzStart + 1
                    , q0 = q0Start + 24
                    , iq =
                        iqStart
                            |> Array.pushLast (truncateInt (zs - two24 * fw))
                            |> Array.pushLast (truncateInt fw)
                    }

                else
                    { jz = jzStart, q0 = q0Start, iq = Array.pushLast (truncateInt zs) iqStart }

        -- convert integer "bit" chunk to floating-point value:
        -- q[i] = 2^q0 * twon24^(jz-i) * iq[i], built from i = jz down
        qs =
            chunks iq jz (scalbn 1.0 q0) (Array.repeat (jz + 1) 0.0)

        -- compute PIo2[0,...,jp]*q[jz,...,0]: fq[jz-i] for i from jz down
        fq =
            Array.initialize (jz + 1) 0 (\m -> piO2Times qs (jz - m) (min kRemJk m))

        -- compress fq[] into y[]
        fw1 =
            sumDown fq jz 0.0

        fw2 =
            sumUp fq 1 jz (floatAt 0 fq - fw1)
    in
    if ih == 0 then
        { n = Bitwise.and n 7, y0 = fw1, y1 = fw2 }

    else
        { n = Bitwise.and n 7, y0 = -fw1, y1 = -fw2 }


chopZeros : Array Int -> Int -> Int -> { jz : Int, q0 : Int, iq : Array Int }
chopZeros iq jz q0 =
    if intAt jz iq == 0 then
        chopZeros iq (jz - 1) (q0 - 24)

    else
        { jz = jz, q0 = q0, iq = iq }


chunks : Array Int -> Int -> Float -> Array Float -> Array Float
chunks iq i fw qs =
    if i >= 0 then
        chunks iq (i - 1) (fw * twon24) (Array.set i (fw * toFloat (intAt i iq)) qs)

    else
        qs


{-| `for(fw=0.0,k=0;k<=jp&&k<=jz-i;k++) fw += PIo2[k]*q[i+k];`
-}
piO2Times : Array Float -> Int -> Int -> Float
piO2Times qs i kMax =
    piO2TimesFrom qs i kMax 0 0.0


piO2TimesFrom : Array Float -> Int -> Int -> Int -> Float -> Float
piO2TimesFrom qs i kMax k fw =
    if k <= kMax then
        piO2TimesFrom qs i kMax (k + 1) (fw + floatAt k piO2Chunks * floatAt (i + k) qs)

    else
        fw


sumDown : Array Float -> Int -> Float -> Float
sumDown fq i fw =
    if i >= 0 then
        sumDown fq (i - 1) (fw + floatAt i fq)

    else
        fw


sumUp : Array Float -> Int -> Int -> Float -> Float
sumUp fq i jz fw =
    if i <= jz then
        sumUp fq (i + 1) jz (fw + floatAt i fq)

    else
        fw


twon24 : Float
twon24 =
    5.96046447753906250000e-8


{-| `PIo2[]`: pi/2 in 24-bit chunks, each a double.
-}
piO2Chunks : Array Float
piO2Chunks =
    [ 1.57079625129699707031e0
    , 7.54978941586159635335e-8
    , 5.39030252995776476554e-15
    , 3.28200341580791294123e-22
    , 1.27065575308067607349e-29
    , 1.22933308981111328932e-36
    , 2.73370053816464559624e-44
    , 2.16741683877804819444e-51
    ]


intAt : Int -> Array Int -> Int
intAt i array =
    when Array.get i array is
        Just v ->
            v

        Nothing ->
            0


floatAt : Int -> Array Float -> Float
floatAt i array =
    when Array.get i array is
        Just v ->
            v

        Nothing ->
            0.0
