    8.47842766036889956997e-32


{-| `npio2_hw[i]`: the high word of `(i+1)*pi/2`, for the medium case's check
that the first round cannot have cancelled.
-}
npio2Hw : Int -> Int
npio2Hw i =
    intAt i npio2HwTable


npio2HwTable : Array Int
npio2HwTable =
    [ 0x3FF921FB, 0x400921FB, 0x4012D97C, 0x401921FB, 0x401F6A7A, 0x4022D97C
