module Math.Fdlibm exposing (log, log10, atan, atan2, asin, acos)

{-| fdlibm: the transcendental functions, the same bits on every backend.

`docs/arithmetic.md` A9 asks for `sin`, `pow` and the rest to be written once,
in Geng, as a port of fdlibm 5.3 — Sun's freely distributable math library, the
one Java's `StrictMath` is specified to match — because no standard pins their
last bits and the runtimes Geng targets disagree in them. `m2-fdlibm.md` is the
survey and D391–D395 are what it decided. [Math](Math) calls this module, and
nothing else should: `Float`'s `^` is fdlibm's `e_pow.c` too, but it lives in
`Basics`, which cannot import anything (§FD4).

**Not exposed.** `geng.toml` does not list it, because what a program should
call is `Math.logBase` and its neighbours.

@docs log, log10, atan, atan2, asin, acos

-}

import Basics exposing (..)
import Bitwise



-- A DOUBLE'S WORDS
--
-- fdlibm takes a double apart as two 32-bit words, `__HI(x)` and `__LO(x)`,
-- each an `int`, and puts one back with `__HI(x) = hx`. These are that, as
-- D391's three primitives. They are declared here rather than taken from
-- `Math`, which imports this module; `Math.toBits` reads the same bits as one
-- `UInt64`, which is a `BigInt` on JavaScript and doubled the cost of a word
-- there (`m2-fdlibm.md` §FD3).


@prim("f64_high_word")
highWord : Float -> Int


@prim("f64_low_word")
lowWord : Float -> Int


@prim("f64_from_words")
fromWords : Int -> Int -> Float


{-| `__HI(x) = hi`: the double with this high word and `x`'s low one.
-}
withHighWord : Int -> Float -> Float
withHighWord hi x =
    fromWords hi (lowWord x)



-- THE TRANSCRIPTION
--
-- Each function below is one fdlibm file, with its names, its constants and
-- the shape of its branches, so that the two can be read side by side as
-- `String.Ryu` and `d2s.c` can. What changes is only what Geng has to say
-- differently: a C statement that reassigns `x` or `hx` partway through is a
-- new name, or a helper taking the values that far, and a `return` in the
-- middle of a block is a branch. The comments are fdlibm's where they explain
-- the arithmetic.
--
-- What the transcription relies on. `Int` is fdlibm's `int`: 32 bits, two's
-- complement, wrapping. `Bitwise.shiftRightBy` is C's `>>` on an `int`, which
-- is arithmetic on every compiler fdlibm was built with, and
-- `Bitwise.shiftRightZfBy` is `>>` on an `unsigned`. Every constant is written
-- in fdlibm's own decimal, and each reads back as the hex fdlibm gives beside
-- it; `accept/float-fdlibm` holds the results to `StrictMath`'s bits.


two54 : Float
two54 =
    1.8014398509481984e16



-- e_log.c


ln2Hi : Float
ln2Hi =
    6.93147180369123816490e-1


ln2Lo : Float
ln2Lo =
    1.90821492927058770002e-10


{-| `__ieee754_log(x)`: the natural logarithm.

fdlibm's method: reduce `x` to `2^k * (1 + f)` with `sqrt(2)/2 < 1 + f <
sqrt(2)`, then `log(1 + f)` is `f - s*(f - R)` with `s = f / (2 + f)` and `R` a
polynomial in `s*s`, and the answer is `k*ln2 + log(1 + f)`, with `ln2` split
in two so that `k*ln2Hi` is exact.

`log 0` is `-infinity`, `log` of a negative number is `NaN`, and `log` of
`infinity` or `NaN` is itself.

-}
log : Float -> Float
log x =
    let
        hx =
            highWord x
    in
    if hx < 0x00100000 then
        -- x < 2**-1022
        if Bitwise.or (Bitwise.and hx 0x7FFFFFFF) (lowWord x) == 0 then
            -- log(+-0) = -inf
            -two54 / 0.0

        else if hx < 0 then
            -- log(-#) = NaN
            (x - x) / 0.0

        else
            -- subnormal number, scale up x
            let
                scaled =
                    x * two54
            in
            logNormal (highWord scaled) scaled -54

    else
        logNormal hx x 0


logNormal : Int -> Float -> Int -> Float
logNormal hx0 x0 k0 =
    if hx0 >= 0x7FF00000 then
        x0 + x0

    else
        let
            hx =
                Bitwise.and hx0 0x000FFFFF

            i =
                Bitwise.and (hx + 0x00095F64) 0x00100000

            -- normalize x or x/2
            x =
                withHighWord (Bitwise.or hx (Bitwise.xor i 0x3FF00000)) x0

            k =
                k0 + (Bitwise.shiftRightBy 20 hx0 - 1023) + Bitwise.shiftRightBy 20 i

            f =
                x - 1.0

            dk =
                toFloat k
        in
        if Bitwise.and 0x000FFFFF (2 + hx) < 3 then
            -- |f| < 2**-20
            if f == 0.0 then
                if k == 0 then
                    0.0

                else
                    dk * ln2Hi + dk * ln2Lo

            else
                let
                    r =
                        f * f * (0.5 - 0.33333333333333333 * f)
                in
                if k == 0 then
                    f - r

                else
                    dk * ln2Hi - ((r - dk * ln2Lo) - f)

        else
            let
                s =
                    f / (2.0 + f)

                z =
                    s * s

                w =
                    z * z

                t1 =
                    w * (lg2 + w * (lg4 + w * lg6))

                t2 =
                    z * (lg1 + w * (lg3 + w * (lg5 + w * lg7)))

                r =
                    t2 + t1

                ij =
                    Bitwise.or (hx - 0x0006147A) (0x0006B851 - hx)
            in
            if ij > 0 then
                let
                    hfsq =
                        0.5 * f * f
                in
                if k == 0 then
                    f - (hfsq - s * (hfsq + r))

                else
                    dk * ln2Hi - ((hfsq - (s * (hfsq + r) + dk * ln2Lo)) - f)

            else if k == 0 then
                f - s * (f - r)

            else
                dk * ln2Hi - ((s * (f - r) - dk * ln2Lo) - f)


lg1 : Float
lg1 =
    6.666666666666735130e-1


lg2 : Float
lg2 =
    3.999999999940941908e-1


lg3 : Float
lg3 =
    2.857142874366239149e-1


lg4 : Float
lg4 =
    2.222219843214978396e-1


lg5 : Float
lg5 =
    1.818357216161805012e-1


lg6 : Float
lg6 =
    1.531383769920937332e-1


lg7 : Float
lg7 =
    1.479819860511658591e-1



-- e_log10.c


ivln10 : Float
ivln10 =
    4.34294481903251816668e-1


log10Of2Hi : Float
log10Of2Hi =
    3.01029995663611771306e-1


log10Of2Lo : Float
log10Of2Lo =
    3.69423907715893078616e-13


{-| `__ieee754_log10(x)`: the base-ten logarithm.

fdlibm's method: with `x = 2^n * y` and `y` in `[1, 2)`, the answer is
`n*log10(2) + log10(y)`, and `log10(y)` is `ivln10 * log(y)`. When `n` is
negative, `y` is taken from `[0.5, 1)` instead and `n` raised by one, so that
`n*log10(2)` and `log10(y)` do not both carry a large error of opposite sign.
Exact at every power of ten from `1e-311` to `1e308`. Below that the double
nearest a power of ten is a subnormal some way from it, and none of the twelve
below `1e-311` answers an integer.

The special cases are [log](#log)'s.

-}
log10 : Float -> Float
log10 x =
    let
        hx =
            highWord x
    in
    if hx < 0x00100000 then
        -- x < 2**-1022
        if Bitwise.or (Bitwise.and hx 0x7FFFFFFF) (lowWord x) == 0 then
            -- log(+-0) = -inf
            -two54 / 0.0

        else if hx < 0 then
            -- log(-#) = NaN
            (x - x) / 0.0

        else
            -- subnormal number, scale up x
            let
                scaled =
                    x * two54
            in
            log10Normal (highWord scaled) scaled -54

    else
        log10Normal hx x 0


log10Normal : Int -> Float -> Int -> Float
log10Normal hx x k0 =
    if hx >= 0x7FF00000 then
        x + x

    else
        let
            k =
                k0 + (Bitwise.shiftRightBy 20 hx - 1023)

            -- the sign bit of k: 1 when it is negative
            i =
                Bitwise.shiftRightZfBy 31 k

            y =
                toFloat (k + i)

            z =
                y * log10Of2Lo + ivln10 * log (withHighWord (Bitwise.or (Bitwise.and hx 0x000FFFFF) (Bitwise.shiftLeftBy 20 (0x03FF - i))) x)
        in
        z + y * log10Of2Hi



-- s_fabs.c
--
-- fdlibm's own `fabs`, which clears the sign bit of the high word. It is here
-- rather than `f64_abs` because `core` declares that primitive nowhere a
-- program can reach (`accept/prim-coverage`'s list), and fdlibm's is the same
-- operation on every value, NaN included.


fabs : Float -> Float
fabs x =
    withHighWord (Bitwise.and (highWord x) 0x7FFFFFFF) x


@prim("f64_sqrt")
sqrt : Float -> Float



-- s_atan.c


atanHi : Int -> Float
atanHi id =
    when id is
        0 ->
            -- atan(0.5)hi
            4.63647609000806093515e-1

        1 ->
            -- atan(1.0)hi
            7.85398163397448278999e-1

        2 ->
            -- atan(1.5)hi
            9.82793723247329054082e-1

        _ ->
            -- atan(inf)hi
            1.57079632679489655800e0


atanLo : Int -> Float
atanLo id =
    when id is
        0 ->
            2.26987774529616870924e-17

        1 ->
            3.06161699786838301793e-17

        2 ->
            1.39033110312309984516e-17

        _ ->
            6.12323399573676603587e-17


{-| `atan(x)`: the arctangent, in `[-pi/2, pi/2]`.

fdlibm's method: reduce `x` to `[0, 7/16]` by `atan(x) = atan(c) + atan(t)`
with `t = (x - c) / (1 + x*c)` for `c` one of `0.5`, `1`, `1.5` and infinity,
chosen by the range `|x|` is in, then an odd polynomial of degree 23 in `t`.

`atan` of `NaN` is `NaN`, and of either infinity is `pi/2` with its sign.

-}
atan : Float -> Float
atan x =
    let
        hx =
            highWord x

        ix =
            Bitwise.and hx 0x7FFFFFFF
    in
    if ix >= 0x44100000 then
        -- if |x| >= 2^66
        if ix > 0x7FF00000 || (ix == 0x7FF00000 && lowWord x /= 0) then
            -- NaN
            x + x

        else if hx > 0 then
            atanHi 3 + atanLo 3

        else
            negate (atanHi 3) - atanLo 3

    else if ix < 0x3FDC0000 then
        -- |x| < 0.4375
        if ix < 0x3E200000 then
            -- |x| < 2^-29, where fdlibm raises inexact and answers x
            x

        else
            atanReduced hx -1 x

    else
        let
            ax =
                fabs x
        in
        if ix < 0x3FF30000 then
            -- |x| < 1.1875
            if ix < 0x3FE60000 then
                -- 7/16 <= |x| < 11/16
                atanReduced hx 0 ((2.0 * ax - 1.0) / (2.0 + ax))

            else
                -- 11/16 <= |x| < 19/16
                atanReduced hx 1 ((ax - 1.0) / (ax + 1.0))

        else if ix < 0x40038000 then
            -- |x| < 2.4375
            atanReduced hx 2 ((ax - 1.5) / (1.0 + 1.5 * ax))

        else
            -- 2.4375 <= |x| < 2^66
            atanReduced hx 3 (-1.0 / ax)


atanReduced : Int -> Int -> Float -> Float
atanReduced hx id x =
    let
        z =
            x * x

        w =
            z * z

        -- break sum from i=0 to 10 aT[i]z**(i+1) into odd and even poly
        s1 =
            z * (aT0 + w * (aT2 + w * (aT4 + w * (aT6 + w * (aT8 + w * aT10)))))

        s2 =
            w * (aT1 + w * (aT3 + w * (aT5 + w * (aT7 + w * aT9))))
    in
    if id < 0 then
        x - x * (s1 + s2)

    else
        let
            r =
                atanHi id - ((x * (s1 + s2) - atanLo id) - x)
        in
        if hx < 0 then
            -r

        else
            r


aT0 : Float
aT0 =
    3.33333333333329318027e-1


aT1 : Float
aT1 =
    -1.99999999998764832476e-1


aT2 : Float
aT2 =
    1.42857142725034663711e-1


aT3 : Float
aT3 =
    -1.11111104054623557880e-1


aT4 : Float
aT4 =
    9.09088713343650656196e-2


aT5 : Float
aT5 =
    -7.69187620504482999495e-2


aT6 : Float
aT6 =
    6.66107313738753120669e-2


aT7 : Float
aT7 =
    -5.83357013379057348645e-2


aT8 : Float
aT8 =
    4.97687799461593236017e-2


aT9 : Float
aT9 =
    -3.65315727442169155270e-2


aT10 : Float
aT10 =
    1.62858201153657823623e-2



-- e_atan2.c


tiny : Float
tiny =
    1.0e-300


piO4 : Float
piO4 =
    7.8539816339744827900e-1


piO2 : Float
piO2 =
    1.5707963267948965580e0


pi : Float
pi =
    3.1415926535897931160e0


piLo : Float
piLo =
    1.2246467991473531772e-16


{-| 1 when a low word is not zero: `(lx|-lx)>>31` on an `unsigned`. A top-level
`Int -> Int` rather than a local function, which would generalize over `Num`
and `Bits` and be called with their dictionaries.
-}
nonZero : Int -> Int
nonZero low =
    Bitwise.shiftRightZfBy 31 (Bitwise.or low (negate low))


{-| `__ieee754_atan2(y, x)`: the angle of the point `(x, y)`, in `[-pi, pi]`.

fdlibm's method: `atan(|y/x|)`, with the quadrant from the two signs and
`pi` split in two so that `pi - atan(...)` loses nothing. The zeros, the
infinities and a ratio past `2^60` either way are answered before the
division.

-}
atan2 : Float -> Float -> Float
atan2 y x =
    let
        hx =
            highWord x

        ix =
            Bitwise.and hx 0x7FFFFFFF

        lx =
            lowWord x

        hy =
            highWord y

        iy =
            Bitwise.and hy 0x7FFFFFFF

        ly =
            lowWord y

        -- 2*sign(x)+sign(y)
        m =
            Bitwise.or
                (Bitwise.and (Bitwise.shiftRightBy 31 hy) 1)
                (Bitwise.and (Bitwise.shiftRightBy 30 hx) 2)
    in
    if Bitwise.or ix (nonZero lx) > 0x7FF00000 || Bitwise.or iy (nonZero ly) > 0x7FF00000 then
        -- x or y is NaN
        x + y

    else if Bitwise.or (hx - 0x3FF00000) lx == 0 then
        -- x=1.0
        atan y

    else if Bitwise.or iy ly == 0 then
        -- when y = 0
        when m is
            2 ->
                -- atan(+0,-anything) = pi
                pi + tiny

            3 ->
                -- atan(-0,-anything) =-pi
                -pi - tiny

            _ ->
                -- atan(+-0,+anything)=+-0
                y

    else if Bitwise.or ix lx == 0 then
        -- when x = 0
        if hy < 0 then
            -piO2 - tiny

        else
            piO2 + tiny

    else if ix == 0x7FF00000 then
        -- when x is INF
        if iy == 0x7FF00000 then
            when m is
                0 ->
                    -- atan(+INF,+INF)
                    piO4 + tiny

                1 ->
                    -- atan(-INF,+INF)
                    -piO4 - tiny

                2 ->
                    -- atan(+INF,-INF)
                    3.0 * piO4 + tiny

                _ ->
                    -- atan(-INF,-INF)
                    -3.0 * piO4 - tiny

        else
            when m is
                0 ->
                    -- atan(+...,+INF)
                    0.0

                1 ->
                    -- atan(-...,+INF)
                    -0.0

                2 ->
                    -- atan(+...,-INF)
                    pi + tiny

                _ ->
                    -- atan(-...,-INF)
                    -pi - tiny

    else if iy == 0x7FF00000 then
        -- when y is INF
        if hy < 0 then
            -piO2 - tiny

        else
            piO2 + tiny

    else
        -- compute y/x
        let
            k =
                Bitwise.shiftRightBy 20 (iy - ix)

            z =
                if k > 60 then
                    -- |y/x| > 2**60
                    piO2 + 0.5 * piLo

                else if hx < 0 && k < -60 then
                    -- |y|/x < -2**60
                    0.0

                else
                    -- safe to do y/x
                    atan (fabs (y / x))
        in
        when m is
            0 ->
                -- atan(+,+)
                z

            1 ->
                -- atan(-,+): __HI(z) ^= 0x80000000
                withHighWord (Bitwise.xor (highWord z) -2147483648) z

            2 ->
                -- atan(+,-)
                pi - (z - piLo)

            _ ->
                -- atan(-,-)
                (z - piLo) - pi



-- e_asin.c and e_acos.c, which share their constants


pio2Hi : Float
pio2Hi =
    1.57079632679489655800e0


pio2Lo : Float
pio2Lo =
    6.12323399573676603587e-17


pio4Hi : Float
pio4Hi =
    7.85398163397448278999e-1


{-| The rational approximation both files use: `p` and `q` with `asin(x) =
x + x*p/q` on `|x| < 0.5`, as a pair so that each file can divide where fdlibm
does.
-}
pq : Float -> { p : Float, q : Float }
pq t =
    { p = t * (pS0 + t * (pS1 + t * (pS2 + t * (pS3 + t * (pS4 + t * pS5)))))
    , q = 1.0 + t * (qS1 + t * (qS2 + t * (qS3 + t * qS4)))
    }


pS0 : Float
pS0 =
    1.66666666666666657415e-1


pS1 : Float
pS1 =
    -3.25565818622400915405e-1


pS2 : Float
pS2 =
    2.01212532134862925881e-1


pS3 : Float
pS3 =
    -4.00555345006794114027e-2


pS4 : Float
pS4 =
    7.91534994289814532176e-4


pS5 : Float
pS5 =
    3.47933107596021167570e-5


qS1 : Float
qS1 =
    -2.40339491173441421878e0


qS2 : Float
qS2 =
    2.02094576023350569471e0


qS3 : Float
qS3 =
    -6.88283971605453293030e-1


qS4 : Float
qS4 =
    7.70381505559019352791e-2


{-| `__ieee754_asin(x)`: the arcsine, in `[-pi/2, pi/2]`.

fdlibm's method: a rational approximation on `|x| < 0.5`, and past it
`asin(x) = pi/2 - 2*asin(sqrt((1-x)/2))`, with the square root split in two
near `0.975` so that its low half is not lost.

`asin` of anything outside `[-1, 1]`, and of `NaN`, is `NaN`.

-}
asin : Float -> Float
asin x =
    let
        hx =
            highWord x

        ix =
            Bitwise.and hx 0x7FFFFFFF
    in
    if ix >= 0x3FF00000 then
        -- |x| >= 1
        if Bitwise.or (ix - 0x3FF00000) (lowWord x) == 0 then
            -- asin(1)=+-pi/2 with inexact
            x * pio2Hi + x * pio2Lo

        else
            -- asin(|x|>1) is NaN
            (x - x) / (x - x)

    else if ix < 0x3FE00000 then
        -- |x| < 0.5
        if ix < 0x3E400000 then
            -- |x| < 2**-27, where fdlibm raises inexact and answers x
            x

        else
            let
                r =
                    pq (x * x)
            in
            x + x * (r.p / r.q)

    else
        -- 1 > |x| >= 0.5
        let
            t =
                (1.0 - fabs x) * 0.5

            r =
                pq t

            s =
                sqrt t

            answer =
                if ix >= 0x3FEF3333 then
                    -- if |x| > 0.975
                    pio2Hi - (2.0 * (s + s * (r.p / r.q)) - pio2Lo)

                else
                    let
                        -- __LO(w) = 0
                        w =
                            fromWords (highWord s) 0

                        c =
                            (t - w * w) / (s + w)

                        p =
                            2.0 * s * (r.p / r.q) - (pio2Lo - 2.0 * c)

                        q =
                            pio4Hi - 2.0 * w
                    in
                    pio4Hi - (p - q)
        in
        if hx > 0 then
            answer

        else
            -answer


{-| `__ieee754_acos(x)`: the arccosine, in `[0, pi]`.

fdlibm's method: `acos(x) = pi/2 - asin(x)` on `|x| < 0.5`, and past it
`2*asin(sqrt((1-|x|)/2))` measured from whichever end `x` is near.

`acos` of anything outside `[-1, 1]`, and of `NaN`, is `NaN`.

-}
acos : Float -> Float
acos x =
    let
        hx =
            highWord x

        ix =
            Bitwise.and hx 0x7FFFFFFF
    in
    if ix >= 0x3FF00000 then
        -- |x| >= 1
        if Bitwise.or (ix - 0x3FF00000) (lowWord x) == 0 then
            -- |x|==1
            if hx > 0 then
                -- acos(1) = 0
                0.0

            else
                -- acos(-1)= pi
                pi + 2.0 * pio2Lo

        else
            -- acos(|x|>1) is NaN
            (x - x) / (x - x)

    else if ix < 0x3FE00000 then
        -- |x| < 0.5
        if ix <= 0x3C600000 then
            -- if |x| < 2**-57
            pio2Hi + pio2Lo

        else
            let
                r =
                    pq (x * x)
            in
            pio2Hi - (x - (pio2Lo - x * (r.p / r.q)))

    else if hx < 0 then
        -- x < -0.5
        let
            z =
                (1.0 + x) * 0.5

            r =
                pq z

            s =
                sqrt z

            w =
                (r.p / r.q) * s - pio2Lo
        in
        pi - 2.0 * (s + w)

    else
        -- x > 0.5
        let
            z =
                (1.0 - x) * 0.5

            s =
                sqrt z

            -- __LO(df) = 0
            df =
                fromWords (highWord s) 0

            c =
                (z - df * df) / (s + df)

            r =
                pq z

            w =
                (r.p / r.q) * s + c
        in
        2.0 * (df + w)
