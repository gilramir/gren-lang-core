module String exposing
    ( String, isEmpty, count, reverse, repeat, replace
    , prepend, append, split, join, words, lines
    , slice, takeFirst, takeLast, dropFirst, dropLast
    , contains, startsWith, endsWith, firstIndexOf, lastIndexOf, indices
    , toInt, fromInt
    , fromInt64, fromUInt32, fromUInt64
    , toFloat, fromFloat, fromFloat32
    , fromChar, pushFirst, pushLast, popFirst, popLast
    , toArray, fromArray
    , toUpper, toLower, pad, padLeft, padRight, trim, trimLeft, trimRight
    , map, keepIf, foldl, foldr, any, all
    , graphemes, graphemeLength, foldlGraphemes
    )

{-| A built-in representation for efficient string manipulation. When it comes to strings,
there are two concepts worth knowing about:

* Code points: represents a unicode character, and is what a `Char` holds.
* Graphemes: represents a single visual glyph, like certain emojis or characters with
accents, and can be made of several code points.

How a string is stored is up to the platform, and nothing in this module depends on it.
Unless otherwise noted, all functions in this module deal with code points: a length is a
number of code points, and an index counts them.


@docs String, isEmpty, count, reverse, repeat, replace


## Building and Splitting

@docs prepend, append, split, join, words, lines


## Get Substrings

@docs slice, takeFirst, takeLast, dropFirst, dropLast


## Check for Substrings

@docs contains, startsWith, endsWith, firstIndexOf, lastIndexOf, indices


## Int Conversions

@docs toInt, fromInt


## Sized Integer Conversions

D2's three sized integer types render their decimal digits here rather than
through [fromInt](#fromInt), because none of them fits in an `Int`: a `UInt32`
runs to `4294967295` and the two 64-bit widths run far past that. These are
what [Inspect](Inspect#Inspect) writes R5's `(42 : Int64)` over, and what a program
that wants the digits without the annotation calls directly.

@docs fromInt64, fromUInt32, fromUInt64


## Float Conversions

@docs toFloat, fromFloat, fromFloat32


## Char Conversions

@docs fromChar, pushFirst, pushLast, popFirst, popLast


## Array Conversions

@docs toArray, fromArray


## Formatting

Cosmetic operations such as padding with extra characters or trimming whitespace.

@docs toUpper, toLower, pad, padLeft, padRight, trim, trimLeft, trimRight

## Higher-Order Functions

@docs map, keepIf, foldl, foldr, any, all

## Graphemes

A grapheme cluster is what a reader calls a character and what a cursor moves
over: `e` with a combining acute, a flag written as two regional indicators, a
family emoji joined by zero-width joiners, a Hangul syllable spelled as three
jamo. It is a sequence of code points, and the boundaries between clusters are
[UAX #29][uax29]'s extended grapheme cluster boundaries at the Unicode version
[Unicode.version](Unicode#version) names.

There is no `foldrGraphemes`. Four of UAX #29's rules are about what came
*before* the boundary being judged, so a right-to-left walk is a different
algorithm rather than a mirror of the left-to-right one, and `foldr (::) []` of
the graphemes is the same answer as reversing what this gives.

[uax29]: https://www.unicode.org/reports/tr29/

@docs graphemes, graphemeLength, foldlGraphemes

-}

import Array exposing (Array)
import Array.Builder
import Basics exposing (..)
import Math exposing (floor, ceiling)
import Bitwise
import Char exposing (Char)
import Int64
import Maybe exposing (Maybe(..))
import Result exposing (Result)
import String.Ryu as Ryu
import UInt32
import UInt64
import Unicode.Grapheme
import Unicode.Lookup



-- STRINGS


{-| A `String` is a chunk of text. `String` literals are enclosed in `"double quotes"`.

    "Hello!"

    "How are you?"

    "🙈🙉🙊"

    -- strings with escape characters
    "this\n\t\"that\""

    "🙈🙉🙊" -- "🙈🙉🙊"

    -- multiline strings
    """Triple double quotes let you
    create "multiline strings" which
    can have unescaped quotes and newlines.
    """

A `String` can represent any sequence of [unicode characters][u]. You can use
the unicode escapes from `\u{0000}` to `\u{10FFFF}` to represent characters
by their code point. You can also include the unicode characters directly.
Using the escapes can be better if you need one of the many whitespace
characters with different widths.

[u]: https://en.wikipedia.org/wiki/Unicode

**Note:** JavaScript lets you use double quotes and single quotes interchangably.
This is not true in Gren. You must use double quotes for a `String`, and you must
use single quotes for a [`Char`](Char#Char).

-}
type String
    = String -- NOTE: The compiler provides the real implementation.


{-| Determine if a string is empty.

    isEmpty "" == True

    isEmpty "the world" == False

-}
isEmpty : String -> Bool
isEmpty string =
    string == ""


{-| Count the number of characters in a string.

    count "innumerable" == 11

    count "" == 0

-}
count : String -> Int
count =
    primLength


{-| Reverse a string.

    reverse "stressed" == "desserts"

-}
reverse : String -> String
reverse str =
    toArray str
        |> Array.reverse
        |> fromArray


{-| Repeat a string _n_ times.

    repeat 3 "ha" == "hahaha"

-}
repeat : Int -> String -> String
repeat n chunk =
    repeatHelp n chunk ""


{-| Doubling, so that `repeat n` is O(log n) appends rather than n.
-}
repeatHelp : Int -> String -> String -> String
repeatHelp n chunk acc =
    if n <= 0 then
        acc

    else
        repeatHelp
            (Bitwise.shiftRightZfBy 1 n)
            (primAppend chunk chunk)
            (if Bitwise.and n 1 == 1 then primAppend acc chunk else acc)


{-| Replace all occurrences of some substring.

    replace "." "-" "Json.Decode.succeed" == "Json-Decode-succeed"

    replace "," "/" "a,b,c,d,e" == "a/b/c/d/e"

**Note:** If you need more advanced replacements, check out the
[`String.Parser`](String.Parser) module.

-}
replace : String -> String -> String -> String
replace before after string =
    join after (split before string)



-- BUILDING AND SPLITTING


{-| Combine two strings. You can also use [the `(++)` operator](Basics#++)
to do this.

    prepend "butter" "fly" == "butterfly"

-}
prepend : String -> String -> String
prepend =
    primAppend


{-| Append one string onto another. This is the same operation as [prepend](prepend),
but with the arguments reversed.
    
    append "butter" "fly" == "flybutter"

-}
append : String -> String -> String
append lhs rhs =
    prepend rhs lhs


{-| Split a string using a given separator. If the seperator doesn't appear,
you will get an array containing the original string.

    split "," "" == [""]
    
    split "," "cat" == ["cat"]
    
    split "," "cat,dog,cow" == [ "cat", "dog", "cow" ]
    
    split "/" "home/evan/Desktop/" == [ "home", "evan", "Desktop", "" ]

-}
@externPure(erlang, "geng_core_string", "split")
split : String -> String -> Array String
split sep string =
    if primEq sep "" then
        -- A codepoint each. JavaScript's `split("")` cut an astral character
        -- into its two surrogates, which a `String` cannot hold (D209).
        foldl (\c acc -> Array.Builder.pushLast (fromChar c) acc) (Array.Builder.empty 0) string
            |> Array.Builder.toArray

    else
        splitHelp sep (primEnd sep) string (Offset 0) (Array.Builder.empty 0)


splitHelp : String -> Int -> String -> Offset -> Array.Builder.Builder String -> Array String
splitHelp sep sepEnd string (Offset start) acc =
    let
        found =
            primFind string sep start
    in
    if found < 0 then
        Array.Builder.pushLast (primSlice string start (primEnd string)) acc
            |> Array.Builder.toArray

    else
        splitHelp sep sepEnd string (Offset (found + sepEnd)) (Array.Builder.pushLast (primSlice string start found) acc)


{-| Put many strings together with a given separator.

    join "a" [ "H", "w", "ii", "n" ] == "Hawaiian"

    join " " [ "cat", "dog", "cow" ] == "cat dog cow"

    join "/" [ "home", "evan", "Desktop" ] == "home/evan/Desktop"

-}
join : String -> Array String -> String
join sep strings =
    when Array.popFirst strings is
        Nothing ->
            ""

        Just { first, rest } ->
            Array.foldl (\string acc -> primAppend (primAppend acc sep) string) first rest


{-| Break a string into words, splitting on chunks of whitespace.

    words "How are \t you? \n Good?" == [ "How", "are", "you?", "Good?" ]

A string with no words in it — empty, or nothing but whitespace — has no words
in it: `words "" == []`.

Whitespace here is Unicode's `White_Space` property at the version
[`Unicode.version`](Unicode#version) names, and not the host's idea of it
(`docs/unicode.md` U2).

-}
words : String -> Array String
words string =
    let
        step c acc =
            if Unicode.Lookup.isWhitespace c then
                { done = closeWord acc, current = "" }

            else
                { acc | current = pushLast c acc.current }
    in
    foldl step { done = Array.Builder.empty 0, current = "" } string
        |> closeWord
        |> Array.Builder.toArray


{-| Move a half-built word into the answer, unless there is no word there.
-}
closeWord : { done : Array.Builder.Builder String, current : String } -> Array.Builder.Builder String
closeWord acc =
    if acc.current == "" then
        acc.done

    else
        Array.Builder.pushLast acc.current acc.done


{-| Break a string into lines, splitting on newlines.

    lines "How are you?\nGood?" == [ "How are you?", "Good?" ]

-}
lines : String -> Array String
lines string =
    string
        |> replace "\u{000D}\n" "\n"
        |> replace "\u{000D}" "\n"
        |> split "\n"



-- SUBSTRINGS


{-| Take a substring given a start and end index. Negative indexes
are taken starting from the _end_ of the array.

    slice 7 9 "snakes on a plane!" == "on"

    slice 0 6 "snakes on a plane!" == "snakes"

    slice 0 -7 "snakes on a plane!" == "snakes on a"

    slice -6 -1 "snakes on a plane!" == "plane"

-}
slice : Int -> Int -> String -> String
slice start end string =
    let
        length =
            primLength string

        clampIndex i =
            if i < 0 then
                max 0 (length + i)

            else
                min length i

        from =
            clampIndex start

        to =
            clampIndex end
    in
    if to <= from then
        ""

    else if length == primEnd string then
        -- Every codepoint is one offset wide, so an index is an offset.
        primSlice string from to

    else
        let
            fromOffset =
                offsetAfter string (Offset 0) from

            toOffset =
                offsetAfter string fromOffset (to - from)
        in
        primSlice string (offsetValue fromOffset) (offsetValue toOffset)


{-| The offset `n` codepoints after the given one.
-}
offsetAfter : String -> Offset -> Int -> Offset
offsetAfter string (Offset o) n =
    if n <= 0 then
        Offset o

    else
        offsetAfter string (Offset (primNext string o)) (n - 1)


{-| Make a new string using the first _n_ characters. If _n_ is larger than
the length of the string, then the string is returned as is.

    takeFirst 2 "Mulder" == "Mu"

    takeFirst 8 "Mulder" == "Mulder"

-}
takeFirst : Int -> String -> String
takeFirst n string =
    if n < 1 then
        ""

    else
        slice 0 n string


{-| Make a new string using the last _n_ characters. If _n_ is larger than
the length of the string, then the string is returned as is.

    takeLast 2 "Scully" == "ly"

    takeLast 8 "Scully" == "Scully"

-}
takeLast : Int -> String -> String
takeLast n string =
    if n < 1 then
        ""

    else
        slice -n (primLength string) string


{-| Drop the first _n_ characters.

    dropFirst 2 "The Lone Gunmen" == "e Lone Gunmen"

-}
dropFirst : Int -> String -> String
dropFirst n string =
    if n < 1 then
        string

    else
        slice n (primLength string) string


{-| Drop the last _n_ characters.

    dropLast 2 "Cigarette Smoking Man" == "Cigarette Smoking M"

-}
dropLast : Int -> String -> String
dropLast n string =
    if n < 1 then
        string

    else
        slice 0 -n string



-- DETECT SUBSTRINGS


{-| See if the second string contains the first one.

    contains "the" "theory" == True

    contains "hat" "theory" == False

    contains "THE" "theory" == False

-}
contains : String -> String -> Bool
contains sub string =
    primFind string sub 0 >= 0


{-| See if the second string starts with the first one.

    startsWith "the" "theory" == True

    startsWith "ory" "theory" == False

-}
startsWith : String -> String -> Bool
startsWith sub string =
    primEnd sub <= primEnd string && primFind string sub 0 == 0


{-| See if the second string ends with the first one.

    endsWith "the" "theory" == False

    endsWith "ory" "theory" == True

-}
endsWith : String -> String -> Bool
endsWith sub string =
    let
        at =
            primEnd string - primEnd sub
    in
    at >= 0 && primFindLast string sub at == at


{-| Find the index of the first string within the second one, if it's there.

    firstIndexOf "the" "theory" == Just 0

    firstIndexOf "ory" "theory" == Just 3

    firstIndexOf "a" "theory" == Nothing

The index is a **codepoint** index, so it can be handed straight to
[slice](#slice), [takeFirst](#takeFirst) and [dropFirst](#dropFirst), which take
one:

    theory = "\u{1D11E}ory"

    firstIndexOf "ory" theory == Just 1

    slice 1 4 theory == "ory"

-}
firstIndexOf : String -> String -> Maybe Int
firstIndexOf sub string =
    let
        found =
            primFind string sub 0
    in
    if found < 0 then
        Nothing

    else
        Just (primOffsetToIndex string found)


{-| Find the last index of the first string within the second one, if it's there.

    lastIndexOf "abra" "abracadabra" == Just 7

    lastIndexOf "barb" "abracadabra" == Nothing

A codepoint index, as in [firstIndexOf](#firstIndexOf).

-}
lastIndexOf : String -> String -> Maybe Int
lastIndexOf sub string =
    let
        found =
            primFindLast string sub (primEnd string)
    in
    if found < 0 then
        Nothing

    else
        Just (primOffsetToIndex string found)


{-| Get all of the indices for a substring in another string.

    indices "i" "Mississippi" == [ 1, 4, 7, 10 ]

    indices "ss" "Mississippi" == [ 2, 5 ]

    indices "needle" "haystack" == []

Codepoint indices, as in [firstIndexOf](#firstIndexOf).

-}
indices : String -> String -> Array Int
indices sub string =
    let
        subEnd =
            primEnd sub
    in
    if subEnd < 1 then
        []

    else
        indicesHelp sub subEnd string (Offset 0) 0 (Offset 0) (Array.Builder.empty 0)


{-| Each match's index is the last one's plus the codepoints between them, so
the conversion is one walk over the string however many matches there are.
-}
indicesHelp : String -> Int -> String -> Offset -> Int -> Offset -> Array.Builder.Builder Int -> Array Int
indicesHelp sub subEnd string (Offset from) lastIndex (Offset lastOffset) acc =
    let
        found =
            primFind string sub from
    in
    if found < 0 then
        Array.Builder.toArray acc

    else
        let
            index =
                lastIndex + primLength (primSlice string lastOffset found)
        in
        indicesHelp sub subEnd string (Offset (found + subEnd)) index (Offset found) (Array.Builder.pushLast index acc)



-- FORMATTING


{-| Convert a string to all upper case. Useful for case-insensitive comparisons
and VIRTUAL YELLING.

    toUpper "skinner" == "SKINNER"

    toUpper "stra\u{00DF}e" == "STRASSE"

Full, non-locale case mapping at the version
[`Unicode.version`](Unicode#version) names: a character may uppercase to more
than one character, as `\u{00DF}` does, so the result is not always as long as
the argument. It is not the host's mapping, and it is the same mapping on every
backend (`docs/unicode.md` U2).

The *conditional* mappings are not applied, because they depend on a locale or
on the surrounding text and `core` has no notion of either. The one that is
visible in practice is final sigma: `toLower "\u{039F}\u{0394}\u{039F}\u{03A3}"`
is `"\u{03BF}\u{03B4}\u{03BF}\u{03C3}"` here, with an ordinary sigma at the
end rather than `\u{03C2}`.

-}
toUpper : String -> String
toUpper string =
    foldl (mapCase Unicode.Lookup.upperDelta Unicode.Lookup.upperExpansion) "" string


{-| Convert a string to all lower case. Useful for case-insensitive comparisons.

    toLower "X-FILES" == "x-files"

-}
toLower : String -> String
toLower string =
    foldl (mapCase Unicode.Lookup.lowerDelta Unicode.Lookup.lowerExpansion) "" string


{-| One character of a case mapping, onto the end of what is built so far.

Two tables and three cases, in the order they are cheap: a character whose
mapping is one character is a distance from it, a character whose mapping is
longer is looked up in a much smaller table, and everything else — which is
nearly every character of nearly every string — maps to itself.
-}
mapCase : (Char -> Int) -> (Char -> Maybe (Array Char)) -> Char -> String -> String
mapCase delta expansion c acc =
    let
        distance =
            delta c
    in
    if distance /= 0 then
        when Char.fromCode (Char.toCode c + distance) is
            Just mapped ->
                pushLast mapped acc

            -- Unreachable: a case mapping never names a surrogate and never
            -- leaves the codespace. `Char.fromCode` is `Maybe` since C8, and
            -- the honest answer to a `Nothing` that cannot happen is the one
            -- given to a character with no mapping at all.
            Nothing ->
                pushLast c acc

    else
        when expansion c is
            Just chars ->
                acc ++ fromArray chars

            Nothing ->
                pushLast c acc


{-| Pad a string on both sides until it has a given length.

    pad 5 ' ' "1" == "  1  "

    pad 5 ' ' "11" == "  11 "

    pad 5 ' ' "121" == " 121 "

-}
pad : Int -> Char -> String -> String
pad n char string =
    let
        half =
            Basics.toFloat (n - count string) / 2
    in
    repeat (ceiling half) (fromChar char) ++ string ++ repeat (floor half) (fromChar char)


{-| Pad a string on the left until it has a given length.

    padLeft 5 '.' "1" == "....1"

    padLeft 5 '.' "11" == "...11"

    padLeft 5 '.' "121" == "..121"

-}
padLeft : Int -> Char -> String -> String
padLeft n char string =
    repeat (n - count string) (fromChar char) ++ string


{-| Pad a string on the right until it has a given length.

    padRight 5 '.' "1" == "1...."

    padRight 5 '.' "11" == "11..."

    padRight 5 '.' "121" == "121.."

-}
padRight : Int -> Char -> String -> String
padRight n char string =
    string ++ repeat (n - count string) (fromChar char)


{-| Get rid of whitespace on both sides of a string.

    trim "  hats  \n" == "hats"

Whitespace is Unicode's `White_Space` property at the version
[`Unicode.version`](Unicode#version) names — 25 codepoints, and the same 25 on
every backend. It is *not* the host's: ECMAScript trims U+FEFF, which is not
`White_Space`, and does not trim U+0085, which is (`docs/unicode.md` U2).

-}
trim : String -> String
trim string =
    trimRight (trimLeft string)


{-| Get rid of whitespace on the left of a string.

    trimLeft "  hats  \n" == "hats  \n"

-}
trimLeft : String -> String
trimLeft string =
    when popFirst string is
        Just { first, rest } ->
            if Unicode.Lookup.isWhitespace first then
                trimLeft rest

            else
                string

        Nothing ->
            string


{-| Get rid of whitespace on the right of a string.

    trimRight "  hats  \n" == "  hats"

-}
trimRight : String -> String
trimRight string =
    when popLast string is
        Just { last, rest } ->
            if Unicode.Lookup.isWhitespace last then
                trimRight rest

            else
                string

        Nothing ->
            string



-- INT CONVERSIONS


{-| Try to convert a string into an int, failing on improperly formatted strings.

    String.toInt "123" == Just 123

    String.toInt "-42" == Just -42

    String.toInt "3.1" == Nothing

    String.toInt "31a" == Nothing

If you are extracting a number from some raw user input, you will typically
want to use [`Maybe.withDefault`](Maybe#withDefault) to handle bad data:

    Maybe.withDefault 0 (String.toInt "42") == 42

    Maybe.withDefault 0 (String.toInt "ab") == 0

-}
toInt : String -> Maybe Int
toInt string =
    let
        end =
            primEnd string

        first =
            if end == 0 then
                0

            else
                Char.toCode (primCharAt string 0)

        signed =
            first == 0x2D || first == 0x2B

        start =
            if signed then
                primNext string 0

            else
                0
    in
    if start == end then
        Nothing

    else
        when toIntHelp string end (Offset start) 0 is
            Nothing ->
                Nothing

            Just magnitude ->
                if first == 0x2D then
                    Just magnitude

                else if magnitude == -2147483648 then
                    -- 2147483648, one past the largest `Int` (D2).
                    Nothing

                else
                    Just (negate magnitude)


{-| The digits, as a **non-positive** `Int`, so that `-2147483648` is reachable
without overflowing on the way, as `int64Digits` counts down for the same
reason. A number too large for an `Int` is `Nothing`: the kernel's loop
answered a JavaScript number past 32 bits, which the next arithmetic wrapped.
-}
toIntHelp : String -> Int -> Offset -> Int -> Maybe Int
toIntHelp string end (Offset o) acc =
    if o == end then
        Just acc

    else
        let
            code =
                Char.toCode (primCharAt string o)

            digit =
                code - 0x30
        in
        if code < 0x30 || code > 0x39 then
            Nothing

        else if acc < -214748364 || (acc == -214748364 && digit > 8) then
            Nothing

        else
            toIntHelp string end (Offset (primNext string o)) (acc * 10 - digit)


{-| Convert an `Int` to a `String`.

    String.fromInt 123 == "123"

    String.fromInt -42 == "-42"

Check out [`inspect`](Inspect#Inspect) to convert any value that has an
`Inspect` instance to a string for debugging purposes.

-}
fromInt : Int -> String
fromInt n =
    if n < 0 then
        primAppend "-" (intDigits n)

    else
        intDigits (negate n)


{-| The decimal digits of a **non-positive** `Int`, as `int64Digits` below.
-}
intDigits : Int -> String
intDigits n =
    let
        quotient =
            n // 10

        digit =
            primSlice "0123456789" (negate (remainderBy 10 n)) (1 - remainderBy 10 n)
    in
    if quotient == 0 then
        digit

    else
        primAppend (intDigits quotient) digit



-- SIZED INTEGER CONVERSIONS
--
-- Written in Gren, as `fromInt` now is too: the kernel's `fromNumber` was
-- JavaScript's `String(x)`, and a `BigInt` is not the only thing these
-- are: `docs/core.md` C13 has a backend where an
-- `Int64` is an `i64` and a `UInt64` is a `u64`, and a decimal rendering by
-- repeated division is the same rendering on all of them. The division is the
-- width's own `//` and `remainderBy`, which A3 makes total and A11 makes
-- truncating.


{-| Convert an `Int64` to a `String`.

    String.fromInt64 (9223372036854775807 : Int64) == "9223372036854775807"

    String.fromInt64 (-42 : Int64) == "-42"

-}
fromInt64 : Int64 -> String
fromInt64 n =
    if n < 0 then
        "-" ++ int64Digits n

    else
        int64Digits (negate n)


{-| The decimal digits of a **non-positive** `Int64`, without a sign.

Counting down rather than up is not a flourish: A6 makes `negate` at
`Int64.minValue` answer `Int64.minValue`, so a loop that normalized to the
positive side would be wrong at exactly one value -- the one a test reaches
last, and the one D2 exists to stop being wrong about.

-}
int64Digits : Int64 -> String
int64Digits n =
    let
        quotient =
            n // 10

        digit =
            fromInt (Int64.toInt (negate (remainderBy 10 n)))
    in
    if quotient == 0 then
        digit

    else
        int64Digits quotient ++ digit


{-| Convert a `UInt32` to a `String`.

    String.fromUInt32 (4294967295 : UInt32) == "4294967295"

-}
fromUInt32 : UInt32 -> String
fromUInt32 n =
    let
        quotient =
            n // 10

        digit =
            fromInt (UInt32.toInt (remainderBy 10 n))
    in
    if quotient == 0 then
        digit

    else
        fromUInt32 quotient ++ digit


{-| Convert a `UInt64` to a `String`.

    String.fromUInt64 (18446744073709551615 : UInt64) == "18446744073709551615"

-}
fromUInt64 : UInt64 -> String
fromUInt64 n =
    let
        quotient =
            n // 10

        digit =
            fromInt (UInt64.toInt (remainderBy 10 n))
    in
    if quotient == 0 then
        digit

    else
        fromUInt64 quotient ++ digit



-- FLOAT CONVERSIONS


{-| Try to convert a string into a float, failing on improperly formatted strings.

    String.toFloat "123" == Just 123.0

    String.toFloat "-42" == Just -42.0

    String.toFloat "3.1" == Just 3.1

    String.toFloat "31a" == Nothing

If you are extracting a number from some raw user input, you will typically
want to use [`Maybe.withDefault`](Maybe#withDefault) to handle bad data:

    Maybe.withDefault 0 (String.toFloat "42.5") == 42.5

    Maybe.withDefault 0 (String.toFloat "cats") == 0

It reads everything [`fromFloat`](#fromFloat) writes, `"NaN"`, `"Infinity"` and
`"-Infinity"` included, so `toFloat (fromFloat x)` gives back `x` for every
`Float` but the sign of `-0.0`.

-}
toFloat : String -> Maybe Float
toFloat string =
    if primEq string "NaN" then
        Just (0 / 0)

    else if isDecimal string then
        Just (primFromDecimal string)

    else
        Nothing


{-| The strings `toFloat` reads, which are what the kernel's `+s` read once
whitespace and the `0x`, `0b` and `0o` prefixes were refused: an optional sign,
then `Infinity`, or digits with an optional point and fraction (either side of
the point may be empty but not both), then an optional exponent (D210).
-}
isDecimal : String -> Bool
isDecimal string =
    let
        end =
            primEnd string

        afterSign =
            if end > 0 && (primCharAt string 0 == '-' || primCharAt string 0 == '+') then
                1

            else
                0

        rest =
            primSlice string afterSign end
    in
    if primEq rest "Infinity" then
        True

    else
        let
            intEnd =
                skipDigits rest (primEnd rest) 0

            { fracStart, fracEnd } =
                if intEnd < primEnd rest && primCharAt rest intEnd == '.' then
                    { fracStart = intEnd + 1, fracEnd = skipDigits rest (primEnd rest) (intEnd + 1) }

                else
                    { fracStart = intEnd, fracEnd = intEnd }

            mantissaDigits =
                intEnd + (fracEnd - fracStart)
        in
        if mantissaDigits == 0 then
            False

        else if fracEnd == primEnd rest then
            True

        else if primCharAt rest fracEnd == 'e' || primCharAt rest fracEnd == 'E' then
            let
                expSign =
                    fracEnd + 1

                expStart =
                    if expSign < primEnd rest && (primCharAt rest expSign == '-' || primCharAt rest expSign == '+') then
                        expSign + 1

                    else
                        expSign

                expEnd =
                    skipDigits rest (primEnd rest) expStart
            in
            expEnd > expStart && expEnd == primEnd rest

        else
            False


{-| The offset past a run of ASCII digits. A digit is one offset wide on every
backend, so the arithmetic on offsets here is sound.
-}
skipDigits : String -> Int -> Int -> Int
skipDigits string end o =
    if o < end && Char.toCode (primCharAt string o) >= 0x30 && Char.toCode (primCharAt string o) <= 0x39 then
        skipDigits string end (o + 1)

    else
        o


{-| Convert a `Float` to a `String`.

    String.fromFloat 123 == "123.0"

    String.fromFloat -42 == "-42.0"

    String.fromFloat 3.9 == "3.9"

    String.fromFloat 1.0e21 == "1.0e21"

The result is the **shortest decimal that reads back as the same `Float`**, laid
out the way `docs/representation.md` R5 pins it: always at least one digit on
each side of the point, and scientific notation — written `1.0e21`, with no `+`
— when the decimal exponent is below -6 or above 20. A `Float` therefore always
looks like one, which `String.fromInt` of the same number does not.

`nan`, the infinities and the sign of `-0.0` are the one place this differs from
[`inspect`](Inspect#Inspect), and deliberately (R5): what `fromFloat` writes has
to be what [`toFloat`](#toFloat) reads, and `inspect` answers to a format instead.

-}
fromFloat : Float -> String
fromFloat number =
    if isNaN number then
        "NaN"

    else if isInfinite number then
        if number < 0 then
            "-Infinity"

        else
            "Infinity"

    else if number == 0 then
        -- Both zeros, which `==` cannot tell apart (A2). R5 gives the sign of
        -- `-0.0` to `inspect` and not to this function, so neither zero gets
        -- one here (`docs/m1b-ryu.md` §Y4).
        "0.0"

    else
        let
            sign =
                if number < 0 then
                    "-"

                else
                    ""

            normalized =
                shortestDigits number
        in
        when firstIndexOf "e" normalized is
            Just at ->
                place sign
                    (takeFirst at normalized)
                    (dropFirst (at + 1) normalized |> toInt |> Maybe.withDefault 0)

            Nothing ->
                normalized


{-| The shortest digits that read back as `number`, and the decimal exponent of
the first of them, as `<digits>e<exponent>`: `1.5e-7` is `15e-7`, `1.0e21` is
`1e21`. No sign, no point, no trailing zero; `number` is finite and not zero,
and its sign is ignored (D328, `docs/m1b-ryu.md` §Y16).

The body is the portable implementation, Ryu's `decimal`, and it is what every
backend without a `js` row compiles. On JavaScript the host's
`toExponential()` answers the same digits, which §Y16.2 checked and the
`geng-hs-bodies` target keeps checking, at about a seventh of the cost.
-}
@externPure(js, "String", "shortestDigits")
shortestDigits : Float -> String
shortestDigits number =
    let
        { mantissa, exponent } =
            Ryu.decimal number

        digits =
            fromUInt64 mantissa
    in
    digits ++ "e" ++ fromInt (exponent + count digits - 1)


{-| Convert a `Float32` to a `String`.

    String.fromFloat32 (1.5 : Float32) == "1.5"

    String.fromFloat32 (0.1 : Float32) == "0.1"

[`fromFloat`](#fromFloat) at the other width, and the same R5 layout over the
same thresholds -- what differs is the digits, which are the shortest that read
back **as a single**. That is not the same set as the double's and the second
line above is why: `(0.1 : Float32)` is not the `Float` `0.1`, it is the binary32 nearest
it, and widening that to a `Float` and printing it gives
`"0.10000000149011612"`. Both strings name the same `Float32`; this one is the
shortest that does.

There is no `toFloat32` for this to be the inverse of, and the pair that looks
like one -- [`toFloat`](#toFloat) and then
[`Float32.fromFloat`](Float32#fromFloat) -- **is not always its inverse**. That
pair rounds twice, decimal to a `Float` and `Float` to a `Float32`, and what
this function writes is the shortest decimal that rounds **once** onto the value,
which is what R5 pins and what a `strtof` does. The two disagree at exactly one
`Float32` in the whole 2^32 -- `7.038531e-26`, at either sign -- where the round
trip lands on the neighbour instead (`docs/m1b-ryu.md` §Y14.6, which counted
them, and where the fix is a `String.toFloat32` that rounds once).

-}
fromFloat32 : Float32 -> String
fromFloat32 number =
    if isNaN number then
        "NaN"

    else if isInfinite number then
        if number < 0 then
            "-Infinity"

        else
            "Infinity"

    else if number == 0 then
        "0.0"

    else
        let
            sign =
                if number < 0 then
                    "-"

                else
                    ""

            { mantissa, exponent } =
                Ryu.decimal32 number

            digits =
                fromUInt64 mantissa
        in
        place sign digits (exponent + count digits - 1)



-- R5'S FLOAT LAYOUT
--
-- The digits are `String.Ryu`'s, which is `docs/m1b-ryu.md` §Y7's port of the
-- shortest-round-trip algorithm; what is here is where the point goes. Ryu
-- answers with a mantissa and the power of ten its last digit stands for, so
-- the exponent `place` wants -- the one the *first* digit stands for -- is that
-- plus the digit count less one.
--
-- §Y6 is why no expectation moved when the port landed: the digits were
-- `Number::toString`'s until then, and §Y2 had measured those to be the same
-- digits. `corpus/accept/inspect-floats` was written against the delegation and
-- holds the port to it.


{-| `sign`, the significant digits, and the exponent of the first of them.

R5's thresholds, and §Y3 is why they are these numbers: they are JavaScript's,
which is where every expectation already written came from.
-}
place : String -> String -> Int -> String
place sign digits exponent =
    if exponent < -6 || exponent > 20 then
        sign
            ++ takeFirst 1 digits
            ++ "."
            ++ orZero (dropFirst 1 digits)
            ++ "e"
            ++ fromInt exponent

    else if exponent < 0 then
        sign ++ "0." ++ repeat (negate exponent - 1) "0" ++ digits

    else if count digits > exponent + 1 then
        sign
            ++ takeFirst (exponent + 1) digits
            ++ "."
            ++ dropFirst (exponent + 1) digits

    else
        sign
            ++ digits
            ++ repeat (exponent + 1 - count digits) "0"
            ++ ".0"


orZero : String -> String
orZero digits =
    if digits == "" then
        "0"

    else
        digits


-- ARRAY CONVERSIONS


{-| Convert a string to an array of characters.

    toArray "abc" == [ 'a', 'b', 'c' ]

    toArray "🙈🙉🙊" == [ '🙈', '🙉', '🙊' ]

-}
toArray : String -> Array Char
toArray string =
    foldl Array.Builder.pushLast (Array.Builder.empty 0) string
        |> Array.Builder.toArray


{-| Convert an array of characters into a String.
    
    fromArray [ 'a', 'b', 'c' ] == "abc"

    fromArray [ '🙈', '🙉', '🙊' ] == "🙈🙉🙊"

-}
fromArray : Array Char -> String
fromArray =
    primFromCodepoints



-- CHAR CONVERSIONS


{-| Create a string from a given character.

    fromChar 'a' == "a"

-}
fromChar : Char -> String
fromChar char =
    pushFirst char ""


{-| Add a character to the beginning of a string.

    pushFirst 'T' "he truth is out there" == "The truth is out there"

-}
pushFirst : Char -> String -> String
pushFirst char string =
    primAppend (primFromCodepoints [ char ]) string


{-| Add a character to the end of a string.

    pushLast 'T' "he truth is out there" == "he truth is out thereT"

-}
pushLast : Char -> String -> String
pushLast char string =
    primAppend string (primFromCodepoints [ char ])


{-| Split a non-empty string into its first character and its remaining characters. This lets you
pattern match on strings exactly as you would with arrays.

    popFirst "abc" == Just { first = 'a', rest = "bc" }

    popFirst "" == Nothing

-}
popFirst : String -> Maybe { first : Char, rest : String }
popFirst string =
    let
        end =
            primEnd string
    in
    if end == 0 then
        Nothing

    else
        Just { first = primCharAt string 0, rest = primSlice string (primNext string 0) end }


{-| Split a non-empty string into its last character and its remaining characters. This lets you
pattern match on strings exactly as you would with arrays.

    popLast "abc" == Just { last = 'c', rest = "ab" }
    popLast "hi 🙂" == Just { last = '🙂', rest = "hi " }

    popLast "" == Nothing

-}
popLast : String -> Maybe { last : Char, rest : String }
popLast string =
    let
        end =
            primEnd string
    in
    if end == 0 then
        Nothing

    else
        let
            lastStart =
                primPrev string end
        in
        Just { last = primCharAt string lastStart, rest = primSlice string 0 lastStart }


-- HIGHER-ORDER FUNCTIONS


{-| Transform every character in a string

    map
        (\c ->
            if c == '/' then
                '.'

            else
                c
        )
        "a/b/c"
        == "a.b.c"

-}
map : (Char -> Char) -> String -> String
map fn str =
    foldl
        (\char acc ->
            pushLast (fn char) acc
        )
        ""
        str


{-| Keep only the characters that pass the test.

    keepIf isDigit "R2-D2" == "22"

-}
keepIf : (Char -> Bool) -> String -> String
keepIf isGood str =
    foldl
        (\char acc ->
            if isGood char then
                pushLast char acc

            else
                acc
        )
        ""
        str


{-| Reduce a string from the beginning.

    foldl cons "" "time" == "emit"

-}
foldl : (Char -> b -> b) -> b -> String -> b
foldl step initial string =
    primFoldl string initial step


{-| Reduce a string from the end.

    foldr cons "" "time" == "time"

-}
foldr : (Char -> b -> b) -> b -> String -> b
foldr step initial string =
    primFoldr string initial step


{-| Determine whether _any_ characters pass the test.

    any isDigit "90210" == True

    any isDigit "R2-D2" == True

    any isDigit "heart" == False

    any isDigit "" == False

-}
any : (Char -> Bool) -> String -> Bool
any isGood string =
    anyHelp isGood string (primEnd string) (Offset 0)


anyHelp : (Char -> Bool) -> String -> Int -> Offset -> Bool
anyHelp isGood string end (Offset o) =
    if o == end then
        False

    else if isGood (primCharAt string o) then
        True

    else
        anyHelp isGood string end (Offset (primNext string o))


{-| Determine whether _all_ characters pass the test.

    all isDigit "90210" == True

    all isDigit "R2-D2" == False

    all isDigit "heart" == False

    all isDigit "" = True

-}
all : (Char -> Bool) -> String -> Bool
all isGood str =
    not (any (not << isGood) str)


-- GRAPHEMES


{-| Break a string into its grapheme clusters — what a reader would call its
characters.

    graphemes "añb" == [ "a", "ñ", "b" ]

    -- "ñ" written as n plus a combining tilde is still one grapheme
    graphemes "an\u{0303}b" == [ "a", "n\u{0303}", "b" ]

    -- a flag is two regional indicators, and one grapheme
    graphemes "\u{1F1F3}\u{1F1F4}" == [ "\u{1F1F3}\u{1F1F4}" ]

This is [count](#count)'s other answer: `count` says how many code points a
string holds and this says how many characters it shows.

-}
graphemes : String -> Array String
graphemes string =
    foldlGraphemes Array.Builder.pushLast (Array.Builder.empty 0) string
        |> Array.Builder.toArray


{-| How many grapheme clusters a string holds.

    graphemeLength "an\u{0303}b" == 3

    count "an\u{0303}b" == 4

-}
graphemeLength : String -> Int
graphemeLength string =
    foldlGraphemes (\_ n -> n + 1) 0 string


{-| Reduce a string one grapheme cluster at a time, from the start.

    foldlGraphemes (\g acc -> acc ++ "|" ++ g) "" "an\u{0303}b"
        == "|a|n\u{0303}|b"

-}
foldlGraphemes : (String -> b -> b) -> b -> String -> b
foldlGraphemes fn initial string =
    let
        step c acc =
            let
                answer =
                    Unicode.Grapheme.step c acc.state
            in
            if answer.break then
                { state = answer.state
                , current = fromChar c
                , value = closeGrapheme fn acc
                }

            else
                { state = answer.state
                , current = pushLast c acc.current
                , value = acc.value
                }
    in
    closeGrapheme fn
        (foldl step
            { state = Unicode.Grapheme.start
            , current = ""
            , value = initial
            }
            string
        )


{-| Hand the cluster built so far to the fold, unless there is none — which
happens exactly once, before the first character, and is why the empty string
folds to what it started with.
-}
closeGrapheme : (String -> b -> b) -> { state : a, current : String, value : b } -> b
closeGrapheme fn acc =
    if acc.current == "" then
        acc.value

    else
        fn acc.current acc.value



-- `str_eq`, which is `===` on JavaScript and a byte comparison on UTF-8
-- (D206). It was `Gren.Kernel.Utils.identical` (D142,
-- `docs/m1b-classes.md` §G40), and before D142 the kernel's structural
-- walker, which reached the same answer through a `typeof`.


instance Eq String where
    eq a b =
        primEq a b


-- Codepoint order, which JavaScript `<` is not: `str_cmp` is guarded so
-- that it pays for the difference only when a surrogate is present, and
-- answers an `Int` this makes an `Order` (D8, §T13, D207). Before §T13 it was
-- `Gren.Kernel.Utils.compare`, whose string branch is `<` -- so `Array.sort`,
-- `Dict` and `Set`, which consult `compare` and nothing else, sorted every
-- astral character below U+E000-U+FFFF.


instance Ord String where
    compare a b =
        let
            c =
                primCmp a b
        in
        if c < 0 then
            LT

        else if c > 0 then
            GT

        else
            EQ


-- `a ++ b` is `prepend`, not `append`: `String.append` is the reversed one
-- (`docs/m1b-classes.md` §G34.2). So the method is `str_append`, the operation
-- the operator always ran, with its arguments in the order it always had them.


instance Appendable String where
    append a b =
        primAppend a b



-- PRIMITIVES
--
-- D206's table (`docs/m1b-str-prim.md` §Z3, §Z9). A position inside a string is
-- an offset, a code unit offset on JavaScript and a byte offset on a UTF-8
-- backend, and it never leaves this module: a public function that answers a
-- position answers a codepoint index, converted once by `primOffsetToIndex`.
-- `Offset` is what a position carried from one step of a loop to the next is,
-- so that an offset and an index cannot be mixed up there. The primitives
-- themselves take and give an `Int`, since a primitive is an expression and
-- cannot build a constructor.


type Offset
    = Offset Int


offsetValue : Offset -> Int
offsetValue (Offset o) =
    o


@prim("str_length")
primLength : String -> Int


@prim("str_append")
primAppend : String -> String -> String


@prim("str_eq")
primEq : String -> String -> Bool


@prim("str_cmp")
primCmp : String -> String -> Int


@prim("str_end")
primEnd : String -> Int


@prim("str_slice")
primSlice : String -> Int -> Int -> String


@prim("str_find")
primFind : String -> String -> Int -> Int


@prim("str_find_last")
primFindLast : String -> String -> Int -> Int


@prim("str_offset_to_index")
primOffsetToIndex : String -> Int -> Int


@prim("str_next")
primNext : String -> Int -> Int


@prim("str_prev")
primPrev : String -> Int -> Int


@prim("str_char_at")
primCharAt : String -> Int -> Char


@prim("str_foldl")
primFoldl : String -> b -> (Char -> b -> b) -> b


@prim("str_foldr")
primFoldr : String -> b -> (Char -> b -> b) -> b


@prim("str_from_codepoints")
primFromCodepoints : Array Char -> String


@prim("f64_from_decimal")
primFromDecimal : String -> Float
