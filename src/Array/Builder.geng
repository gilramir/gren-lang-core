module Array.Builder exposing
    ( Builder
    , empty, fromArray
    , pushLast, append
    , toArray
    )

{-| The functions in this module allows you to build an `Array` more efficiently.
Unless you have a performance problem, it's recommended to stick with the functions
in the `Array` module.

A `Builder` *is* the `tr_` transient (`m1b-arr-prim.md` D240), and this module
is the public face of it.

@docs Builder, empty, fromArray, pushLast, append, toArray

-}

import Array exposing (Array)
import Array.Transient as T
import Basics exposing (..)


{-| An `Array` under construction.
-}
type alias Builder a =
    T.Transient a


{-| Creates a [Builder](#Builder) without any elements.

The `Int` argument lets you specify the amount of elements you expect
to end up in the final `Array`. It is a hint: a `Builder` grows past it as
it needs to, and a hint above 65,536 is taken as 65,536.
-}
empty : Int -> Builder a
empty capacity =
    -- A hint is a guess, and may come from input: honoured whole, 2^31 - 1
    -- asked a native program for 16 GB at the first push, and made node's
    -- array a dictionary 25 times slower to fill. Above the cap a Builder
    -- doubles as one without a hint does. Core's own loops know their count
    -- and call T.new directly (D638, m3-sweep.md §SW23).
    T.new (clamp 0 maxHint capacity)


maxHint : Int
maxHint =
    65536


{-| Creates a [Builder](#Builder) based on an existing `Array`.
-}
@prim("tr_from_array")
fromArray : Array a -> Builder a


{-| Add a single element to a [Builder](#Builder).
-}
pushLast : a -> Builder a -> Builder a
pushLast value builder =
    T.push builder value


{-| Adds the elements of an `Array` to the end of a [Builder](#Builder).
-}
append : Array a -> Builder a -> Builder a
append array builder =
    appendHelp array 0 (Array.length array) builder


appendHelp : Array a -> Int -> Int -> Builder a -> Builder a
appendHelp array index len builder =
    if index < len then
        appendHelp array (index + 1) len (T.push builder (unsafeGet array index))

    else
        builder


@prim("arr_get")
unsafeGet : Array a -> Int -> a


{-| Converts a [Builder](#Builder) to an `Array`.
-}
@prim("tr_to_array")
toArray : Builder a -> Array a
