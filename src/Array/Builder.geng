module Array.Builder exposing
    ( Builder
    , empty, fromArray
    , pushLast, append
    , set, get, length
    , update, swap
    , setMany, fill, copyWithin, moveWithin
    , slice, copy, toArray
    )

{-| The functions in this module allows you to build an `Array` more efficiently.
Unless you have a performance problem, it's recommended to stick with the functions
in the `Array` module.

A `Builder` *is* the `tr_` transient (`m1b-arr-prim.md` D240), and this module
is the public face of it.

## Costs

On JavaScript and natively a builder is a mutable buffer with the count of its
elements, written in place while it is used linearly, each call given the
builder the call before answered. A write in place keeps what it overwrote in
the builder it was given, so every older builder still reads what it held
(geng-lang `m4-visiterm.md` D903): a `get` on one finds its element within 32
of the records, and past that the builder copies its elements once, O(n), and
reads them at O(1) after. A write to an older builder, or to one `toArray`
handed out, copies it first, O(n). So that the records do not pile up, the
buffer is copied once in as many writes in place as it has room for elements,
and natively once after each minor collection the builder has lived through,
for a buffer of at most 1 MiB; both are O(1) amortized. On the BEAM a builder is the same persistent 32-way
tree an `Array` becomes, where a push, `set` or `get` costs O(log₃₂ n), at most
about five steps, however the builder is used, and `toArray` builds a tuple.
Each cost is per call, n being the builder's length.

[`append`](#append), [`setMany`](#setMany), [`fill`](#fill) and
[`copyWithin`](#copyWithin) write a run of m elements in one call (geng-lang
`m4-visiterm.md` D904): on JavaScript and natively one builder and O(m), where
a loop of `pushLast` or `set` makes a builder an element. A run written in place
keeps the elements it replaced, as a `set` keeps one, so an older builder still
reads what it held; those m count toward the copy once in as many elements as
the buffer has room for.

[`update`](#update) and [`swap`](#swap) take an element out of a builder
while it is written, and [`moveWithin`](#moveWithin) moves elements and says
what is left where they were (geng-lang `m4-unique.md` D913). They are for a
builder of builders, or of other values written in place: written with them,
an element has one owner while it is out, where one taken out with `get` and
put back with `set` has two, the builder still holding it. Today each costs
what the `get` and `set` it is made of cost.

[`slice`](#slice) and [`copy`](#copy) only look at the builder they are
given, and copy what they answer out of it, O(n) (geng-lang `m4-own.md`
D931): a copy that leaves the builder where it is, for a builder of
builders, where [`toArray`](#toArray) would take it.

@docs Builder, empty, fromArray, pushLast, append, set, get, length
@docs update, swap
@docs setMany, fill, copyWithin, moveWithin
@docs slice, copy, toArray

-}

import Array exposing (Array)
import Array.Transient as T
import Basics exposing (..)
import Maybe exposing (Maybe(..))


{-| An `Array` under construction.
-}
type alias Builder a =
    T.Transient a


{-| Creates a [Builder](#Builder) without any elements.

The `Int` argument lets you specify the amount of elements you expect
to end up in the final `Array`. It is a hint: a `Builder` grows past it as
it needs to, and a hint above 65,536 is taken as 65,536.

It costs O(1): the hint is taken as at most 65,536.

-}
empty : Int -> Builder a
empty capacity =
    -- A hint is a guess, and may come from input: honoured whole, 2^31 - 1
    -- asked a native program for 16 GB at the first push, and made node's
    -- array a dictionary 25 times slower to fill. Above the cap a Builder
    -- doubles as one without a hint does. Core's own loops know their count
    -- and call T.new directly (D638, m3-sweep.md §SW23).
    T.new (clamp 0 maxHint capacity)


maxHint : Int
maxHint =
    65536


{-| Creates a [Builder](#Builder) based on an existing `Array`.

It costs O(n) once: on JavaScript and natively the builder's first write copies
the array, and on the BEAM a tuple is made a tree at once, where an array that
is a tree already costs O(1).

-}
@prim("tr_from_array")
fromArray : Array a -> Builder a


{-| Add a single element to a [Builder](#Builder).

It costs O(1) amortized on JavaScript and natively when the builder is the one
the call before answered, and O(n) otherwise, where it copies; on the BEAM it
costs O(log n), onto any version.

-}
pushLast : a -> (moved builder : Builder a) -> Builder a
pushLast value builder =
    T.push builder value


{-| Adds the elements of an `Array` to the end of a [Builder](#Builder).

It costs O(m) for an array of m elements, copied in at once on JavaScript and
natively, and pushed one by one on the BEAM, O(m log n).

-}
append : Array a -> (moved builder : Builder a) -> Builder a
append array builder =
    primSetArray builder (T.length builder) array


@prim("tr_set_array")
primSetArray : (moved t : Builder a) -> (i : Int where 0 <= i && i <= T.length t) -> (arr : Array a) -> (r : Builder a where (i + Array.length arr <= T.length t && T.length r == T.length t) || (T.length t < i + Array.length arr && T.length r == i + Array.length arr))


{-| Replace the element at the given index, or leave the builder as it is if
the index is out of bounds. A negative index counts back from the end, as in
[`Array.set`](Array#set).

    empty 3
        |> pushLast 1
        |> pushLast 2
        |> set 0 9
        |> toArray
        == [ 9, 2 ]

It costs O(1) amortized on JavaScript and natively when the builder is the one
the call before answered, and O(n) otherwise, where it copies, and O(log n) on
the BEAM, so a loop of builder sets is linear on every target where a loop of
[`Array.set`](Array#set) copies the array at each step on JavaScript and
natively (geng-lang `m3-cost.md` D753).

-}
set : Int -> a -> (moved builder : Builder a) -> Builder a
set index value builder =
    let
        at =
            actualIndex index builder
    in
    if at < 0 then
        builder

    else
        T.set builder at value


{-| Replace the element at the given index with what the function makes of
it, or leave the builder as it is, without calling the function, if the index
is out of bounds. A negative index counts back from the end, as in
[`set`](#set).

    fromArray [ 1, 2, 3 ]
        |> update 1 (\n -> n * 10)
        |> toArray
        == [ 1, 20, 3 ]

The builder gives the element up while the function runs, so a builder of
row builders writes a row as

    update y (set x cell) screen

where `set x cell (get y screen)` and a `set` back would leave the row in
the screen while it is written.

It costs a [`get`](#get) and a [`set`](#set), and what the function costs.

-}
update : Int -> (a -> a) -> (moved builder : Builder a) -> Builder a
update index f builder =
    let
        at =
            actualIndex index builder
    in
    if at < 0 then
        builder

    else
        T.set builder at (f (T.get builder at))


{-| Put a value at the given index and answer the element that was there,
with the builder; out of bounds, `old` is `Nothing` and the builder is as it
was. A negative index counts back from the end, as in [`set`](#set).

    swap 0 0 (fromArray [ 7, 8 ])
        |> (\{ old, builder } -> { old = old, array = toArray builder })
        == { old = Just 7, array = [ 0, 8 ] }

It is [`update`](#update) for a write that answers more than the element:
take the element out, leaving a placeholder, write it, and `set` it back.

It costs a [`get`](#get) and a [`set`](#set).

-}
swap : Int -> a -> (moved builder : Builder a) -> { old : Maybe a, builder : Builder a }
swap index value builder =
    let
        at =
            actualIndex index builder
    in
    if at < 0 then
        { old = Nothing, builder = builder }

    else
        let
            old =
                T.get builder at
        in
        { old = Just old, builder = T.set builder at value }


{-| Replace the elements from the given index on with an array's, as
[`Array.setMany`](Array#setMany) does: a negative index counts back from the
end, and elements that go past the end make the builder longer.

    fromArray [ 1, 2, 3, 4 ]
        |> setMany 1 [ 0, 0 ]
        |> toArray
        == [ 1, 0, 0, 4 ]

    fromArray [ 1, 2, 3, 4 ]
        |> setMany 3 [ 8, 9 ]
        |> toArray
        == [ 1, 2, 3, 8, 9 ]

It costs O(m) for an array of m elements on JavaScript and natively when the
builder is the one the call before answered, and O(n + m) otherwise, where it
copies; O(m log n) on the BEAM.

-}
setMany : Int -> Array a -> (moved builder : Builder a) -> Builder a
setMany index values builder =
    primSetArray builder (bound index (T.length builder)) values


{-| Write a value into the elements from the first index up to, but not
including, the second, which count back from the end when negative and stop
at the ends, as [`Array.slice`](Array#slice)'s do. The builder's length does
not change.

    fromArray [ 1, 2, 3, 4 ]
        |> fill 1 3 0
        |> toArray
        == [ 1, 0, 0, 4 ]

It costs O(m) for m elements written, on the terms [`setMany`](#setMany) has.

-}
fill : Int -> Int -> a -> (moved builder : Builder a) -> Builder a
fill from to value builder =
    let
        len =
            T.length builder

        lo =
            bound from len

        hi =
            bound to len
    in
    if lo < hi then
        T.fill builder lo (hi - lo) value

    else
        builder


{-| Copy the elements from the second index up to, but not including, the
third, to start at the first, as JavaScript's
[`copyWithin`](https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/copyWithin)
does: each index counts back from the end when negative and stops at the
ends, as many are copied as fit before the end, and where the two runs
overlap, the elements are read before they are written. The builder's length
does not change.

    fromArray [ 1, 2, 3, 4, 5 ]
        |> copyWithin 0 3 5
        |> toArray
        == [ 4, 5, 3, 4, 5 ]

    fromArray [ 1, 2, 3, 4, 5 ]
        |> copyWithin 1 0 4
        |> toArray
        == [ 1, 1, 2, 3, 4 ]

It costs O(m) for m elements copied, on the terms [`setMany`](#setMany) has.

-}
copyWithin : Int -> Int -> Int -> (moved builder : Builder a) -> Builder a
copyWithin at from to builder =
    let
        len =
            T.length builder

        target =
            bound at len

        start =
            bound from len

        count =
            min (bound to len - start) (len - target)
    in
    if count > 0 then
        T.copyWithin builder target start count

    else
        builder


{-| [`copyWithin`](#copyWithin), with the elements it copied from that it
did not also copy over set to the given value, so that each element moved is
in one place afterwards.

    fromArray [ 1, 2, 3, 4, 5 ]
        |> moveWithin 0 3 5 0
        |> toArray
        == [ 4, 5, 3, 0, 0 ]

    fromArray [ 1, 2, 3, 4, 5 ]
        |> moveWithin 1 0 4 0
        |> toArray
        == [ 0, 1, 2, 3, 4 ]

It costs a [`copyWithin`](#copyWithin) and a [`fill`](#fill) of what was
left.

-}
moveWithin : Int -> Int -> Int -> a -> (moved builder : Builder a) -> Builder a
moveWithin at from to vacated builder =
    let
        len =
            T.length builder

        target =
            bound at len

        start =
            bound from len

        count =
            min (bound to len - start) (len - target)
    in
    if count > 0 then
        let
            moved =
                T.copyWithin builder target start count
        in
        if start < target then
            T.fill moved start (min count (target - start)) vacated

        else if target < start then
            let
                lo =
                    max start (target + count)
            in
            T.fill moved lo (start + count - lo) vacated

        else
            moved

    else
        builder


{-| An index as [`Array.slice`](Array#slice) takes one: a negative one counts
back from the end, and one past either end stops there.
-}
bound : Int -> (len : Nat) -> (r : Int where 0 <= r && r <= len)
bound index len =
    if index < 0 then
        let
            fromEnd =
                len + index
        in
        if fromEnd < 0 then
            0

        else
            fromEnd

    else if len < index then
        len

    else
        index


{-| The element at the given index, or `Nothing` if the index is out of
bounds. A negative index counts back from the end, as in
[`Array.get`](Array#get).

It costs O(1) on JavaScript and natively on the builder the call before
answered, and on an older one at most 32 steps, or a copy once, O(n) (see
Costs); O(log n) on the BEAM.

-}
get : Int -> Builder a -> Maybe a
get index builder =
    let
        at =
            actualIndex index builder
    in
    if at < 0 then
        Nothing

    else
        Just (T.get builder at)


{-| The number of elements in a [Builder](#Builder).

It costs O(1).

-}
length : Builder a -> Int
length builder =
    T.length builder


{-| The index a negative one counts back to, or -1 when it is outside the
builder: an `Int` and not a `Maybe`, so that its refinement can say where it
is (geng-lang `m4-refine.md` §RF27).
-}
actualIndex : Int -> (builder : Builder a) -> (r : Int where r == -1 || (0 <= r && r < T.length builder))
actualIndex index builder =
    let
        len =
            T.length builder

        actual =
            if index < 0 then
                len + index

            else
                index
    in
    if actual < 0 || actual >= len then
        -1

    else
        actual


{-| A fresh array of the elements from the first index up to, but not
including, the second, which count back from the end when negative and stop
at the ends, as [`Array.slice`](Array#slice)'s do. The builder is left as it
was.

    fromArray [ 1, 2, 3, 4, 5 ]
        |> slice 1 -1
        == [ 2, 3, 4 ]

Where [`toArray`](#toArray) hands over the builder's buffer, `slice` copies,
so it is how an array is read out of a builder that stays where it is, such as
a row of a builder of rows.

It costs O(m) for m elements copied on JavaScript and natively, and O(m log n)
on the BEAM.

-}
slice : Int -> Int -> Builder a -> Array a
slice from to builder =
    let
        len =
            T.length builder

        lo =
            bound from len

        hi =
            bound to len
    in
    if lo < hi then
        toArray (copyRange builder lo hi (T.new (hi - lo)))

    else
        []


{-| A second builder with the same elements and a buffer of its own, so that
the two are written apart. The builder is left as it was.

    let
        start =
            fromArray [ 1, 2 ]
    in
    { a = toArray (pushLast 3 (copy start)), b = toArray (pushLast 4 start) }
        == { a = [ 1, 2, 3 ], b = [ 1, 2, 4 ] }

It costs O(n) on JavaScript and natively, and O(n log n) on the BEAM.

-}
copy : Builder a -> Builder a
copy builder =
    let
        len =
            T.length builder
    in
    copyRange builder 0 len (T.new len)


{-| The elements of a builder from `i` up to, but not including, `to`, pushed
onto another. -}
copyRange : (b : Builder a) -> (i : Int where 0 <= i) -> (to : Int where to <= T.length b) -> (moved acc : Builder a) -> Builder a
copyRange b i to acc =
    if i < to then
        copyRange b (i + 1) to (T.push acc (T.get b i))

    else
        acc


{-| Converts a [Builder](#Builder) to an `Array`.

It costs O(1) on JavaScript and natively on the builder the call before
answered, handing over the builder's buffer, after which a write to that
builder, or a second `toArray` of it, copies, O(n); O(n) on an older builder;
and O(n) on the BEAM, where it builds a tuple; so a loop that calls `toArray` at every step is
quadratic on every target, and should read the builder with [`get`](#get) and
[`length`](#length) instead.

-}
@prim("tr_to_array")
toArray : (moved builder : Builder a) -> Array a
