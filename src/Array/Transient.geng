module Array.Transient exposing
    ( Transient
    , new
    , push
    , set
    , get
    , length
    , fill
    , copyWithin
    , generate
    )

{-| The array transient every loop in `Array` builds into and which
`Array.Builder` is an alias for, and which `core` does not expose
(`m1b-arr-prim.md` D240, after D233's `Bytes.Transient` and D221's
`Json.Value`).

A transient is used linearly: each `tr_` primitive answers the transient it was
given, and nothing reads one after passing it on. A non-linear use is still
correct, and nothing checks for one: a write in place keeps what it overwrote
in the transient it was given, so an older transient reads what it held through
those records, and a write to an older transient copies first (geng-lang
`m4-visiterm.md` D903). It costs a walk of the records, or a copy.

`fill`, `copyWithin` and `generate` are D904's and D905's (geng-lang
`m4-visiterm.md` §VA11): one call and one transient where a loop of `push` or
`set` was a transient an element. A write in place of a run keeps the run it
replaced, so an older transient still reads what it held.

`tr_from_array`, `tr_to_array` and `tr_set_array` are not here, because they mention `Array`,
which imports this module. `Array` and `Array.Builder` each declare them where
they use them (§BY12.2).

-}

import Basics exposing (Int, (&&), (||), (+), (-), (<), (<=), (==))


{-| Written in place, so a value of it is used at most once (geng-lang
`m4-own.md` D921, D922): `Array.Builder.Builder` is this type.
-}
@affine
type Transient a
    = Transient


@prim("tr_new")
new : Int -> (r : Transient a where Array.Transient.length r == 0)


@prim("tr_push")
push : (moved t : Transient a) -> a -> (r : Transient a where Array.Transient.length r == Array.Transient.length t + 1)


@prim("tr_set")
set : (moved t : Transient a) -> (i : Int where 0 <= i && i < Array.Transient.length t) -> a -> (r : Transient a where Array.Transient.length r == Array.Transient.length t)


@prim("tr_get")
get : (t : Transient a) -> (i : Int where 0 <= i && i < Array.Transient.length t) -> a


@prim("tr_length")
length : Transient a -> Int


{-| `v` at `i` to `i + n - 1`. Past the end it lengthens the transient, as
`push` does, so `fill (new n) 0 n v` is `n` copies of `v`.
-}
@prim("tr_fill")
fill : (moved t : Transient a) -> (i : Int where 0 <= i && i <= Array.Transient.length t) -> (n : Int where 0 <= n) -> a -> (r : Transient a where (i + n <= Array.Transient.length t && Array.Transient.length r == Array.Transient.length t) || (Array.Transient.length t < i + n && Array.Transient.length r == i + n))


{-| The `n` elements from `from` copied to `to`, read before they are written
where the two runs overlap, as JavaScript's `copyWithin` does.
-}
@prim("tr_copy_within")
copyWithin : (moved t : Transient a) -> (to : Int where 0 <= to) -> (from : Int where 0 <= from) -> (n : Int where 0 <= n && to <= Array.Transient.length t - n && from <= Array.Transient.length t - n) -> (r : Transient a where Array.Transient.length r == Array.Transient.length t)


{-| `f first` to `f (first + n - 1)` pushed, in that order, the sum wrapping as
`Int` does.
-}
@prim("tr_generate")
generate : (moved t : Transient a) -> Int -> (n : Int where 0 <= n) -> (Int -> a) -> (r : Transient a where Array.Transient.length r == Array.Transient.length t + n)
