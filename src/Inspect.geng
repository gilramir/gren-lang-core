module Inspect exposing
    ( Inspect
    , ctor, record, arg
    , Proxy, none
    )

{-| Turning a value into a string a person can read.

`inspect` is `Debug.toString`'s replacement (D16) and differs from it in the
two ways that matter: it is available in packages and in optimized builds, and
its format is **written down** — `docs/representation.md` R5 pins it, so that
`DESIGN.md` §8's differential harness can compare it byte-for-byte across
backends. The format is unstable across Gren versions and pinned within one.

@docs Inspect


## Writing an instance

An abstract type whose structure is private supplies its own instance rather
than deriving one (`classes.md` §2.5), and these three are how it produces
R5's shapes without restating them.

@docs ctor, record, arg


## Numbers with a width

A number of a type other than `Int` and `Float` is written as the annotation
that would type it, `(42 : Int64)`, and an array of them is annotated once,
`([1, 2] : Array UInt8)` (D360). An instance for a type with no width answers
`none` from `inspectAnnotation`, and an array of it is written as its elements
are.

@docs Proxy, none

-}

import Array exposing (Array)
import Basics exposing (..)
import Bitwise
import Char exposing (Char)
import Int16
import Int8
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String exposing (String)
import UInt16
import UInt8
import Unicode.Lookup


{-| Types that can be rendered as a string.

Every transparent type derives this without asking, the way it derives `Eq` and
`Ord` (`classes.md` §2.1). A **function** derives nothing, so `inspect` on one
is a compile error rather than the `<function>` stock Gren prints.

-}
class Inspect a where
    inspect : a -> String
    inspectAnnotation : Proxy a -> Maybe String


{-| A type, with no value: what `inspectAnnotation` is asked about.

The annotation an array gets is a fact about its element *type*, so it has to
be answerable with no element to ask. `[[], [1, 2]]` at `Array (Array UInt8)`
is annotated once, and its first element is an array with nothing in it.

-}
type Proxy a
    = Proxy


{-| What `inspectAnnotation` answers for a type with no width: every type but
the eight sized numeric types and an array of one.
-}
none : Maybe String
none =
    Nothing


proxyOf : a -> Proxy a
proxyOf _ =
    Proxy


element : Proxy (Array a) -> Proxy a
element _ =
    Proxy


{-| `(42 : Int64)`: a number and the type that would make it one. -}
annotated : String -> String -> String
annotated tipe digits =
    "(" ++ digits ++ " : " ++ tipe ++ ")"


{-| What `annotated` wrapped, given the type it wrapped it with: an element of
an annotated array, written bare because the array's annotation already types
it. A rendering that is not wrapped, `nan` or an empty array's `[]`, is
returned as it is.

This undoes the element's own `inspect` rather than asking the class for a
bare rendering, because a record's witness is built inline at every use
(§G38): a second method that renders the fields would carry each field's
witness twice, and a record nested n deep would carry 2^n copies.

-}
unannotated : Maybe String -> String -> String
unannotated tipe rendered =
    when tipe is
        Just t ->
            let
                suffix =
                    " : " ++ t ++ ")"
            in
            if String.startsWith "(" rendered && String.endsWith suffix rendered then
                rendered
                    |> String.dropFirst 1
                    |> String.dropLast (String.count suffix)

            else
                rendered

        Nothing ->
            rendered


brackets : (a -> String) -> Array a -> String
brackets render xs =
    "[" ++ String.join ", " (Array.map render xs) ++ "]"



-- THE THREE SHAPES A DERIVED INSTANCE PRODUCES
--
-- The generator decides *which* components to render and this module decides
-- what the rendering looks like, so R5 is one file rather than a rule spread
-- between `Canonicalize.Derive` and here. A hand-written instance uses the
-- same three and comes out looking like a derived one.


{-| A constructor and its rendered arguments: `ctor "Just" [ arg (inspect x) ]`.

    ctor "Nothing" [] == "Nothing"

    ctor "Just" [ "1" ] == "Just 1"

-}
ctor : String -> Array String -> String
ctor name args =
    if Array.length args == 0 then
        name

    else
        name ++ " " ++ String.join " " args


{-| A record's fields, which R5 orders **alphabetically by name** for §2.2's
reason: a Gren record is structural, so declaration order is not a property of
its type.

    record [ { name = "x", value = "1" } ] == "{ x = 1 }"

-}
record : Array { name : String, value : String } -> String
record fields =
    if Array.length fields == 0 then
        "{}"

    else
        "{ "
            ++ String.join ", " (Array.map (\entry -> entry.name ++ " = " ++ entry.value) fields)
            ++ " }"


{-| One rendered value, ready to be a constructor's argument: parenthesized if
it is itself a constructor applied to something.

    arg "1" == "1"

    arg "Just 1" == "(Just 1)"

    arg "[1, 2]" == "[1, 2]"

R5 says a nested constructor is parenthesized — `Just (Just 1)` — and
`inspect : a -> String` gives an instance no way to be told it is in an
argument position. So the decision is made from the rendered string, which is
exact rather than approximate: R5's grammar is closed, and a **top-level
space** appears in exactly one of its shapes. A record's spaces are inside its
braces, an array's inside its brackets, and a string's or character's inside
its quotes, so tracking those three is the whole test.

-}
arg : String -> String
arg rendered =
    if hasTopLevelSpace 0 Nothing (String.toArray rendered) then
        "(" ++ rendered ++ ")"

    else
        rendered


hasTopLevelSpace : Int -> Maybe Char -> Array Char -> Bool
hasTopLevelSpace depth quote chars =
    when Array.popFirst chars is
        Nothing ->
            False

        Just { first = c, rest } ->
            when quote is
                Just quoteChar ->
                    if c == '\\' then
                        hasTopLevelSpace depth quote (Array.dropFirst 1 rest)

                    else if c == quoteChar then
                        hasTopLevelSpace depth Nothing rest

                    else
                        hasTopLevelSpace depth quote rest

                Nothing ->
                    if c == '"' || c == '\'' then
                        hasTopLevelSpace depth (Just c) rest

                    else if c == '[' || c == '{' || c == '(' then
                        hasTopLevelSpace (depth + 1) Nothing rest

                    else if c == ']' || c == '}' || c == ')' then
                        hasTopLevelSpace (depth - 1) Nothing rest

                    else if c == ' ' && depth == 0 then
                        True

                    else
                        hasTopLevelSpace depth Nothing rest



-- THE PRIMITIVES
--
-- R5's scalar table, one instance per row. `Int` and `Float` print bare, and
-- the sized numeric types print as the annotation that would type them (D360).
-- Inside an annotated array the annotation is taken off again ('unannotated'),
-- which leaves the digits.


instance Inspect Int where
    inspect n =
        String.fromInt n

    inspectAnnotation _ =
        Nothing


{-| R5 as D360 amends it: `(42 : Int64)`, sign inside, which is the annotation
that would type the literal, so `inspect` at any of the sized widths produces
source that reads back as the same value at the same width.
-}
instance Inspect Int64 where
    inspect n =
        annotated "Int64" (String.fromInt64 n)

    inspectAnnotation _ =
        Just "Int64"


instance Inspect UInt32 where
    inspect n =
        annotated "UInt32" (String.fromUInt32 n)

    inspectAnnotation _ =
        Just "UInt32"


instance Inspect UInt64 where
    inspect n =
        annotated "UInt64" (String.fromUInt64 n)

    inspectAnnotation _ =
        Just "UInt64"


-- D342's four, through `Int`: every narrow value is one.


instance Inspect Int8 where
    inspect n =
        annotated "Int8" (String.fromInt (Int8.toInt n))

    inspectAnnotation _ =
        Just "Int8"


instance Inspect UInt8 where
    inspect n =
        annotated "UInt8" (String.fromInt (UInt8.toInt n))

    inspectAnnotation _ =
        Just "UInt8"


instance Inspect Int16 where
    inspect n =
        annotated "Int16" (String.fromInt (Int16.toInt n))

    inspectAnnotation _ =
        Just "Int16"


instance Inspect UInt16 where
    inspect n =
        annotated "UInt16" (String.fromInt (UInt16.toInt n))

    inspectAnnotation _ =
        Just "UInt16"


{-| R5: bare, always a decimal point, and `nan` / `infinity` / `-infinity` for
the three A1 says exist on every backend. `-0.0` renders with its sign even
though A2 makes it compare equal to `0.0`.

`String.fromFloat` lays out R5's finite form — shortest round-trip digits,
always a decimal point, `1.0e21` past the thresholds — so what is left here is
the four values the two functions render **differently**, which R5 says they do
on purpose: `fromFloat` writes what `String.toFloat` can read and this writes
what R5 pins.

-}
instance Inspect Float where
    inspect f =
        if isNaN f then
            "nan"

        else if isInfinite f then
            if f < 0.0 then
                "-infinity"

            else
                "infinity"

        else if isNegativeZero f then
            "-0.0"

        else
            String.fromFloat f

    inspectAnnotation _ =
        Nothing


{-| R5 as D360 amends it: `(1.5 : Float32)`, over digits that are the shortest
to round-trip **as a single** -- `String.fromFloat32`'s, which is Ryu at 24
bits of mantissa (`docs/m1b-ryu.md` §Y14). Through the double's digits
`inspect (0.1 : Float32)` would be `(0.10000000149011612 : Float32)`: a true
statement about the value and the wrong string, pinned into a corpus case.

**The three non-finite spellings are not annotated** (D156, which D360 keeps).
`nan`, `infinity` and `-infinity` are what R5 pins at both widths, because an
annotation is a literal's type and these are not literals at any width -- A1
gives every backend the same three values and no way to write one down.
`(-0.0 : Float32)` is annotated, because it is a literal and because that is
the value the annotation matters most for: a narrow zero and a wide one look
alike everywhere else.

-}
instance Inspect Float32 where
    inspect f =
        if isNaN f || isInfinite f then
            float32Digits f

        else
            annotated "Float32" (float32Digits f)

    inspectAnnotation _ =
        Just "Float32"


float32Digits : Float32 -> String
float32Digits f =
    if isNaN f then
            "nan"

        else if isInfinite f then
            if f < 0 then
                "-infinity"

            else
                "infinity"

        else if isNegativeZero32 f then
            "-0.0"

        else
            String.fromFloat32 f


{-| `1.0 / f` is the only thing that tells the two zeros apart, and it has to be
asked for the **sign** of the infinity rather than for its presence: `1.0 / 0.0`
is `infinity` and `1.0 / -0.0` is `-infinity`, so `isInfinite` alone answers
`True` for both. It did, from §G43 until §Y6, and `inspect 0.0` was `-0.0` for
as long — `corpus/accept/inspect-format` had the negative row and not the
positive one, so nothing asked.
-}
isNegativeZero : Float -> Bool
isNegativeZero f =
    f == 0.0 && 1.0 / f < 0.0


{-| The same question at the other width.

Written twice rather than once over a constraint, and the constrained version
was tried: `(Fractional a, Num a, Ord a, Eq a) => a -> Bool` compiles and
answers correctly at both widths -- D149's hole does not reach it, because the
literals here are written with a point and it is an *integer* literal under a
type variable that lowers wrong. What it costs is four witnesses passed into a
two-operation function on every `inspect` of a float, where these two are a
comparison and a divide with nothing in front of them.

-}
isNegativeZero32 : Float32 -> Bool
isNegativeZero32 f =
    f == 0.0 && 1.0 / f < 0.0


instance Inspect Bool where
    inspect b =
        if b then
            "True"

        else
            "False"

    inspectAnnotation _ =
        Nothing


instance Inspect Char where
    inspect c =
        "'" ++ escape '\'' c ++ "'"

    inspectAnnotation _ =
        Nothing


instance Inspect String where
    inspect s =
        "\"" ++ String.join "" (Array.map (\c -> escape '"' c) (String.toArray s)) ++ "\""

    inspectAnnotation _ =
        Nothing


{-| One character, escaped for whichever quote encloses it.

R5: `\\`, `\"`, `\n`, `\r`, `\t`, and any other non-printable as `\u{XXXX}`
with uppercase hex and no leading zeros. A quote is escaped only when it is the
one doing the enclosing, so `'"'` and `"'"` stay readable.

**Non-printable is `docs/unicode.md` U2's definition**, read out of the table
at the version [`Unicode.version`](Unicode#version) names: general category
`Cc`, `Cf`, `Cs`, `Co` or `Cn`, or `Zl`, `Zp` or a `Zs` that is not the space
itself. That is a wider set than the C0 controls this used to test for, and
`Cn` is why an *unassigned* codepoint escapes — a program's output therefore
moves when the pin moves, which is what U3 makes a minor version of the
language (`docs/m1b-str.md` §T18).

-}
escape : Char -> Char -> String
escape quote c =
    if c == '\\' then
        "\\\\"

    else if c == quote then
        "\\" ++ String.fromChar c

    else if c == '\n' then
        "\\n"

    else if c == '\r' then
        "\\r"

    else if c == '\t' then
        "\\t"

    else if Unicode.Lookup.isNonPrintable c then
        "\\u{" ++ hex (Char.toCode c) ++ "}"

    else
        String.fromChar c


hex : Int -> String
hex n =
    if n < 16 then
        hexDigit n

    else
        hex (Bitwise.shiftRightZfBy 4 n) ++ hexDigit (Bitwise.and n 0xF)


-- A digit read out of the sixteen rather than computed from `'0'` and `'A'`,
-- which is what this was until `Char.fromCode` became `Int -> Maybe Char` (C8,
-- `m1b-str.md` §T12). The arithmetic cannot fail and the `Maybe` it now returns
-- would have to be discarded with a default character standing in for a digit,
-- which is a worse thing to write down than an index into a string of the
-- digits themselves.


hexDigit : Int -> String
hexDigit n =
    String.slice n (n + 1) "0123456789ABCDEF"



-- THE TYPES BELOW THIS MODULE IN THE IMPORT GRAPH
--
-- `Inspect` names `String`, so everything `String` imports is beneath it and
-- cannot import back to derive: `Basics`, `Array`, `Maybe` and `Result` are
-- all in that set. Their instances are written here, which D11 allows because
-- this is the class's own module. Every core module *above* this one derives
-- in the ordinary way once it imports `Inspect`.


instance Inspect Order where
    inspect order =
        when order is
            LT ->
                "LT"

            EQ ->
                "EQ"

            GT ->
                "GT"

    inspectAnnotation _ =
        Nothing


instance Inspect a => Inspect (Maybe a) where
    inspect m =
        when m is
            Just value ->
                ctor "Just" [ arg (inspect value) ]

            Nothing ->
                "Nothing"

    inspectAnnotation _ =
        Nothing


instance (Inspect error, Inspect value) => Inspect (Result error value) where
    inspect r =
        when r is
            Ok value ->
                ctor "Ok" [ arg (inspect value) ]

            Err error ->
                ctor "Err" [ arg (inspect error) ]

    inspectAnnotation _ =
        Nothing


{-| R5: `[1, 2, 3]` and `[]`. An element is **not** parenthesized, because a
bracket already delimits it.

D360: an array whose element type has a width is annotated once, at the
outermost array whose type has one, and everything inside it is bare --
`([[], [1, 2]] : Array (Array UInt8))`. The width is read from the element
**type** through `Proxy`, so an empty inner array is no obstacle. An empty
array on its own is `[]`, annotated or not: there is no number in it to
misread.

-}
instance Inspect a => Inspect (Array a) where
    inspect xs =
        if Array.isEmpty xs then
            "[]"

        else
            when inspectAnnotation (proxyOf xs) is
                Just tipe ->
                    let
                        inner =
                            inspectAnnotation (element (proxyOf xs))
                    in
                    annotated tipe (brackets (\x -> unannotated inner (inspect x)) xs)

                Nothing ->
                    brackets (\x -> inspect x) xs

    inspectAnnotation proxy =
        when inspectAnnotation (element proxy) is
            Just tipe ->
                Just ("Array " ++ arg tipe)

            Nothing ->
                Nothing
