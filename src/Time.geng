{-| Functions for working with time and time zones.

@docs Posix, now, posixToMillis, millisToPosix

## Timers
@docs Timer, every, cancel

## Durations

A `Duration` is a length of time, as a `Posix` is a point in one. Adding a
timeout to a timestamp used to be bare arithmetic on milliseconds that nothing
checked; `docs/int64-migration.md` M3 added this because D2's widening was the
one moment a breaking change to `Time` was free.

@docs Duration, milliseconds, seconds, minutes, hours, days
@docs inMilliseconds, inSeconds, inMinutes, inHours, inDays
@docs add, diff

## Time Zones
@docs Zone, utc, here

## Human Times
@docs toYear, toMonth, toDay, toWeekday, toHour, toMinute, toSecond, toMillis

## Weeks and Months
@docs Weekday, Month

## For Package Authors
@docs customZone, getZoneName, ZoneName

-}


import Array exposing (Array)
import Basics exposing (..)
import Inspect exposing (Inspect)
import Int64
import Math
import Maybe exposing (Maybe(..))
import Extern exposing (Handle)
import Source exposing (Source)
import String exposing (String)
import Task exposing (Task)



-- POSIX


{-| A computer representation of time. It is the same all over Earth, so if we
have a phone call or meeting at a certain POSIX time, there is no ambiguity.

It is very hard for humans to _read_ a POSIX time though, so we use functions
like [`toHour`](#toHour) and [`toMinute`](#toMinute) to `view` them.
-}
@derive(Eq, Ord, Inspect)
type Posix = Posix Int64


{-| Get the POSIX time at the moment when this task is run.
-}
now : Task x Posix
now =
  nowWith millisToPosix


@extern(js, "Time", "now")
@extern(erlang, "geng_core_time", "now")
nowWith : (Int64 -> posix) -> Task x posix


{-| Turn a `Posix` time into the number of milliseconds since 1970 January 1
at 00:00:00 UTC. It was a Thursday.
-}
posixToMillis : Posix -> Int64
posixToMillis (Posix millis) =
  millis


{-| Turn milliseconds into a `Posix` time.
-}
millisToPosix : Int64 -> Posix
millisToPosix =
  Posix



-- DURATIONS


{-| A length of time, in milliseconds.

`Posix` is a point in time and this is a distance between two of them, which is
the distinction bare millisecond arithmetic could not make. Build one with
[seconds](#seconds) and its neighbours, take one apart with
[inSeconds](#inSeconds) and its, and move a `Posix` with [add](#add).

    Time.add (Time.minutes 5) deadline
-}
@derive(Eq, Ord, Inspect)
type Duration = Duration Int64


{-| A duration of some number of milliseconds.
-}
milliseconds : Int64 -> Duration
milliseconds =
  Duration


{-| A duration of some number of seconds.
-}
seconds : Int64 -> Duration
seconds n =
  Duration (n * 1000)


{-| A duration of some number of minutes.
-}
minutes : Int64 -> Duration
minutes n =
  Duration (n * 60000)


{-| A duration of some number of hours.
-}
hours : Int64 -> Duration
hours n =
  Duration (n * 3600000)


{-| A duration of some number of days.

A day here is exactly 24 hours. Calendar days are not all 24 hours long, and
turning one of those into a duration needs a `Zone`.
-}
days : Int64 -> Duration
days n =
  Duration (n * 86400000)


{-| How many milliseconds a duration is. Exact: this is what one holds.
-}
inMilliseconds : Duration -> Int64
inMilliseconds (Duration millis) =
  millis


{-| How many whole seconds a duration is.

Every accessor but [inMilliseconds](#inMilliseconds) **truncates toward zero**,
which is `//`'s rule (A11): 1500 milliseconds is 1 second and -1500 is -1.
-}
inSeconds : Duration -> Int64
inSeconds (Duration millis) =
  millis // 1000


{-| How many whole minutes a duration is, truncating toward zero.
-}
inMinutes : Duration -> Int64
inMinutes (Duration millis) =
  millis // 60000


{-| How many whole hours a duration is, truncating toward zero.
-}
inHours : Duration -> Int64
inHours (Duration millis) =
  millis // 3600000


{-| How many whole 24-hour days a duration is, truncating toward zero.
-}
inDays : Duration -> Int64
inDays (Duration millis) =
  millis // 86400000


{-| Move a point in time by a duration.

    Time.add (Time.hours 1) noon

A6 makes the addition wrap at 64 bits rather than saturate, the way every other
integer operation does. `Int64` milliseconds spans 292 million years either way,
so reaching the wrap is not a thing a program does by accident.
-}
add : Duration -> Posix -> Posix
add (Duration millis) (Posix time) =
  Posix (time + millis)


{-| The duration **from** the first time **to** the second, so that
`add (diff a b) a == b`.

It is negative when the second time is the earlier one.
-}
diff : Posix -> Posix -> Duration
diff (Posix from) (Posix to) =
  Duration (to - from)



-- TIME ZONES


{-| Information about a particular time zone.

The [IANA Time Zone Database][iana] tracks things like UTC offsets and
daylight-saving rules so that you can turn a `Posix` time into local times
within a time zone.

See [`utc`](#utc) and [`here`](#here) to learn how to obtain `Zone` values.

[iana]: https://www.iana.org/time-zones
-}
@derive(Eq, Inspect)
type Zone =
  Zone { offset : Int, eras : (Array Era) }


-- TODO: add this note back to `Zone` docs when it is true
--
-- Did you know that in California the times change from 3pm PST to 3pm PDT to
-- capture whether it is daylight-saving time? The database tracks those
-- abbreviation changes too. (Tons of time zones do that actually.)
--


{-| Currently the public API only needs:

- `start` is the beginning of this `Era` in "minutes since the Unix Epoch"
- `offset` is the UTC offset of this `Era` in minutes

But eventually, it will make sense to have `abbr : String` for `PST` vs `PDT`
-}
type alias Era =
  { start : Int
  , offset : Int
  }


{-| The time zone for Coordinated Universal Time ([UTC][])

The `utc` zone has no time adjustments. It never observes daylight-saving
time and it never shifts around based on political restructuring.

[UTC]: https://en.wikipedia.org/wiki/Coordinated_Universal_Time
-}
utc : Zone
utc =
  Zone { offset = 0, eras = [] }


{-| Produce a `Zone` based on the current UTC offset. You can use this to figure
out what day it is where you are:

    import Task exposing (Task)
    import Time

    whatDayIsIt : Task x Int
    whatDayIsIt =
      Task.map2 Time.toDay Time.here Time.now

**Accuracy Note:** This function can only give time zones like `Etc/GMT+9` or
`Etc/GMT-6`. It cannot give you `Europe/Stockholm`, `Asia/Tokyo`, or any other
normal time zone from the [full list][tz] due to limitations in JavaScript.
For example, if you run `here` in New York City, the resulting `Zone` will
never be `America/New_York`. Instead you get `Etc/GMT-5` or `Etc/GMT-4`
depending on Daylight Saving Time. So even though browsers must have internal
access to `America/New_York` to figure out that offset, there is no public API
to get the full information. This means the `Zone` you get from this function
will act weird if (1) an application stays open across a Daylight Saving Time
boundary or (2) you try to use it on historical data.

**Future Note:** We can improve `here` when there is good browser support for
JavaScript functions that (1) expose the IANA time zone database and (2) let
you ask the time zone of the computer. The committee that reviews additions to
JavaScript is called TC39, and I encourage you to push for these capabilities! I
cannot do it myself unfortunately.

**Alternatives:** See the `customZone` docs to learn how to implement stopgaps.

[tz]: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
-}
here : Task x Zone
here =
  hereWith (\offset -> customZone offset [])


@extern(js, "Time", "here")
@extern(erlang, "geng_core_time", "here")
hereWith : (Int -> zone) -> Task x zone



-- DATES


{-| What year is it?!

    import Time exposing (toYear, utc, millisToPosix)

    toYear utc (millisToPosix 0) == 1970
    toYear nyc (millisToPosix 0) == 1969

    -- pretend `nyc` is the `Zone` for America/New_York.
-}
toYear : Zone -> Posix -> Int
toYear zone time =
  (toCivil (toAdjustedMinutes zone time)).year


{-| What month is it?!

    import Time exposing (toMonth, utc, millisToPosix)

    toMonth utc (millisToPosix 0) == Jan
    toMonth nyc (millisToPosix 0) == Dec

    -- pretend `nyc` is the `Zone` for America/New_York.
-}
toMonth : Zone -> Posix -> Month
toMonth zone time =
  when (toCivil (toAdjustedMinutes zone time)).month is
    1  -> Jan
    2  -> Feb
    3  -> Mar
    4  -> Apr
    5  -> May
    6  -> Jun
    7  -> Jul
    8  -> Aug
    9  -> Sep
    10 -> Oct
    11 -> Nov
    _  -> Dec


{-| What day is it?! (Days go from 1 to 31)

    import Time exposing (toDay, utc, millisToPosix)

    toDay utc (millisToPosix 0) == 1
    toDay nyc (millisToPosix 0) == 31

    -- pretend `nyc` is the `Zone` for America/New_York.

-}
toDay : Zone -> Posix -> Int
toDay zone time =
  (toCivil (toAdjustedMinutes zone time)).day


{-| What day of the week is it?

    import Time exposing (toWeekday, utc, millisToPosix)

    toWeekday utc (millisToPosix 0) == Thu
    toWeekday nyc (millisToPosix 0) == Wed

    -- pretend `nyc` is the `Zone` for America/New_York.
-}
toWeekday : Zone -> Posix -> Weekday
toWeekday zone time =
  when modBy 7 (flooredDiv (toAdjustedMinutes zone time) (60 * 24)) is
    0 -> Thu
    1 -> Fri
    2 -> Sat
    3 -> Sun
    4 -> Mon
    5 -> Tue
    _ -> Wed


{-| What hour is it? (From 0 to 23)

    import Time exposing (toHour, utc, millisToPosix)

    toHour utc (millisToPosix 0) == 0  -- 12am
    toHour nyc (millisToPosix 0) == 19 -- 7pm

    -- pretend `nyc` is the `Zone` for America/New_York.
-}
toHour : Zone -> Posix -> Int
toHour zone time =
  modBy 24 (flooredDiv (toAdjustedMinutes zone time) 60)


{-| What minute is it? (From 0 to 59)

    import Time exposing (toMinute, utc, millisToPosix)

    toMinute utc (millisToPosix 0) == 0

This can be different in different time zones. Some time zones are offset
by 30 or 45 minutes!
-}
toMinute : Zone -> Posix -> Int
toMinute zone time =
  modBy 60 (toAdjustedMinutes zone time)


{-| What second is it?

    import Time exposing (toSecond, utc, millisToPosix)

    toSecond utc (millisToPosix    0) == 0
    toSecond utc (millisToPosix 1234) == 1
    toSecond utc (millisToPosix 5678) == 5
-}
toSecond : Zone -> Posix -> Int
toSecond _ time =
  -- The `modBy` happens at `Int64` and the narrowing after it. Dividing first
  -- and narrowing the quotient would put seconds-since-1970 through an `Int`,
  -- which stops working in 2038 -- the bug D2 exists to end, reintroduced in
  -- the module that motivated D2.
  Int64.toInt (modBy 60 (divFloor 1000 (posixToMillis time)))


{-|
    import Time exposing (toMillis, utc, millisToPosix)

    toMillis utc (millisToPosix    0) == 0
    toMillis utc (millisToPosix 1234) == 234
    toMillis utc (millisToPosix 5678) == 678
-}
toMillis : Zone -> Posix -> Int
toMillis _ time =
  Int64.toInt (modBy 1000 (posixToMillis time))



-- DATE HELPERS


toAdjustedMinutes : Zone -> Posix -> Int
toAdjustedMinutes (Zone { offset = defaultOffset, eras }) time =
  toAdjustedMinutesHelp defaultOffset (minutesSinceEpoch time) eras


{-| Whole minutes since 1970, floored, as an `Int`.

`Int` and not `Int64` on purpose: the calendar arithmetic below it is all `Int`
and a `Zone`'s eras are minutes too. 2^31 minutes is 4083 years, so the width is
not the constraint here the way it was on milliseconds -- and `Int64.toInt`
saturates rather than wrapping, so a timestamp past the year 6053 clamps to the
end of time instead of landing in the Bronze Age.
-}
minutesSinceEpoch : Posix -> Int
minutesSinceEpoch time =
  Int64.toInt (divFloor 60000 (posixToMillis time))


toAdjustedMinutesHelp : Int -> Int -> Array Era -> Int
toAdjustedMinutesHelp defaultOffset posixMinutes eras =
  when Array.get 0 eras is
    Nothing ->
      posixMinutes + defaultOffset

    Just era ->
      if era.start < posixMinutes then
        posixMinutes + era.offset
      else
        toAdjustedMinutesHelp defaultOffset posixMinutes (Array.slice 1 (Array.length eras) eras)


toCivil : Int -> { year : Int, month : Int, day : Int }
toCivil minutesSince1970 =
  let
    rawDay    = flooredDiv minutesSince1970 (60 * 24) + 719468
    era       = (if rawDay >= 0 then rawDay else rawDay - 146096) // 146097
    dayOfEra  = rawDay - era * 146097 -- [0, 146096]
    yearOfEra = (dayOfEra - dayOfEra // 1460 + dayOfEra // 36524 - dayOfEra // 146096) // 365 -- [0, 399]
    year      = yearOfEra + era * 400
    dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra // 4 - yearOfEra // 100) -- [0, 365]
    mp        = (5 * dayOfYear + 2) // 153 -- [0, 11]
    month     = mp + (if mp < 10 then 3 else -9) -- [1, 12]
  in
  { year = year + (if month <= 2 then 1 else 0)
  , month = month
  , day = dayOfYear - (153 * mp + 2) // 5 + 1 -- [1, 31]
  }


flooredDiv : Int -> Float -> Int
flooredDiv numerator denominator =
  Math.floor (toFloat numerator / denominator)



-- WEEKDAYS AND MONTHS


{-| Represents a `Weekday` so that you can convert it to a `String` or `Int`
however you please. For example, if you need the Japanese representation, you
can say:

    toJapaneseWeekday : Weekday -> String
    toJapaneseWeekday weekday =
      when weekday is
        Mon -> "月"
        Tue -> "火"
        Wed -> "水"
        Thu -> "木"
        Fri -> "金"
        Sat -> "土"
        Sun -> "日"
-}
type Weekday = Mon | Tue | Wed | Thu | Fri | Sat | Sun


{-| Represents a `Month` so that you can convert it to a `String` or `Int`
however you please. For example, if you need the Danish representation, you
can say:

    toDanishMonth : Month -> String
    toDanishMonth month =
      when month is
        Jan -> "januar"
        Feb -> "februar"
        Mar -> "marts"
        Apr -> "april"
        May -> "maj"
        Jun -> "juni"
        Jul -> "juli"
        Aug -> "august"
        Sep -> "september"
        Oct -> "oktober"
        Nov -> "november"
        Dec -> "december"
-}
type Month = Jan | Feb | Mar | Apr | May | Jun | Jul | Aug | Sep | Oct | Nov | Dec



-- TIMERS


{-| A running timer, which delivers until it is [cancelled](#cancel).
-}
type Timer
    = Timer Handle


{-| Get the current time periodically. How often though? Well, you provide an
interval in milliseconds (like `1000` for a second or `60 * 1000` for a minute
or `60 * 60 * 1000` for an hour) and that is how often a new time is delivered
into the [`Source`](Source#Source) you give, made a `msg` by the function you
give.

The source is yours: many timers may deliver into one, and closing it is yours
too. The timer runs until it is [cancelled](#cancel), or until its source
ends: a source lasts as long as the tree that made it (see
[`Source`](Source)), so on the BEAM a timer a `Beam.Server` keeps in its state
stops when the server does.

    Task.bracket Source.new Source.close <| \ticks ->
        Time.every 1000 ticks Tick
            |> Task.andThen (\_ -> loop ticks)

**This function is not for animation.** Use the [`onAnimationFrame`][af]
function for that sort of thing! It syncs up with repaints and will end up
being much smoother for any moving visuals.

[af]: /packages/gren-lang/browser/latest/Browser-Events#onAnimationFrame
-}
every : Float -> Source msg -> (Posix -> msg) -> Task x Timer
every interval ticks tagger =
  everyWith interval ticks (\millis -> tagger (Posix millis))
    |> Task.map Timer


{-| Stop a timer delivering. Cancelling one twice is not an error.
-}
cancel : Timer -> Task x {}
cancel (Timer handle) =
  cancelWith handle


@extern(js, "Time", "every")
@extern(erlang, "geng_core_time", "every")
everyWith : Float -> Source msg -> (Int64 -> msg) -> Task x Handle


@extern(js, "Time", "cancel")
@extern(erlang, "geng_core_time", "cancel")
cancelWith : Handle -> Task x {}



-- FOR PACKAGE AUTHORS



{-| **Intended for package authors.**

The documentation of [`here`](#here) explains that it has certain accuracy
limitations that block on adding new APIs to JavaScript. The `customZone`
function is a stopgap that takes:

1. A default offset in minutes. So `Etc/GMT-5` is `customZone (-5 * 60) []`
and `Etc/GMT+9` is `customZone (9 * 60) []`.
2. An array of exceptions containing their `start` time in "minutes since the Unix
epoch" and their `offset` in "minutes from UTC"

Human times will be based on the nearest `start`, falling back on the default
offset if the time is older than all of the exceptions.

When paired with `getZoneName`, this allows you to load the real IANA time zone
database however you want: HTTP, cache, hardcode, etc.

**Note:** If you use this, please share your work in an Gren community forum!
I am sure others would like to hear about it, and more experience reports will
help me and the any potential TC39 proposal.
-}
customZone : Int -> Array { start : Int, offset : Int } -> Zone
customZone offset eras =
  Zone { offset = offset, eras = eras }


{-| **Intended for package authors.**

Use `Intl.DateTimeFormat().resolvedOptions().timeZone` to try to get names
like `Europe/Moscow` or `America/Havana`. From there you can look it up in any
IANA data you loaded yourself.
-}
getZoneName : Task x ZoneName
getZoneName =
  getZoneNameWith Name Offset


@extern(js, "Time", "getZoneName")
@extern(erlang, "geng_core_time", "getZoneName")
getZoneNameWith : (String -> name) -> (Int -> name) -> Task x name


{-| **Intended for package authors.**

The `getZoneName` function relies on a JavaScript API that is not supported
in all browsers yet, so it can return the following:

    -- in more recent browsers
    Name "Europe/Moscow"
    Name "America/Havana"

    -- in older browsers
    Offset 180
    Offset -300

So if the real info is not available, it will tell you the current UTC offset
in minutes, just like what `here` uses to make zones like `customZone -60 []`.
-}
type ZoneName
  = Name String
  | Offset Int
