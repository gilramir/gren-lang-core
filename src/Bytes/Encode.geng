module Bytes.Encode exposing
  ( encode
  , encodeChecked
  , Encoder
  , signedInt8, signedInt16, signedInt32
  , unsignedInt8, unsignedInt16, unsignedInt32
  , float32, float64
  , bytes
  , sequence
  )


{-| Functions for turning things into bytes.

## Costs

An `Encoder` describes the bytes to write and holds its width, so building one
costs only its own parts, and `encode` allocates the result once at its exact
length and writes each piece in order at O(1) a byte: into a zero-filled buffer
on JavaScript and natively, and on the BEAM by appending to a binary, which the
emulator grows in place. [`bytes`](#bytes) copies its argument only when the
encoder is encoded. So a `sequence` built up a piece at a time and encoded once
is the linear way to join bytes, where [`Bytes.flatten`](Bytes#flatten) onto an
accumulator copies the whole accumulator each time. Each cost is per call.

@docs Encoder, encode, encodeChecked, sequence

## Integers
@docs signedInt8, signedInt16, signedInt32, unsignedInt8, unsignedInt16, unsignedInt32

## Floats
@docs float32, float64

## Bytes
@docs bytes

-}


import Array exposing (Array)
import Basics exposing (..)
import Bytes.Transient exposing (Transient)
import Bytes exposing (Bytes, Endianness(..))
import Maybe exposing (Maybe(..))
import String exposing (String)



-- ENCODER


{-| Describes how to generate a sequence of bytes.

These encoders snap together with [`sequence`](#sequence) so you can start with
small building blocks and put them together into a more complex encoding.
-}
type Encoder
  = I8 Int
  | I16 (WithEndian Int)
  | I32 (WithEndian Int)
  | U8 Int
  | U16 (WithEndian Int)
  | U32 (WithEndian UInt32)
  | F32 (WithEndian Float)
  | F64 (WithEndian Float)
  | Seq { width : Int, items : Array Encoder }
  | Bytes Bytes


type alias WithEndian a =
  { endian : Endianness
  , number : a
  }


-- ENCODE


{-| Turn an `Encoder` into `Bytes`.

    encode (unsignedInt8     7) -- <07>
    encode (unsignedInt16 BE 7) -- <0007>
    encode (unsignedInt16 LE 7) -- <0700>

Bytes longer than 2^31 − 1, which no `Bytes` can be, end the program with a
message naming the limit, as running out of memory would;
[`encodeChecked`](#encodeChecked) answers `Nothing` instead (geng-lang
`m4-refine.md` §RF32, D863).

The `encode` function is designed to minimize allocation. It figures out the
exact length necessary to fit everything in `Bytes` and then generate that
value directly. This is valuable when you are encoding more elaborate data:

    import Bytes exposing (Endianness(..))
    import Bytes.Encode as Encode
    import UInt16

    type alias Person =
      { age : UInt16
      , name : String
      }

    toEncoder : Person -> Encode.Encoder
    toEncoder person =
      let
        name =
          Bytes.fromString person.name
      in
      Encode.sequence
        [ Encode.unsignedInt16 BE person.age
        , Encode.unsignedInt16 BE (UInt16.fromInt (Bytes.length name))
        , Encode.bytes name
        ]

    -- encode (toEncoder ({ age = 33, name = "Tom" })) == <00210003546F6D>

Did you know it was going to be seven bytes? How about when you have a hundred
people to serialize? And when some have Japanese and Norwegian names? Having
this intermediate `Encoder` can help reduce allocation quite a lot!

It costs O(n) for the n bytes it writes, plus O(1) for each encoder in it.

-}
encode : Encoder -> Bytes
encode encoder =
  primToBytes (write encoder (primNewOrCrash (getLength encoder)) 0)


{-| [`encode`](#encode), or `Nothing` where the bytes would be longer than
2^31 − 1.

    encodeChecked (unsignedInt8 7) -- Just <07>

-}
encodeChecked : Encoder -> Maybe Bytes
encodeChecked encoder =
  let
    width =
      getLength encoder
  in
  if width < 0 then
    Nothing

  else
    Just (primToBytes (write encoder (Bytes.Transient.new width) 0))



-- INTEGERS


{-| Encode an `Int8` in one byte.

The 8- and 16-bit encoders take the type of their width rather than an `Int`
(D342), because an `Int` has values they cannot write: until D348
`unsignedInt8 300` wrote `44` and said nothing, which is the defect
`unsignedInt32` had until 2026-09-13 at the two narrower widths. A number that
is already in an `Int` is `Int8.fromInt` away, which saturates, or
`Int8.fromIntWrap`, which keeps the low bits as this used to.

It costs O(1).

-}
signedInt8 : Int8 -> Encoder
signedInt8 n =
  I8 (i8ToI32 n)


{-| Encode an `Int16` in two bytes.

It costs O(1).

-}
signedInt16 : Endianness -> Int16 -> Encoder
signedInt16 e n =
  I16 { endian = e, number = i16ToI32 n }


{-| Encode integers from `-2147483648` to `2147483647` in four bytes.

It costs O(1).

-}
signedInt32 : Endianness -> Int -> Encoder
signedInt32 e n =
  I32 { endian = e, number = n }


{-| Encode a `UInt8`, a byte, in one byte.

It costs O(1).

-}
unsignedInt8 : UInt8 -> Encoder
unsignedInt8 n =
  U8 (u8ToI32 n)


{-| Encode a `UInt16` in two bytes.

It costs O(1).

-}
unsignedInt16 : Endianness -> UInt16 -> Encoder
unsignedInt16 e n =
  U16 { endian = e, number = u16ToI32 n }


{-| Encode a `UInt32` in four bytes.

It takes a `UInt32` rather than an `Int` because an `Int` is 32 bits and signed
(D2), so half of the range this writes is not an `Int` at all. A bit pattern
that is already in an `Int` is `UInt32.fromIntWrap` away.

It costs O(1).

-}
unsignedInt32 : Endianness -> UInt32 -> Encoder
unsignedInt32 e n =
  U32 { endian = e, number = n }


-- FLOATS


{-| Encode 32-bit floating point numbers in four bytes.

It costs O(1).

-}
float32 : Endianness -> Float -> Encoder
float32 e n =
  F32 { endian = e, number = n }


{-| Encode 64-bit floating point numbers in eight bytes.

It costs O(1).

-}
float64 : Endianness -> Float -> Encoder
float64 e n =
  F64 { endian = e, number = n }



-- BYTES


{-| Copy bytes directly into the new `Bytes` sequence. This does not record the
length though! You usually want to say something like this:

    import Bytes exposing (Bytes, Endianness(..))
    import Bytes.Encode as Encode
    import UInt32

    png : Bytes -> Encode.Encoder
    png imageData =
      Encode.sequence
        [ Encode.unsignedInt32 BE (UInt32.fromInt (Bytes.length imageData))
        , Encode.bytes imageData
        ]

This allows you to represent the length however is necessary for your protocol.
For example, you can use [Base 128 Varints][pb] for ProtoBuf,
[Variable-Length Integers][sql] for SQLite, or whatever else they dream up.

[pb]: https://developers.google.com/protocol-buffers/docs/encoding#varints
[sql]: https://www.sqlite.org/src4/doc/trunk/www/varint.wiki

It costs O(1), and [`encode`](#encode) copies the bytes, O(n).

-}
bytes : Bytes -> Encoder
bytes =
  Bytes


-- SEQUENCE


{-| Put together a bunch of builders. So if you wanted to encode three `Float`
values for the position of a ball in 3D space, you could say:

    import Bytes exposing (Endianness(..))
    import Bytes.Encode as Encode

    type alias Ball = { x : Float, y : Float, z : Float }

    ball : Ball -> Encode.Encoder
    ball {x,y,z} =
      Encode.sequence
        [ Encode.float32 BE x
        , Encode.float32 BE y
        , Encode.float32 BE z
        ]

It costs O(k) for k encoders, adding up their widths, and a sequence holds its
width, so nesting one in another adds O(1). A sequence whose width would pass
the largest `Int` holds that it does, which [`encode`](#encode) and
[`encodeChecked`](#encodeChecked) find.

-}
sequence : Array Encoder -> Encoder
sequence builders =
  Seq { width = (getLengths 0 builders), items = builders }


-- WRITE


-- The transient is threaded linearly, and each write's offset is worked out
-- from the widths before it rather than returned by the write. The byte order
-- is Geng over one byte at a time (`m1b-bytes-prim.md` D232). Each write is
-- tested against the transient's length, which `encode`'s width always
-- passes, so that the checker proves every write (D863).


@prim("i32_and")
band : Int -> Int -> Int


@prim("i8_to_i32")
i8ToI32 : Int8 -> Int


@prim("u8_to_i32")
u8ToI32 : UInt8 -> Int


@prim("i16_to_i32")
i16ToI32 : Int16 -> Int


@prim("u16_to_i32")
u16ToI32 : UInt16 -> Int


@prim("i32_ushr")
ushr : Int -> Int -> Int


@prim("u32_as_i32")
u32AsI32 : UInt32 -> Int


@prim("u64_to_u32")
u64ToU32 : UInt64 -> UInt32


@prim("u64_ushr")
ushr64 : UInt64 -> Int -> UInt64


@prim("f64_bits")
f64Bits : Float -> UInt64


@prim("f64_to_f32")
f64ToF32 : Float -> Float32


@prim("f32_bits")
f32Bits : Float32 -> UInt32


setWord16 : Bool -> (t : Transient) -> (o : Int where 0 <= o && o <= Bytes.Transient.length t - 2) -> Int -> (r : Transient where Bytes.Transient.length r == Bytes.Transient.length t)
setWord16 isLE t o n =
  if isLE then
    Bytes.Transient.setU8 (Bytes.Transient.setU8 t o (band n 255)) (o + 1) (band (ushr n 8) 255)
  else
    Bytes.Transient.setU8 (Bytes.Transient.setU8 t o (band (ushr n 8) 255)) (o + 1) (band n 255)


setWord32 : Bool -> (t : Transient) -> (o : Int where 0 <= o && o <= Bytes.Transient.length t - 4) -> Int -> (r : Transient where Bytes.Transient.length r == Bytes.Transient.length t)
setWord32 isLE t o n =
  if isLE then
    Bytes.Transient.setU8 (Bytes.Transient.setU8 (Bytes.Transient.setU8 (Bytes.Transient.setU8 t o (band n 255)) (o + 1) (band (ushr n 8) 255)) (o + 2) (band (ushr n 16) 255)) (o + 3) (ushr n 24)
  else
    Bytes.Transient.setU8 (Bytes.Transient.setU8 (Bytes.Transient.setU8 (Bytes.Transient.setU8 t o (ushr n 24)) (o + 1) (band (ushr n 16) 255)) (o + 2) (band (ushr n 8) 255)) (o + 3) (band n 255)


write : Encoder -> Transient -> Int -> Transient
write builder mb offset =
  if offset < 0 then
    mb

  else
    when builder is
      I8 n ->
        if offset <= Bytes.Transient.length mb - 1 then Bytes.Transient.setU8 mb offset (band n 255) else mb

      I16 { endian = e, number = n } ->
        if offset <= Bytes.Transient.length mb - 2 then setWord16 (e == LE) mb offset n else mb

      I32 { endian = e, number = n } ->
        if offset <= Bytes.Transient.length mb - 4 then setWord32 (e == LE) mb offset n else mb

      U8 n ->
        if offset <= Bytes.Transient.length mb - 1 then Bytes.Transient.setU8 mb offset (band n 255) else mb

      U16 { endian = e, number = n } ->
        if offset <= Bytes.Transient.length mb - 2 then setWord16 (e == LE) mb offset n else mb

      U32 { endian = e, number = n } ->
        if offset <= Bytes.Transient.length mb - 4 then setWord32 (e == LE) mb offset (u32AsI32 n) else mb

      F32 { endian = e, number = n } ->
        if offset <= Bytes.Transient.length mb - 4 then setWord32 (e == LE) mb offset (u32AsI32 (f32Bits (f64ToF32 n))) else mb

      F64 { endian = e, number = n } ->
        if offset <= Bytes.Transient.length mb - 8 then
          let
            bits = f64Bits n
            high = u32AsI32 (u64ToU32 (ushr64 bits 32))
            low = u32AsI32 (u64ToU32 bits)
          in
          if e == LE then
            setWord32 True (setWord32 True mb offset low) (offset + 4) high
          else
            setWord32 False (setWord32 False mb offset high) (offset + 4) low

        else
          mb

      Seq { items = bs } ->
        writeSequence bs mb offset

      Bytes bs ->
        if primLength bs <= Bytes.Transient.length mb - offset then primSetBytes mb offset bs else mb


writeSequence : Array Encoder -> Transient -> Int -> Transient
writeSequence builders mb offset =
  Array.foldl
    (\builder acc ->
      { t = write builder acc.t acc.offset, offset = acc.offset + getLength builder }
    )
    { t = mb, offset = offset }
    builders
    |> .t


-- LENGTHS


getLength : Encoder -> Int
getLength builder =
  when builder is
    I8  _ -> 1
    I16 _ -> 2
    I32 _ -> 4
    U8  _ -> 1
    U16 _ -> 2
    U32 _ -> 4
    F32 _ -> 4
    F64 _ -> 8
    Seq { width = w } -> w
    Bytes bs -> primLength bs


{-| The widths added up, or -1 once the sum would pass the largest `Int` or
an item's width is -1 itself. The test is a subtraction, which cannot wrap
where a sum can (D863).
-}
getLengths : Int -> Array Encoder -> Int
getLengths length builders =
  Array.foldl
    (\builder sum ->
      let
        width =
          getLength builder
      in
      if sum < 0 || width < 0 then
        -1

      else if width <= 2147483647 - sum then
        sum + width

      else
        -1
    )
    length
    builders


{-| `Bytes.Transient.new` without its requirement: a width below 0 stands for
one past 2^31 − 1, and the primitive ends the program with a message naming
the limit (D863).
-}
@prim("bt_new")
primNewOrCrash : (n : Int) -> (r : Transient where Bytes.Transient.length r == n)


@prim("bt_set_bytes")
primSetBytes : (t : Transient) -> (i : Int where 0 <= i) -> (b : Bytes where Bytes.length b <= Bytes.Transient.length t - i) -> (r : Transient where Bytes.Transient.length r == Bytes.Transient.length t)


@prim("bt_to_bytes")
primToBytes : (t : Transient) -> (r : Bytes where Bytes.length r == Bytes.Transient.length t)


@prim("bytes_length")
primLength : Bytes -> Int
