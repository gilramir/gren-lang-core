module Bytes.Builder exposing
    ( Builder
    , empty
    , pushLast
    , pushCodePoint
    , append
    , length
    , toBytes
    )

{-| `Bytes` built a byte at a time, in place (geng-lang `m4-puritty.md`
D1050).

A `Builder` is a buffer of bytes and the count of them written, over the
transient `Bytes.Encode` writes into (D233), which `core` keeps to itself.
It is opaque, as an `Array.Builder` is: only this module makes one, so its
count is always the bytes written (geng-lang `m4-refine-next.md` RX6).
A builder is used at most once, as an `Array.Builder` is (D963): each call
gives it up and answers the builder to use next, and the compiler refuses
a program that uses one again.

## Costs

[`pushLast`](#pushLast) writes a byte in place, O(1); when the buffer is
full it is copied into one twice its size, so O(1) amortized.
[`pushCodePoint`](#pushCodePoint) writes a code point's UTF-8, one to four
bytes, with one test for room. A builder that would pass 2^31 − 1 bytes
ends the program with a message naming the limit, as `Bytes.flatten` does.
[`append`](#append) copies a `Bytes` in one call, O(m) for its m bytes.
[`toBytes`](#toBytes) answers the bytes written without copying them: they
are a slice of the buffer, which stays alive while they do, so up to half
of it is room never written. The same on every target, each cost per call.

@docs Builder, empty, pushLast, pushCodePoint, append, length, toBytes

-}

import Basics exposing (..)
import Bitwise
import Bytes exposing (Bytes)
import Bytes.Transient exposing (Transient)


{-| `Bytes` under construction. -}
type Builder
    = Builder State


{-| A builder's buffer and the count of bytes written into it. -}
type alias State =
    { buffer : Transient
    , count : Int
    }


{-| A builder of no bytes, with room for `n` before it first grows. A hint
below 16 is taken as 16. -}
empty : Int -> Builder
empty n =
    Builder { buffer = Bytes.Transient.new (max 16 n), count = 0 }


{-| The low eight bits of `byte` written after the rest. -}
pushLast : Int -> (moved b : Builder) -> Builder
pushLast byte (Builder b) =
    let
        buffer0 =
            b.buffer

        at0 =
            b.count
    in
    -- the room tested here, so that a push with room calls nothing
    if at0 >= 0 && at0 < Bytes.Transient.length buffer0 then
        Builder { buffer = Bytes.Transient.setU8 buffer0 at0 (Bitwise.and 255 byte), count = at0 + 1 }

    else
        let
            room =
                roomFor 1 { buffer = buffer0, count = at0 }

            buffer =
                room.buffer

            at =
                room.count
        in
        if at >= 0 && at < Bytes.Transient.length buffer then
            Builder { buffer = Bytes.Transient.setU8 buffer at (Bitwise.and 255 byte), count = at + 1 }

        else
            Builder { buffer = buffer, count = at }


{-| A code point written after the rest as UTF-8: one byte below 0x80, two
below 0x800, three below 0x10000, else four. One above 0x10FFFF, or a
surrogate, is written as U+FFFD, as `Bytes.fromString` would have it. -}
pushCodePoint : Int -> (moved b : Builder) -> Builder
pushCodePoint cp0 (Builder b) =
    let
        cp =
            if cp0 < 0 || cp0 > 0x10FFFF || (cp0 >= 0xD800 && cp0 <= 0xDFFF) then
                0xFFFD

            else
                cp0

        buffer0 =
            b.buffer

        at0 =
            b.count

        -- the room tested here, so that a push with room calls nothing
        room =
            if at0 >= 0 && at0 <= Bytes.Transient.length buffer0 - 4 then
                { buffer = buffer0, count = at0 }

            else
                roomFor 4 { buffer = buffer0, count = at0 }

        buffer =
            room.buffer

        at =
            room.count
    in
    if at < 0 || at > Bytes.Transient.length buffer - 4 then
        Builder { buffer = buffer, count = at }

    else if cp < 0x80 then
        Builder { buffer = Bytes.Transient.setU8 buffer at cp, count = at + 1 }

    else if cp < 0x800 then
        Builder
        { buffer =
            Bytes.Transient.setU8 (Bytes.Transient.setU8 buffer at (Bitwise.or 0xC0 (Bitwise.shiftRightZfBy 6 cp))) (at + 1) (Bitwise.or 0x80 (Bitwise.and 0x3F cp))
        , count = at + 2
        }

    else if cp < 0x10000 then
        Builder
        { buffer =
            Bytes.Transient.setU8
                (Bytes.Transient.setU8 (Bytes.Transient.setU8 buffer at (Bitwise.or 0xE0 (Bitwise.shiftRightZfBy 12 cp))) (at + 1) (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 6 cp))))
                (at + 2)
                (Bitwise.or 0x80 (Bitwise.and 0x3F cp))
        , count = at + 3
        }

    else
        Builder
        { buffer =
            Bytes.Transient.setU8
                (Bytes.Transient.setU8
                    (Bytes.Transient.setU8 (Bytes.Transient.setU8 buffer at (Bitwise.or 0xF0 (Bitwise.shiftRightZfBy 18 cp))) (at + 1) (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 12 cp))))
                    (at + 2)
                    (Bitwise.or 0x80 (Bitwise.and 0x3F (Bitwise.shiftRightZfBy 6 cp)))
                )
                (at + 3)
                (Bitwise.or 0x80 (Bitwise.and 0x3F cp))
        , count = at + 4
        }


{-| The bytes of `bytes` written after the rest. -}
append : Bytes -> (moved b : Builder) -> Builder
append bytes (Builder b) =
    let
        n =
            Bytes.length bytes

        room =
            roomFor n b

        buffer =
            room.buffer

        at =
            room.count
    in
    if at >= 0 && n <= Bytes.Transient.length buffer - at then
        Builder { buffer = primSetBytes buffer at bytes, count = at + n }

    else
        Builder { buffer = buffer, count = at }


{-| How many bytes are written. -}
length : Builder -> Int
length (Builder b) =
    b.count


{-| The bytes written. -}
toBytes : (moved b : Builder) -> Bytes
toBytes (Builder b) =
    let
        count =
            b.count
    in
    Bytes.slice 0 count (primToBytes b.buffer)


{-| The builder with room for `n` more bytes: as it is when it has it, else
its bytes copied into a buffer twice the size it needs, at most 2^31 − 1;
a builder that would pass that ends the program with a message naming the
limit, as `Bytes.flatten` does (D863). Its tests are on locals and written
not to wrap, so that the checker proves each of them. -}
roomFor : Int -> (moved b : State) -> State
roomFor n b =
    let
        buffer =
            b.buffer

        count =
            b.count

        capacity =
            Bytes.Transient.length buffer
    in
    if count < 0 || n < 0 || count > capacity || n <= capacity - count then
        { buffer = buffer, count = count }

    else if n > 2147483647 - count then
        { buffer = primNewOrCrash -1, count = 0 }

    else
        let
            needed =
                count + n

            bigger =
                if capacity >= 1073741824 then
                    2147483647

                else
                    max (2 * capacity) needed

            written =
                primToBytes buffer
        in
        if bigger >= capacity then
            { buffer = primSetBytes (primNewOrCrash bigger) 0 written, count = count }

        else
            { buffer = primNewOrCrash -1, count = 0 }


@prim("bt_new")
primNewOrCrash : (n : Int) -> (r : Transient where Bytes.Transient.length r == n)


@prim("bt_set_bytes")
primSetBytes : (moved t : Transient) -> (i : Nat) -> (b : Bytes where Bytes.length b <= Bytes.Transient.length t - i) -> (r : Transient where Bytes.Transient.length r == Bytes.Transient.length t)


@prim("bt_to_bytes")
primToBytes : (moved t : Transient) -> (r : Bytes where Bytes.length r == Bytes.Transient.length t)
