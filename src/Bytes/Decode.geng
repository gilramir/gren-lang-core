import Basics exposing (..)
import Bytes exposing (Bytes, Endianness(..))
import Inspect
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String exposing (String)



-- PARSER


{-| Describes how to turn a sequence of bytes into a nice Gren value.
-}
type Decoder a =
  Decoder (Bytes -> Int -> Res a)


-- A step answers its failure rather than throwing it, since Geng has no
-- exceptions (`m1b-bytes-prim.md` D229). It is not exposed, so the API is the
-- kernel's. A read checks its bounds first, which `bytes_get_u8`'s
-- precondition asks for, over `i32_lt` and `i32_add` rather than `<` and `+`,
-- which reach `Ord Int`'s `compare` (§BY4).


type Res a
  = Good { offset : Int, value : a }
  | Bad { offset : Int, reason : String }


@prim("i32_lt")
lt : Int -> Int -> Bool


@prim("i32_add")
add : Int -> Int -> Int


@prim("i32_shl")
shl : Int -> Int -> Int


@prim("i32_shr")
shr : Int -> Int -> Int


@prim("i32_or")
bor : Int -> Int -> Int


@prim("i32_as_u32")
asU32 : Int -> UInt32


@prim("u32_to_u64")
u32ToU64 : UInt32 -> UInt64


@prim("u64_shl")
shl64 : UInt64 -> Int -> UInt64


@prim("u64_or")
or64 : UInt64 -> UInt64 -> UInt64


@prim("f32_from_bits")
f32FromBits : UInt32 -> Float32


@prim("f32_to_f64")
f32ToF64 : Float32 -> Float


@prim("f64_from_bits")
f64FromBits : UInt64 -> Float


byte : Bytes -> Int -> Int
byte =
  primGetU8


ended : Bytes -> Res a
ended bites =
  Bad { offset = primLength bites, reason = "the input ended" }


word32 : Bool -> Bytes -> Int -> Int
word32 isLE bites o =
  if isLE then
    bor (bor (bor (byte bites o) (shl (byte bites (add o 1)) 8)) (shl (byte bites (add o 2)) 16)) (shl (byte bites (add o 3)) 24)
  else
    bor (bor (bor (shl (byte bites o) 24) (shl (byte bites (add o 1)) 16)) (shl (byte bites (add o 2)) 8)) (byte bites (add o 3))


word16 : Bool -> Bytes -> Int -> Int
word16 isLE bites o =
  if isLE then
    bor (byte bites o) (shl (byte bites (add o 1)) 8)
  else
    bor (shl (byte bites o) 8) (byte bites (add o 1))


sized : Int -> (Bytes -> Int -> a) -> Bytes -> Int -> Res a
sized width read bites offset =
  if lt (primLength bites) (add offset width) then
    ended bites
  else
    Good { offset = add offset width, value = read bites offset }


{-| Turn a sequence of bytes into a nice Gren value.

    -- decode (unsignedInt16 BE) <0007> == Just 7
    -- decode (unsignedInt16 LE) <0700> == Just 7
    -- decode (unsignedInt16 BE) <0700> == Just 1792
    -- decode (unsignedInt32 BE) <0700> == Nothing

The `Decoder` specifies exactly how this should happen. This process may fail
if the sequence of bytes is corrupted or unexpected somehow. The examples above
show a case where there are not enough bytes.
-}
decode : Decoder a -> Bytes -> Maybe a
decode (Decoder decoder) bs =
  guard
    (\input ->
      when decoder input 0 is
        Good g ->
          Just g.value

        Bad _ ->
          Nothing
    )
    bs
    Nothing


{-| Like [`decode`](#decode), but a failure says where and why.

    -- decodeWithReason (unsignedInt16 BE) <0007> == Ok 7
    -- decodeWithReason (unsignedInt32 BE) <0700> == Err { offset = 2, reason = "the input ended" }

The `offset` is a byte offset into the input. A [`failWith`](#failWith) gives
the offset it was reached at and its own reason. Running out of input gives the
input's length and `"the input ended"`: where the input ended, not where the
read that ran off it began, which is what the Haskell reader of Core and
`Geng.Core.Wire` say too (D230). [`fail`](#fail) is `failWith "Bytes.Decode.fail"`, [`string`](#string)
on bytes that are not UTF-8 is `"not UTF-8"` at the string's first byte, and
[`bytes`](#bytes) of a negative length is `"a negative length"`.

A decoder nested deep enough to exhaust JavaScript's stack gives offset `0` and
`"the stack was exhausted"`, because where it ran out is not known
(`m1b-protobuf.md` §Q14.2).

This and `failWith` are the fork's, and not in `gren-lang/core` (D187).
-}
decodeWithReason : Decoder a -> Bytes -> Result { offset : Int, reason : String } a
decodeWithReason (Decoder decoder) bs =
  guard
    (\input ->
      when decoder input 0 is
        Good g ->
          Ok g.value

        Bad e ->
          Err e
    )
    bs
    (Err { offset = 0, reason = "the stack was exhausted" })


{-| Run a decode, and answer the third argument if it exhausts the stack
(`m1b-bytes-prim.md` D231). A decoder is recursive, and on JavaScript a deep
enough one throws a `RangeError` that Geng cannot catch, where the kernel
answered `Err` (§BY2.3). The JavaScript catches it once per decode, not per
read. A backend with no row runs the body, and has its own stack.
-}
@externPure(js, "Bytes", "guard")
guard : (x -> r) -> x -> r -> r
guard run input _ =
  run input



-- SIGNED INTEGERS


{-| Decode one byte into an integer from `-128` to `127`.
-}
signedInt8 : Decoder Int
signedInt8 =
  Decoder (sized 1 (\b o -> shr (shl (byte b o) 24) 24))


{-| Decode two bytes into an integer from `-32768` to `32767`.
-}
signedInt16 : Endianness -> Decoder Int
signedInt16 endianness =
  Decoder (sized 2 (\b o -> shr (shl (word16 (endianness == LE) b o) 16) 16))


{-| Decode four bytes into an integer from `-2147483648` to `2147483647`.
-}
signedInt32 : Endianness -> Decoder Int
signedInt32 endianness =
  Decoder (sized 4 (word32 (endianness == LE)))



-- UNSIGNED INTEGERS


{-| Decode one byte into an integer from `0` to `255`.
-}
unsignedInt8 : Decoder Int
unsignedInt8 =
  Decoder
    (\bites offset ->
      if lt offset (primLength bites) then
        Good { offset = add offset 1, value = byte bites offset }
      else
        ended bites
    )


{-| Decode two bytes into an integer from `0` to `65535`.
-}
unsignedInt16 : Endianness -> Decoder Int
unsignedInt16 endianness =
  Decoder (sized 2 (word16 (endianness == LE)))


{-| Decode four bytes into a `UInt32`.

A `UInt32` rather than an `Int`, because an `Int` is 32 bits and signed (D2):
until 2026-09-13 this answered an `Int` holding `4294967295`, which printed as
that, compared unequal to `-1`, and became `-1` the moment it was added to
anything (`m1b-protobuf.md` §Q13).
-}
unsignedInt32 : Endianness -> Decoder UInt32
unsignedInt32 endianness =
  Decoder (sized 4 (\b o -> asU32 (word32 (endianness == LE) b o)))



-- FLOATS


{-| Decode four bytes into a floating point number.
-}
float32 : Endianness -> Decoder Float
float32 endianness =
  Decoder (sized 4 (\b o -> f32ToF64 (f32FromBits (asU32 (word32 (endianness == LE) b o)))))


{-| Decode eight bytes into a floating point number.
-}
float64 : Endianness -> Decoder Float
float64 endianness =
  Decoder (sized 8 (float64At (endianness == LE)))


float64At : Bool -> Bytes -> Int -> Float
float64At isLE b o =
  let
    first = u32ToU64 (asU32 (word32 isLE b o))
    second = u32ToU64 (asU32 (word32 isLE b (add o 4)))
  in
  if isLE then
    f64FromBits (or64 (shl64 second 32) first)
  else
    f64FromBits (or64 (shl64 first 32) second)



-- BYTES


{-| Copy a given number of bytes into a new `Bytes` sequence.
-}
bytes : Int -> Decoder Bytes
bytes n =
  Decoder <|
    \bites offset ->
      if lt n 0 then
        Bad { offset = offset, reason = "a negative length" }

      else if lt (primLength bites) (add offset n) then
        ended bites

      else
        Good { offset = add offset n, value = primSlice bites offset (add offset n) }



-- STRINGS


{-| Decode a given number of UTF-8 bytes into a `String`.

Most protocols store the length of the string right before the content, so you
will probably write things like this:

    import Bytes exposing (Endianness(..))
    import Bytes.Decode as Decode

    sizedString : Decode.Decoder String
    sizedString =
      Decode.unsignedInt32 BE
        |> Decode.andThen Decode.string

In this case we read the length as a 32-bit unsigned integer, but you have the
leeway to read the length as a [Base 128 Varint][pb] for ProtoBuf, a
[Variable-Length Integer][sql] for SQLite, or whatever else they dream up.

[pb]: https://developers.google.com/protocol-buffers/docs/encoding#varints
[sql]: https://www.sqlite.org/src4/doc/trunk/www/varint.wiki
-}
string : Int -> Decoder String
string n =
  let
    (Decoder readBytes) = bytes n
  in
  Decoder <|
    \bites offset ->
      when readBytes bites offset is
        Good read ->
          when Bytes.toString read.value is
            Just str ->
              Good { offset = read.offset, value = str }

            Nothing ->
              Bad { offset = offset, reason = "not UTF-8" }

        Bad e ->
          Bad e



-- MAP


{-| Transform the value produced by a decoder. If you encode negative numbers
in a special way, you can say something like this:

    negativeInt8 : Decoder Int
    negativeInt8 =
      map negate unsignedInt8

In practice you may see something like ProtoBuf’s [ZigZag encoding][zz] which
decreases the size of small negative numbers.

[zz]: https://developers.google.com/protocol-buffers/docs/encoding#types
-}
map : (a -> b) -> Decoder a -> Decoder b
map func (Decoder decodeA) =
  Decoder <|
    \bites offset ->
      when decodeA bites offset is
        Good a ->
          Good { offset = a.offset, value = func a.value }

        Bad e ->
          Bad e


{-| Combine two decoders.

    import Bytes exposing ( Endianness(..) )
    import Bytes.Decode as Decode

    type alias Point =
        { x : Float
        , y : Float
        }

    makePoint : Float -> Float -> Point
    makePoint x y =
        { x = x
        , y = y
        }

    decoder : Decode.Decoder Point
    decoder =
        Decode.map2 makePoint (Decode.float32 BE) (Decode.float32 BE)
-}
map2 : (a -> b -> result) -> Decoder a -> Decoder b -> Decoder result
map2 func (Decoder decodeA) (Decoder decodeB) =
  Decoder <|
    \bites offset ->
      when decodeA bites offset is
        Bad x ->
          Bad x

        Good a ->
          when decodeB bites a.offset is
            Bad x ->
              Bad x

            Good b ->
              Good { offset = b.offset, value = func a.value b.value }


{-| Combine three decoders.
-}
map3 : (a -> b -> c -> result) -> Decoder a -> Decoder b -> Decoder c -> Decoder result
map3 func (Decoder decodeA) (Decoder decodeB) (Decoder decodeC) =
  Decoder <|
    \bites offset ->
      when decodeA bites offset is
        Bad x ->
          Bad x

        Good a ->
          when decodeB bites a.offset is
            Bad x ->
              Bad x

            Good b ->
              when decodeC bites b.offset is
                Bad x ->
                  Bad x

                Good c ->
                  Good { offset = c.offset, value = func a.value b.value c.value }


{-| Combine four decoders.
-}
map4 : (a -> b -> c -> d -> result) -> Decoder a -> Decoder b -> Decoder c -> Decoder d -> Decoder result
map4 func (Decoder decodeA) (Decoder decodeB) (Decoder decodeC) (Decoder decodeD) =
  Decoder <|
    \bites offset ->
      when decodeA bites offset is
        Bad x ->
          Bad x

        Good a ->
          when decodeB bites a.offset is
            Bad x ->
              Bad x

            Good b ->
              when decodeC bites b.offset is
                Bad x ->
                  Bad x

                Good c ->
                  when decodeD bites c.offset is
                    Bad x ->
                      Bad x

                    Good d ->
                      Good { offset = d.offset, value = func a.value b.value c.value d.value }


{-| Combine five decoders. If you need to combine more things, it is possible
to define more of these with `map2` or `andThen`.
-}
map5 : (a -> b -> c -> d -> e -> result) -> Decoder a -> Decoder b -> Decoder c -> Decoder d -> Decoder e -> Decoder result
map5 func (Decoder decodeA) (Decoder decodeB) (Decoder decodeC) (Decoder decodeD) (Decoder decodeE) =
  Decoder <|
    \bites offset ->
      when decodeA bites offset is
        Bad x ->
          Bad x

        Good a ->
          when decodeB bites a.offset is
            Bad x ->
              Bad x

            Good b ->
              when decodeC bites b.offset is
                Bad x ->
                  Bad x

                Good c ->
                  when decodeD bites c.offset is
                    Bad x ->
                      Bad x

                    Good d ->
                      when decodeE bites d.offset is
                        Bad x ->
                          Bad x

                        Good e ->
                          Good { offset = e.offset, value = func a.value b.value c.value d.value e.value }



-- AND THEN


{-| Decode something **and then** use that information to decode something
else. This is most common with strings or sequences where you need to read
how long the value is going to be:

    import Bytes exposing (Endianness(..))
    import Bytes.Decode as Decode

    string : Decoder String
    string =
      Decode.unsignedInt32 BE
        |> Decode.andThen Decode.string

Check out the docs for [`succeed`](#succeed), [`fail`](#fail), and
[`loop`](#loop) to see `andThen` used in more ways!
-}
andThen : (a -> Decoder b) -> Decoder a -> Decoder b
andThen callback (Decoder decodeA) =
  Decoder <|
    \bites offset ->
      when decodeA bites offset is
        Good new ->
          let
            (Decoder decodeB) = callback new.value
          in
          decodeB bites new.offset

        Bad e ->
          Bad e


{-| A decoder that always succeeds with a certain value. Maybe we are making
a `Maybe` decoder:

    import Bytes.Decode as Decode exposing (Decoder)

    maybe : Decoder a -> Decoder (Maybe a)
    maybe decoder =
      let
        helper n =
          if n == 0 then
            Decode.succeed Nothing
          else
            Decode.map Just decoder
      in
      Decode.unsignedInt8
        |> Decode.andThen helper

If the first byte is `00000000` then it is `Nothing`, otherwise we start
decoding the value and put it in a `Just`.
-}
succeed : a -> Decoder a
succeed a =
  Decoder (\_ offset -> Good { offset = offset, value = a })


{-| A decoder that always fails. This can be useful when using `andThen` to
decode custom types:

    import Bytes exposing (Endianness(..))
    import Bytes.Encode as Encode
    import Bytes.Decode as Decode

    type Distance = Yards Float | Meters Float

    toEncoder : Distance -> Encode.Encoder
    toEncoder distance =
      when distance is
        Yards n -> Encode.sequence [ Encode.unsignedInt8 0, Encode.float32 BE n ]
        Meters n -> Encode.sequence [ Encode.unsignedInt8 1, Encode.float32 BE n ]

    decoder : Decode.Decoder Distance
    decoder =
      Decode.unsignedInt8
        |> Decode.andThen pickDecoder

    pickDecoder : Int -> Decode.Decoder Distance
    pickDecoder tag =
      when tag is
        0 -> Decode.map Yards (Decode.float32 BE)
        1 -> Decode.map Meters (Decode.float32 BE)
        _ -> Decode.fail

The encoding chosen here uses an 8-bit unsigned integer to indicate which
variant we are working with. If we are working with yards do this, if we are
working with meters do that, and otherwise something went wrong!
-}
fail : Decoder a
fail =
  failWith "Bytes.Decode.fail"


{-| A decoder that always fails, with a reason.
[`decodeWithReason`](#decodeWithReason) gives the reason back with the offset
the decoder had reached, and [`decode`](#decode) gives `Nothing`, as it does for
`fail`.

    pickDecoder : Int -> Decode.Decoder Distance
    pickDecoder tag =
      when tag is
        0 -> Decode.map Yards (Decode.float32 BE)
        1 -> Decode.map Meters (Decode.float32 BE)
        _ -> Decode.failWith ("no distance has tag " ++ String.fromInt tag)

The offset is where the decoder is when it fails, so here it is just after the
tag byte.
-}
failWith : String -> Decoder a
failWith reason =
  Decoder (\_ offset -> Bad { offset = offset, reason = reason })



-- LOOP


{-| Decide what steps to take next in your [`loop`](#loop).

If you are `Done`, you give the result of the whole `loop`. If you decide to
`Loop` around again, you give a new state to work from. Maybe you need to add
an item to an array? Or maybe you need to track some information about what you
just saw?

**Note:** It may be helpful to learn about [finite-state machines][fsm] to get
a broader intuition about using `state`. I.e. You may want to create a `type`
that describes four possible states, and then use `Loop` to transition between
them as you consume characters.

[fsm]: https://en.wikipedia.org/wiki/Finite-state_machine
-}
type Step state a
  = Loop state
  | Done a


{-| A decoder that can loop indefinitely. This can be helpful when parsing
repeated structures, like an array:

    import Bytes exposing (Endianness(..))
    import Bytes.Decode as Decode exposing (..)

    array : Decoder a -> Decoder (Array a)
    array decoder =
      unsignedInt32 BE
        |> andThen (\len -> loop (len, []) (arrayStep decoder))

    arrayStep : Decoder a -> { fst : Int, snd : Array a } -> Decoder (Step { fst Int, snd : Array a } (Array a))
    arrayStep decoder (n, xs) =
      if n <= 0 then
        succeed (Done xs)
      else
        map (\x -> Loop (n - 1, x :: xs)) decoder

The `array` decoder first reads a 32-bit unsigned integer. That determines how
many items will be decoded. From there we use [`loop`](#loop) to track all the
items we have parsed so far and figure out when to stop.
-}
loop : state -> (state -> Decoder (Step state a)) -> Decoder a
loop state callback =
  Decoder (loopHelp state callback)


loopHelp : state -> (state -> Decoder (Step state a)) -> Bytes -> Int -> Res a
loopHelp state callback bites offset =
  let
    (Decoder decoder) = callback state
  in
  when decoder bites offset is
    Good new ->
      when new.value is
        Loop newState ->
          loopHelp newState callback bites new.offset

        Done result ->
          Good { offset = new.offset, value = result }

    Bad e ->
      Bad e


@prim("bytes_get_u8")
primGetU8 : Bytes -> Int -> Int


@prim("bytes_length")
primLength : Bytes -> Int


@prim("bytes_slice")
primSlice : Bytes -> Int -> Int -> Bytes
