module Char exposing
    ( Char
    , isUpper, isLower, isAlpha, isAlphaNum
    , isDigit, isOctDigit, isHexDigit
    , toCode, fromCode
    )

{-| Functions for working with characters. Character literals are enclosed in
`'a'` pair of single quotes.


@docs Char


## ASCII Letters

@docs isUpper, isLower, isAlpha, isAlphaNum


## Digits

@docs isDigit, isOctDigit, isHexDigit


## Unicode Code Points

@docs toCode, fromCode

-}

import Basics exposing ((&&), (<=), (==), (>=), (||), Bool, Eq, Int, Ord)
import Maybe exposing (Maybe(..))



-- CHAR


{-| A `Char` is a single [unicode][u] character:

    'a'

    '0'

    'Z'

    '?'

    '"'

    'Σ'

    '🙈'

    '\t'

    '"'

    '\''

    '🙈' -- '🙈'

**Note 1:** You _cannot_ use single quotes around multiple characters like in
JavaScript. This is how we distinguish [`String`](String#String) and `Char`
values in syntax.

**Note 2:** You can use the unicode escapes from `\u{0000}` to `\u{10FFFF}` to
represent characters by their code point. You can also include the unicode
characters directly. Using the escapes can be better if you need one of the
many whitespace characters with different widths.

[u]: https://en.wikipedia.org/wiki/Unicode

-}
type Char
    = Char -- NOTE: The compiler provides the real implementation.



-- CLASSIFICATION


{-| Detect upper case ASCII characters.

    isUpper 'A' == True

    isUpper 'B'
        == True
        ... isUpper 'Z'
        == True

    isUpper '0' == False

    isUpper 'a' == False

    isUpper '-' == False

    isUpper 'Σ' == False

-}
isUpper : Char -> Bool
isUpper char =
    let
        code =
            toCode char
    in
    code <= 0x5A && 0x41 <= code


{-| Detect lower case ASCII characters.

    isLower 'a' == True

    isLower 'b'
        == True
        ... isLower 'z'
        == True

    isLower '0' == False

    isLower 'A' == False

    isLower '-' == False

    isLower 'π' == False

-}
isLower : Char -> Bool
isLower char =
    let
        code =
            toCode char
    in
    0x61 <= code && code <= 0x7A


{-| Detect upper case and lower case ASCII characters.

    isAlpha 'a' == True

    isAlpha 'b' == True

    isAlpha 'E' == True

    isAlpha 'Y' == True

    isAlpha '0' == False

    isAlpha '-' == False

    isAlpha 'π' == False

-}
isAlpha : Char -> Bool
isAlpha char =
    isLower char || isUpper char


{-| Detect upper case and lower case ASCII characters.

    isAlphaNum 'a' == True

    isAlphaNum 'b' == True

    isAlphaNum 'E' == True

    isAlphaNum 'Y' == True

    isAlphaNum '0' == True

    isAlphaNum '7' == True

    isAlphaNum '-' == False

    isAlphaNum 'π' == False

-}
isAlphaNum : Char -> Bool
isAlphaNum char =
    isLower char || isUpper char || isDigit char


{-| Detect digits `0123456789`

    isDigit '0' == True

    isDigit '1'
        == True
        ... isDigit '9'
        == True

    isDigit 'a' == False

    isDigit 'b' == False

    isDigit 'A' == False

-}
isDigit : Char -> Bool
isDigit char =
    let
        code =
            toCode char
    in
    code <= 0x39 && 0x30 <= code


{-| Detect octal digits `01234567`

    isOctDigit '0' == True

    isOctDigit '1'
        == True
        ... isOctDigit '7'
        == True

    isOctDigit '8' == False

    isOctDigit 'a' == False

    isOctDigit 'A' == False

-}
isOctDigit : Char -> Bool
isOctDigit char =
    let
        code =
            toCode char
    in
    code <= 0x37 && 0x30 <= code


{-| Detect hexadecimal digits `0123456789abcdefABCDEF`
-}
isHexDigit : Char -> Bool
isHexDigit char =
    let
        code =
            toCode char
    in
    (0x30 <= code && code <= 0x39)
        || (0x41 <= code && code <= 0x46)
        || (0x61 <= code && code <= 0x66)



-- CONVERSIONS


{-| Convert to the corresponding Unicode [code point][cp].

[cp]: https://en.wikipedia.org/wiki/Code_point

    toCode 'A' == 65

    toCode 'B' == 66

    toCode '木' == 0x6728

    toCode '𝌆' == 0x0001D306

    toCode '😃' == 0x0001F603

A `Char` *is* its code point (C8), so this is the identity on every backend and
is the primitive itself rather than a wrapper around one.

-}
@prim("char_to_i32")
toCode : Char -> Int


{-| Convert a Unicode [code point][cp] to a character, when the number is one.

    fromCode 65 == Just 'A'

    fromCode 0x6728 == Just '木'

    fromCode 0x0001F603 == Just '😃'

    fromCode 0xD800 == Nothing

    fromCode 0x110000 == Nothing

    fromCode -1 == Nothing

A `Char` is a Unicode **scalar value**: a code point in `0 .. 0x10FFFF` that is
not one of the surrogates, `0xD800 .. 0xDFFF`. Those exist to encode the
characters above `0xFFFF` in UTF-16 and are not characters themselves, so
`fromCode` refuses them along with everything outside the range — which is why
this returns a [`Maybe`](Maybe#Maybe) rather than picking a character nobody
asked for.

[cp]: https://en.wikipedia.org/wiki/Code_point

-}
fromCode : Int -> Maybe Char
fromCode code =
    if 0 <= code && code <= 0xD7FF then
        Just (codeToCharPrim code)

    else if 0xE000 <= code && code <= 0x10FFFF then
        Just (codeToCharPrim code)

    else
        Nothing


-- `toCode` above is `char_to_i32` and this is its inverse, and both are the
-- identity at run time on a backend whose `Char` is a machine integer -- which
-- is every backend there is. They are primitives rather than kernel functions
-- because the representation is the compiler's to know:
-- `Generate.CoreJS.Prim` writes the JavaScript and `Generate.LowC` the C, and
-- neither has anything to convert.
--
-- This half is **unchecked**, which is why it is private and why `toCode` is
-- not: its precondition is `fromCode`'s two ranges, and nothing else in `core`
-- may reach it.


@prim("i32_to_char")
codeToCharPrim : Int -> Char


-- `Eq Char` and `Ord Char` are `Int`'s, on the code point: a `Char` is one
-- (C8), so `toCode` is the identity on every backend and two `Char`s are equal
-- or ordered exactly when their numbers are (D333; D142 and
-- `docs/m1b-classes.md` §G40 before it, when both were
-- `Gren.Kernel.Utils`). It used to be `Char.identical`, because a `Char` was a
-- one-character string that a dev build boxed in a `String` object;
-- `m1b-str.md` §T12 is where that box went.


instance Eq Char where
    eq a b =
        toCode a == toCode b


instance Ord Char where
    compare a b =
        compare (toCode a) (toCode b)
