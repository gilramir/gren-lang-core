module UInt64 exposing
    ( minValue, maxValue
    , fromInt, fromIntWrap, fromIntChecked
    , toInt, toIntWrap, toIntChecked
    , fromUInt32, fromInt64, fromInt64Wrap, fromInt64Checked
    , toFloat
    , round, floor, ceiling, truncate
    )

{-| The bounds and the conversions of a 64-bit unsigned integer.

The **type** is [Basics.UInt64](Basics#UInt64), for the reason
[Int64](Int64) gives.

**When to use one.** [UInt32](UInt32)'s reasons at twice the width, and
[Int64](Int64)'s cost: a `UInt64` is a JavaScript `BigInt`, so it is the type
for a 64-bit bit pattern and not for a loop counter.


## Bounds

@docs minValue, maxValue


## From an `Int`

@docs fromInt, fromIntWrap, fromIntChecked


## To an `Int`

@docs toInt, toIntWrap, toIntChecked


## From another width

D151 puts a conversion in the module of the type it **produces**, so this is
every width a `UInt64` can be made from; a `UInt64` leaves through
[UInt32.fromUInt64](UInt32#fromUInt64) and
[Int64.fromUInt64](Int64#fromUInt64), both of which narrow and so carry the
three names.

@docs fromUInt32, fromInt64, fromInt64Wrap, fromInt64Checked


## To a float

@docs toFloat


## From a float

A10's float-to-integer family, at this width: each **saturates** at
[minValue](#minValue) and [maxValue](#maxValue), a `NaN` is `0`, and each takes
a `Float` only, a `Float32` widening first. [Math](Math)'s four of these names
are the same operations at `Int` (D152).

This is the one width whose range a `Float` cannot cover. Above `2^53` the
doubles are further apart than the integers -- by `2^63` they are 2048 apart --
so most `UInt64`s are not the conversion of any `Float` at all, and an argument
that came from arithmetic has already rounded before it gets here. The
conversion itself is exact at every `Float` it is given.

@docs round, floor, ceiling, truncate

-}

import Basics exposing (Bool, Float, Int, Int64, UInt32, UInt64, Num, Ord, Fractional, (-), (<), (>), (>=))
import Int64
import Maybe exposing (Maybe(..))
import UInt32


-- BOUNDS


{-| `0`.
-}
minValue : UInt64
minValue =
    0


{-| `18446744073709551615`.

Digits, and it was `Bitwise.complement 0` until §I16 of `docs/m1b-int.md`: a
literal used to be carried through canonicalization as a machine `Int`, which
stops one decimal short of every `UInt64` above `2^63 - 1`. Both of D86's
parsers carry one exactly now.

-}
maxValue : UInt64
maxValue =
    18446744073709551615



-- FROM AN INT


{-| Widen an `Int`, **saturating** at `0`.

    UInt64.fromInt -1 == UInt64.minValue

-}
fromInt : Int -> UInt64
fromInt n =
    if n < 0 then
        0

    else
        fromIntWrap n


{-| Widen an `Int` and reinterpret its 64 sign-extended bits as unsigned.

    UInt64.fromIntWrap -1 == UInt64.maxValue

-}
fromIntWrap : Int -> UInt64
fromIntWrap n =
    fromInt64Wrap (Int64.fromInt n)


{-| Widen an `Int`, or `Nothing` when it is negative.
-}
fromIntChecked : Int -> Maybe UInt64
fromIntChecked n =
    if n < 0 then
        Nothing

    else
        Just (fromIntWrap n)



-- TO AN INT


{-| Narrow to an `Int`, **saturating** at `2147483647`.

    UInt64.toInt UInt64.maxValue == 2147483647

-}
toInt : UInt64 -> Int
toInt n =
    if n > maxIntAsUInt64 then
        2147483647

    else
        toIntWrap n


{-| Narrow to an `Int` by keeping the **low 32 bits**.

    UInt64.toIntWrap UInt64.maxValue == -1

-}
toIntWrap : UInt64 -> Int
toIntWrap n =
    UInt32.toIntWrap (UInt32.fromUInt64Wrap n)


{-| Narrow to an `Int`, or `Nothing` when it does not fit.
-}
toIntChecked : UInt64 -> Maybe Int
toIntChecked n =
    if n > maxIntAsUInt64 then
        Nothing

    else
        Just (toIntWrap n)


maxIntAsUInt64 : UInt64
maxIntAsUInt64 =
    2147483647


-- FROM ANOTHER WIDTH
--
-- This is also where the two `Int` conversions above get their bits: an `Int`
-- reaches a `UInt64` through `Int64.fromInt` and `fromInt64Wrap`, and leaves
-- through `UInt32.fromUInt64Wrap` and `UInt32.toIntWrap`. Those four crossings
-- were private primitives while `Int` was the only other width A10's table had
-- reached; they are the table's own entries now, and nothing here declares a
-- primitive twice.


{-| Widen a `UInt32`. Exact and total: every `UInt32` is a `UInt64`.

    UInt64.fromUInt32 UInt32.maxValue == 4294967295

-}
@prim("u32_to_u64")
fromUInt32 : UInt32 -> UInt64


{-| Reinterpret an `Int64`, **saturating** at [minValue](#minValue). The two
types are the same 64 bits, and the only `Int64` a `UInt64` cannot hold is a
negative one.

    UInt64.fromInt64 (Int64.fromInt 42) == 42

    UInt64.fromInt64 Int64.minValue == UInt64.minValue

-}
fromInt64 : Int64 -> UInt64
fromInt64 n =
    if n < zeroAsInt64 then
        minValue

    else
        fromInt64Wrap n


{-| Reinterpret an `Int64`'s 64 bits as unsigned. No bit moves.

    UInt64.fromInt64Wrap (Int64.fromInt -1) == UInt64.maxValue

-}
@prim("i64_as_u64")
fromInt64Wrap : Int64 -> UInt64


{-| Reinterpret an `Int64`, or `Nothing` when it is negative.

    UInt64.fromInt64Checked Int64.minValue == Nothing

-}
fromInt64Checked : Int64 -> Maybe UInt64
fromInt64Checked n =
    if n < zeroAsInt64 then
        Nothing

    else
        Just (fromInt64Wrap n)


zeroAsInt64 : Int64
zeroAsInt64 =
    0



-- TO A FLOAT


{-| Convert to a `Float`.

Total, and lossy above `2^53`: a `UInt64` has 64 bits of magnitude and a
`Float` has 53, so a large one rounds to nearest, ties to even.

-}
@prim("u64_to_f64")
toFloat : UInt64 -> Float


-- FROM A FLOAT


{-| Round to the nearest `UInt64`, **saturating** at this type's bounds. A tie
goes towards positive infinity.

    UInt64.round 1.5 == UInt64.fromInt 2

    UInt64.round -1.5 == UInt64.minValue

    UInt64.round (0 / 0) == UInt64.minValue

-}
round : Float -> UInt64
round x =
    fromFloatBelow Int64.round x


{-| Round down to a `UInt64`, **saturating** at this type's bounds.

    UInt64.floor 1.5 == UInt64.fromInt 1

-}
floor : Float -> UInt64
floor x =
    fromFloatBelow Int64.floor x


{-| Round up to a `UInt64`, **saturating** at this type's bounds.

    UInt64.ceiling 1.5 == UInt64.fromInt 2

-}
ceiling : Float -> UInt64
ceiling x =
    fromFloatBelow Int64.ceiling x


{-| Round towards zero to a `UInt64`, **saturating** at this type's bounds.

    UInt64.truncate -0.5 == UInt64.minValue

-}
truncate : Float -> UInt64
truncate x =
    fromFloatBelow Int64.truncate x


-- The four above, with the rounding they differ by passed in.
--
-- **Above 2^63 there is no rounding left to do**, and that is what lets this
-- module borrow `Int64`'s four instead of writing them a third time: the
-- doubles from 2^63 up are 2048 apart, so every one of them is already an
-- integer and `round`, `floor`, `ceiling` and `truncate` are all the identity
-- there. Below 2^63 the value fits in an `Int64`, which has the rounding and
-- the saturation written out, and narrowing its answer saturates again at `0`
-- -- which is the only bound of this type the signed range does not already
-- cover.
--
-- The band between 2^63 and 2^64 is the one place a 64-bit unsigned conversion
-- cannot be borrowed from a 64-bit signed one, and it is two operations rather
-- than a primitive: subtract the modulus, which is exact because both are
-- multiples of 2048 and the difference lands in `[-2^63, 0)`, then read the
-- 64 bits back as unsigned. That is what wrapping *means* at this width, and
-- `Core.Prim` needs no `f64_to_u64_trunc` for it.
fromFloatBelow : (Float -> Int64) -> Float -> UInt64
fromFloatBelow below x =
    if isNaN x then
        minValue

    else if x >= twoToThe64 then
        maxValue

    else if x >= twoToThe63 then
        fromInt64Wrap (truncToInt64 (x - twoToThe64))

    else
        fromInt64 (below x)


@prim("f64_to_i64_trunc")
truncToInt64 : Float -> Int64


-- The two powers of two this width is bracketed by, as floats. Both are exact,
-- and both are written as literals with a fraction: §I13.6's machine-`Int`
-- ceiling and §I14.5's `2^53` one are limits on how a *digit* literal is
-- carried, and a float literal is carried as its text by both of D86's parsers.
-- `maxValue` itself is not a `Float` -- 2^64 - 1 rounds to 2^64 -- which is why
-- the upper test is `>=` against the power of two and not `>` against the bound.


twoToThe63 : Float
twoToThe63 =
    9223372036854775808.0


twoToThe64 : Float
twoToThe64 =
    18446744073709551616.0
