module UInt64 exposing
    ( minValue, maxValue
    , fromInt, fromIntWrap, fromIntChecked
    , toInt, toIntWrap, toIntChecked
    , fromUInt32, fromInt64, fromInt64Wrap, fromInt64Checked
    , toFloat
    )

{-| The bounds and the conversions of a 64-bit unsigned integer.

The **type** is [Basics.UInt64](Basics#UInt64), for the reason
[Int64](Int64) gives.

**When to use one.** [UInt32](UInt32)'s reasons at twice the width, and
[Int64](Int64)'s cost: a `UInt64` is a JavaScript `BigInt`, so it is the type
for a 64-bit bit pattern and not for a loop counter.


## Bounds

@docs minValue, maxValue


## From an `Int`

@docs fromInt, fromIntWrap, fromIntChecked


## To an `Int`

@docs toInt, toIntWrap, toIntChecked


## From another width

D151 puts a conversion in the module of the type it **produces**, so this is
every width a `UInt64` can be made from; a `UInt64` leaves through
[UInt32.fromUInt64](UInt32#fromUInt64) and
[Int64.fromUInt64](Int64#fromUInt64), both of which narrow and so carry the
three names.

@docs fromUInt32, fromInt64, fromInt64Wrap, fromInt64Checked


## To a float

@docs toFloat

-}

import Basics exposing (Bool, Float, Int, Int64, UInt32, UInt64, Num, Ord, (<), (>))
import Bitwise
import Int64
import Maybe exposing (Maybe(..))
import UInt32


-- BOUNDS


{-| `0`.
-}
minValue : UInt64
minValue =
    0


{-| `18446744073709551615`.

Written as the complement of `0` rather than as digits, for the reason
[Int64.minValue](Int64#minValue) gives: a literal is carried through
canonicalization as a machine `Int`, which stops one decimal short of every
`UInt64` above `2^63 - 1`.

-}
maxValue : UInt64
maxValue =
    Bitwise.complement 0



-- FROM AN INT


{-| Widen an `Int`, **saturating** at `0`.

    UInt64.fromInt -1 == UInt64.minValue

-}
fromInt : Int -> UInt64
fromInt n =
    if n < 0 then
        0

    else
        fromIntWrap n


{-| Widen an `Int` and reinterpret its 64 sign-extended bits as unsigned.

    UInt64.fromIntWrap -1 == UInt64.maxValue

-}
fromIntWrap : Int -> UInt64
fromIntWrap n =
    fromInt64Wrap (Int64.fromInt n)


{-| Widen an `Int`, or `Nothing` when it is negative.
-}
fromIntChecked : Int -> Maybe UInt64
fromIntChecked n =
    if n < 0 then
        Nothing

    else
        Just (fromIntWrap n)



-- TO AN INT


{-| Narrow to an `Int`, **saturating** at `2147483647`.

    UInt64.toInt UInt64.maxValue == 2147483647

-}
toInt : UInt64 -> Int
toInt n =
    if n > maxIntAsUInt64 then
        2147483647

    else
        toIntWrap n


{-| Narrow to an `Int` by keeping the **low 32 bits**.

    UInt64.toIntWrap UInt64.maxValue == -1

-}
toIntWrap : UInt64 -> Int
toIntWrap n =
    UInt32.toIntWrap (UInt32.fromUInt64Wrap n)


{-| Narrow to an `Int`, or `Nothing` when it does not fit.
-}
toIntChecked : UInt64 -> Maybe Int
toIntChecked n =
    if n > maxIntAsUInt64 then
        Nothing

    else
        Just (toIntWrap n)


maxIntAsUInt64 : UInt64
maxIntAsUInt64 =
    2147483647


-- FROM ANOTHER WIDTH
--
-- This is also where the two `Int` conversions above get their bits: an `Int`
-- reaches a `UInt64` through `Int64.fromInt` and `fromInt64Wrap`, and leaves
-- through `UInt32.fromUInt64Wrap` and `UInt32.toIntWrap`. Those four crossings
-- were private primitives while `Int` was the only other width A10's table had
-- reached; they are the table's own entries now, and nothing here declares a
-- primitive twice.


{-| Widen a `UInt32`. Exact and total: every `UInt32` is a `UInt64`.

    UInt64.fromUInt32 UInt32.maxValue == 4294967295

-}
@prim("u32_to_u64")
fromUInt32 : UInt32 -> UInt64


{-| Reinterpret an `Int64`, **saturating** at [minValue](#minValue). The two
types are the same 64 bits, and the only `Int64` a `UInt64` cannot hold is a
negative one.

    UInt64.fromInt64 (Int64.fromInt 42) == 42

    UInt64.fromInt64 Int64.minValue == UInt64.minValue

-}
fromInt64 : Int64 -> UInt64
fromInt64 n =
    if n < zeroAsInt64 then
        minValue

    else
        fromInt64Wrap n


{-| Reinterpret an `Int64`'s 64 bits as unsigned. No bit moves.

    UInt64.fromInt64Wrap (Int64.fromInt -1) == UInt64.maxValue

-}
@prim("i64_as_u64")
fromInt64Wrap : Int64 -> UInt64


{-| Reinterpret an `Int64`, or `Nothing` when it is negative.

    UInt64.fromInt64Checked Int64.minValue == Nothing

-}
fromInt64Checked : Int64 -> Maybe UInt64
fromInt64Checked n =
    if n < zeroAsInt64 then
        Nothing

    else
        Just (fromInt64Wrap n)


zeroAsInt64 : Int64
zeroAsInt64 =
    0



-- TO A FLOAT


{-| Convert to a `Float`.

Total, and lossy above `2^53`: a `UInt64` has 64 bits of magnitude and a
`Float` has 53, so a large one rounds to nearest, ties to even.

-}
@prim("u64_to_f64")
toFloat : UInt64 -> Float
