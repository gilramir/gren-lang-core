module Set exposing
    ( Set
    , empty, singleton, set, remove, toggle
    , isEmpty, member, count, first, last, findFirst, findLast, any, all
    , union, intersect, diff
    , toArray, fromArray
    , map, foldl, foldr, keepIf, mapAndKeepJust, partition
    )

{-| A set of unique values. The values can be any type with an `Ord`
instance. This includes `Int`, `Float`, `Char`, `String`, and arrays of
ordered values.

Getting, setting and removing a value take _O(log n)_ time; `count` and the
functions that look at every entry take _O(n)_, and each function says what it
costs.


## Costs

A set is a `Dict` whose values are `{}`, so each cost here is `Dict`'s: a
red-black tree with no stored size, the same Geng code on every target, and
in-place writes on JavaScript and natively for a loop of `set` or `remove` that
keeps no older version. Costs are per call, counted in comparisons of members,
which a `String` member on JavaScript makes dearer as `Dict` describes. `==` on
two sets builds both as arrays before it compares anything, O(n + m), where
`Dict`'s `==` compares the sizes first.

@docs Set


@docs empty, singleton, set, remove, toggle


## Query

@docs isEmpty, member, count, first, last, findFirst, findLast, any, all


## Combine

@docs union, intersect, diff


## Arrays

@docs toArray, fromArray


## Transform

@docs map, foldl, foldr, keepIf, mapAndKeepJust, partition

-}

import Array exposing (Array)
import Basics exposing (..)
import Dict
import Inspect exposing (Inspect)
import Maybe exposing (Maybe(..))


{-| Represents a set of unique values. So `(Set Int)` is a set of integers and
`(Set String)` is a set of strings.
-}
type Set t
    = Set_gren_builtin (Dict.Dict t {})


{-| Create an empty set.

It costs O(1).

-}
empty : Set a
empty =
    Set_gren_builtin Dict.empty


{-| Create a set with one value.

It costs O(1).

-}
singleton : Ord a => a -> Set a
singleton key =
    Set_gren_builtin (Dict.singleton key {})


{-| Set a value into a set.

It costs O(log n) comparisons of members and allocates a new path of O(log n)
nodes.

-}
set : Ord a => a -> Set a -> Set a
set key (Set_gren_builtin dict) =
    Set_gren_builtin (Dict.set key {} dict)


{-| Remove a value from a set. If the value is not found, no changes are made.

It costs O(log n), up to two comparisons of members at each level, and it
rebuilds the path even when the member is absent.

-}
remove : Ord a => a -> Set a -> Set a
remove key (Set_gren_builtin dict) =
    Set_gren_builtin (Dict.remove key dict)


{-| Toggle a value in a set. If the value isn't in the set, it is added. If the
value is in the set, it is removed.

It costs two descents, O(log n) comparisons each: a lookup, and then a `set` or
a `remove`.

-}
toggle : Ord a => a -> Set a -> Set a
toggle key (Set_gren_builtin dict) =
    when Dict.get key dict is
        Just _ ->
            Set_gren_builtin (Dict.remove key dict)

        Nothing ->
            Set_gren_builtin (Dict.set key {} dict)


{-| Determine if a set is empty.

It costs O(1).

-}
isEmpty : Set a -> Bool
isEmpty (Set_gren_builtin dict) =
    Dict.isEmpty dict


{-| Determine if a value is in a set.

It costs O(log n) comparisons of members.

-}
member : Ord a => a -> Set a -> Bool
member key (Set_gren_builtin dict) =
    Dict.member key dict


{-| Determine the number of elements in a set.

It costs O(n), since a set does not store its size: it walks every member, so
ask `isEmpty` to know whether there are any, and keep a count beside the set
when a loop needs one.

-}
count : Set a -> Int
count (Set_gren_builtin dict) =
    Dict.count dict


{-| Get the first element of the set.

It costs O(log n): it walks down the left edge of the tree.

-}
first : Set a -> Maybe a
first (Set_gren_builtin dict) =
    Maybe.map .key (Dict.first dict)


{-| Get the last element of the set.

It costs O(log n): it walks down the right edge of the tree.

-}
last : Set a -> Maybe a
last (Set_gren_builtin dict) =
    Maybe.map .key (Dict.last dict)


{-| Find the first value that passes the test.

It costs one call of the test for each member from the lowest up to the first
that passes, O(n) when none does.

-}
findFirst : (a -> Bool) -> Set a -> Maybe a
findFirst fn (Set_gren_builtin dict) =
    Maybe.map .key (Dict.findFirst (\key _ -> fn key) dict)


{-| Find the last value that passes the test.

It costs one call of the test for each member from the highest down to the
first that passes, O(n) when none does.

-}
findLast : (a -> Bool) -> Set a -> Maybe a
findLast fn (Set_gren_builtin dict) =
    Maybe.map .key (Dict.findLast (\key _ -> fn key) dict)


{-| Checks if any value in the set passes the test.

It costs one call of the test for each member up to the first that passes, O(n)
when none does.

-}
any : (a -> Bool) -> Set a -> Bool
any fn (Set_gren_builtin dict) =
    Dict.any (\key _ -> fn key) dict


{-| Checks if all values in the set passes the test.

It costs one call of the test for each member up to the first that fails, O(n)
when all pass.

-}
all : (a -> Bool) -> Set a -> Bool
all fn (Set_gren_builtin dict) =
    Dict.all (\key _ -> fn key) dict


{-| Get the union of two sets. Keep all values.

Each value of the first set is inserted into the second, so the union costs
the size of the first: when one set is small and the other grows, as a set of
everything seen so far does, put the small one first.

It costs O(m log (m + n)) for a first set of m members, since each of them is
set into the second, so put the smaller first when the other is the one that
grows.

-}
union : Ord a => Set a -> Set a -> Set a
union (Set_gren_builtin dict1) (Set_gren_builtin dict2) =
    Set_gren_builtin (Dict.union dict1 dict2)


{-| Get the intersection of two sets. Keeps values that appear in both sets.

It costs O(m log n) for a first set of m members and a second of n, one lookup
in the second for each of the first's members, and O(k log k) to build the k it
keeps.

-}
intersect : Ord a => Set a -> Set a -> Set a
intersect (Set_gren_builtin dict1) (Set_gren_builtin dict2) =
    Set_gren_builtin (Dict.intersect dict1 dict2)


{-| Get the difference between the first set and the second. Keeps values
that do not appear in the second set.

It costs O(s log l) for a smaller set of s members and a larger of l, whichever
is first: it compares the two sizes in O(s), and then keeps the first's members
that the second lacks, or removes the second's members from the first.

-}
diff : Ord a => Set a -> Set a -> Set a
diff (Set_gren_builtin dict1) (Set_gren_builtin dict2) =
    Set_gren_builtin (Dict.diff dict1 dict2)


{-| Convert a set into an array, sorted from lowest to highest.

It costs O(n): one walk of the tree into an `Array.Builder`.

-}
toArray : Set a -> Array a
toArray (Set_gren_builtin dict) =
    Dict.keys dict


{-| Convert an array into a set, removing any duplicates.

It costs O(n log n): one `set` for each element, even when the array is already
sorted.

-}
fromArray : Ord a => Array a -> Set a
fromArray array =
    Array.foldl set empty array


{-| Fold over the values in a set, in order from lowest to highest.

It costs O(n) calls of the function, from the lowest member to the highest.

-}
foldl : (a -> b -> b) -> b -> Set a -> b
foldl func initialState (Set_gren_builtin dict) =
    Dict.foldl (\key _ state -> func key state) initialState dict


{-| Fold over the values in a set, in order from highest to lowest.

It costs O(n) calls of the function, from the highest member to the lowest.

-}
foldr : (a -> b -> b) -> b -> Set a -> b
foldr func initialState (Set_gren_builtin dict) =
    Dict.foldr (\key _ state -> func key state) initialState dict


{-| Map a function onto a set, creating a new set with no duplicates.

It costs O(n log n): one call of the function and one `set` into a new tree for
each member.

-}
map : Ord b => (a -> b) -> Set a -> Set b
map func coll =
    foldl (\x xs -> set (func x) xs) empty coll


{-| Only keep elements that pass the given test.

    import Set exposing (Set)

    numbers : Set Int
    numbers =
        Set.fromArray [ -2, -1, 0, 1, 2 ]

    positives : Set Int
    positives =
        Set.keepIf (\x -> x > 0) numbers

    -- positives == Set.fromArray [1,2]

It costs O(n log n): it sets each member that passes into a new tree, though
the members arrive in order.

-}
keepIf : Ord a => (a -> Bool) -> Set a -> Set a
keepIf isGood (Set_gren_builtin dict) =
    Set_gren_builtin (Dict.keepIf (\key _ -> isGood key) dict)


{-| Remove unwanted results of a map operation.
    
    import Set

    strings : Set String
    strings =
        Set.fromArray [ "3", "not a number", "-5" ]

    numbers : Set Int
    numbers =
        Set.mapAndKeepJust String.toInt strings

    -- numbers == Set.fromArray [ 3, -5 ]

It costs O(n log n): one call of the function and one `set` into a new tree for
each `Just`.

-}
mapAndKeepJust : Ord b => (a -> Maybe b) -> Set a -> Set b
mapAndKeepJust toMaybe coll =
    foldl
        (\old news ->
            when toMaybe old is
                Just new ->
                    set new news

                Nothing ->
                    news
        )
        empty
        coll


{-| Create two new sets. The first contains all the elements that passed the
given test, and the second contains all the elements that did not.

It costs O(n log n): it sets each member into one of two new trees, though the
members arrive in order.

-}
partition : Ord a => (a -> Bool) -> Set a -> { trues : Set a, falses : Set a }
partition isGood (Set_gren_builtin dict) =
    let
        { trues, falses } =
            Dict.partition (\key _ -> isGood key) dict
    in
    { trues = Set_gren_builtin trues
    , falses = Set_gren_builtin falses
    }



-- `Set` is a `Dict` whose values are `{}`, so it inherits `Dict`'s problem and
-- its answer both: same members, different insertion orders, different tree
-- shapes, and they must compare equal (`classes.md` §2.5).
--
-- Written over `toArray` rather than over the wrapped dictionary, which would
-- read `eq (Set_gren_builtin a) (Set_gren_builtin b) = a == b`. That version is
-- shorter and asks for `Eq (Dict a {})`, whose second argument is an empty
-- record — a witness the resolver would have to build out of no fields at all
-- (D140). It is the right answer for a question this instance does not need to
-- ask.


instance Eq a => Eq (Set a) where
    eq a b =
        toArray a == toArray b


-- `representation.md` R5: `Set [1, 2]`, the other half of what the kernel's
-- `Debug.js` special case did by hand.


instance Inspect a => Inspect (Set a) where
    inspect members =
        Inspect.ctor "Set" [ inspect (toArray members) ]

    inspectAnnotation _ =
        Inspect.none
