module Math exposing
    ( round, floor, ceiling, truncate
    , abs, sqrt, logBase
    , e, pi, maxSafeInteger, minSafeInteger, maxFloat, minFloat
    , degrees, radians, turns
    , cos, sin, tan, acos, asin, atan, atan2
    )

{-| Functions for doing math

@docs round, floor, ceiling, truncate, abs, sqrt, logBase

The first four are `Float -> Int`, and `docs/arithmetic.md` A10 makes them
**saturate**: a value too large for an `Int` becomes `2147483647`, one too
small becomes `-2147483648`, and a `NaN` becomes `0`. The same four exist at
each of D2's other integer widths, in that width's own module --
[Int64.round](Int64#round), [UInt32.floor](UInt32#floor) and so on -- and
these are the `Int` ones because `Int` has no module of its own (D152).

`modBy` and `remainderBy` used to be here and are `Basics`'s now: they are
`Integral`'s methods, so they live where the class does, beside the `//` and
`divFloor` each of them is the remainder of (`docs/arithmetic.md` A11).


## Constants

@docs e, pi, maxSafeInteger, minSafeInteger, maxFloat, minFloat


## Angles

@docs degrees, radians, turns


## Trigonometry

@docs cos, sin, tan, acos, asin, atan, atan2


-}

import Basics exposing (Int, Float, Num, Ord, Fractional, (==), (/), (*), (+), (-), (<), (>=))
import Gren.Kernel.Math


{-| Round a number to the nearest integer, **saturating** at `Int`'s bounds.

    round 1.0 == 1

    round 1.2 == 1

    round 1.5 == 2

    round 1.8 == 2

    round -1.2 == -1

    round -1.5 == -1

    round -1.8 == -2

A tie goes towards positive infinity, which is why `round -1.5` is `-1` rather
than `-2`. `docs/arithmetic.md` A10 says what happens when the answer does not
fit in an `Int`, and it is the same at all four of these:

    round 1.0e30 == 2147483647

    round (0 / 0) == 0

-}
round : Float -> Int
round x =
    fromIntegralFloat (roundFloat x)


{-| Floor function, rounding down, **saturating** at `Int`'s bounds.

    floor 1.0 == 1

    floor 1.2 == 1

    floor 1.5 == 1

    floor 1.8 == 1

    floor -1.2 == -2

    floor -1.5 == -2

    floor -1.8 == -2

    floor -1.0e30 == -2147483648

-}
floor : Float -> Int
floor x =
    fromIntegralFloat (floorFloat x)


{-| Ceiling function, rounding up, **saturating** at `Int`'s bounds.

    ceiling 1.0 == 1

    ceiling 1.2 == 2

    ceiling 1.5 == 2

    ceiling 1.8 == 2

    ceiling -1.2 == -1

    ceiling -1.5 == -1

    ceiling -1.8 == -1

-}
ceiling : Float -> Int
ceiling x =
    fromIntegralFloat (ceilFloat x)


{-| Truncate a number, rounding towards zero, **saturating** at `Int`'s bounds.

    truncate 1.0 == 1

    truncate 1.2 == 1

    truncate 1.5 == 1

    truncate 1.8 == 1

    truncate -1.2 == -1

    truncate -1.5 == -1

    truncate -1.8 == -1

-}
truncate : Float -> Int
truncate x =
    fromIntegralFloat (truncFloat x)


-- THE FOUR ABOVE, AND WHY THEY ARE NO LONGER ONE KERNEL CALL EACH
--
-- Each of them was `Gren.Kernel.Math`'s function of the same name until D2, and
-- a kernel call is the one thing they cannot be now: JavaScript's `Math.round`
-- answers a double, so `round 1.0e30` typed `Int` would hold `1e30` and D2's
-- deliverable -- an `Int`-typed expression always holds an integer -- would not
-- be true. So each is the float-to-float rounding primitive its name means,
-- followed by A10's saturating narrowing.
--
-- The same four exist at the other three integer widths, as `Int64.round`,
-- `UInt32.floor` and so on. **D152 is why `Int`'s are here** and not in a
-- module called `Int`: D151 puts a conversion in the module of the type it
-- produces, `Int` has no module for the same reason `Int64.toInt` exists, and
-- `Math` is where a Gren programmer has always looked for `round`.
--
-- They narrow through `f64_to_i32_trunc` rather than through `Int64`, which is
-- the reason `Core.Prim` carries that entry beside `f64_to_i64_trunc`: on
-- JavaScript this is a coercion and the path through `Int64` would be a
-- `BigInt` round trip in the most common conversion in the language.


@prim("f64_floor")
floorFloat : Float -> Float


@prim("f64_ceil")
ceilFloat : Float -> Float


@prim("f64_trunc")
truncFloat : Float -> Float


@prim("f64_to_i32_trunc")
truncToInt : Float -> Int


-- Round to nearest as a `Float`, ties towards positive infinity.
--
-- **Not `floorFloat (x + 0.5)`**, which is the spelling this asks for and is
-- wrong at one input: `0.49999999999999994 + 0.5` rounds up to exactly `1.0` in
-- double precision, so that version answers `1` where every other language
-- answers `0`. Taking the difference *after* the floor cannot round, because
-- `x - floorFloat x` is exact for every finite `x` -- the fraction bits it
-- keeps are a subset of the ones `x` already had.
--
-- A `NaN` or an infinity comes back unchanged, by both branches: `floorFloat`
-- answers the value itself, the difference is a `NaN`, `NaN < 0.5` is `False`
-- because A2's total order puts a `NaN` at the top, and adding one to a `NaN`
-- or an infinity is that value again. `fromIntegralFloat` is what turns them
-- into A10's answers.
roundFloat : Float -> Float
roundFloat x =
    let
        down =
            floorFloat x
    in
    if x - down < 0.5 then
        down

    else
        down + 1


-- A10's saturation, at `Int`'s two bounds. The argument is already integral, so
-- all that is left to decide is whether it fits.
--
-- **The `NaN` test comes first and it has to.** A2's `Ord Float` is a total
-- order that puts a `NaN` above every number, so `x >= 2147483648.0` is `True`
-- for one; test the bounds first and every `NaN` saturates to `2147483647`
-- instead of answering the `0` A10 asks for.
--
-- The bounds are written as the powers of two that bracket the type rather than
-- as `minValue` and `maxValue`, because what is being tested is
-- `f64_to_i32_trunc`'s precondition -- finite, and inside 2^31 -- and not the
-- value's fit. Both are exactly representable, so neither comparison rounds.
fromIntegralFloat : Float -> Int
fromIntegralFloat x =
    if isNaN x then
        0

    else if x >= 2147483648.0 then
        2147483647

    else if x < -2147483648.0 then
        -2147483648

    else
        truncToInt x


{-| Get the [absolute value][abs] of a number.

    abs 16 == 16

    abs -4 == 4

    abs -8.5 == 8.5

    abs 3.14 == 3.14

[abs]: https://en.wikipedia.org/wiki/Absolute_value

-}
abs : (Num a, Ord a) => a -> a
abs n =
    if n < 0 then
        -n

    else
        n

{-| Take the square root of a number.

    sqrt 4 == 2

    sqrt 9 == 3

    sqrt 16 == 4

    sqrt 25 == 5

-}
sqrt : Float -> Float
sqrt =
    Gren.Kernel.Math.sqrt


{-| Calculate the logarithm of a number with a given base.

    logBase 10 100 == 2

    logBase 2 256 == 8

-}
logBase : Float -> Float -> Float
logBase base number =
    if base == 10 then
        Gren.Kernel.Math.log10 number

    else
        (Gren.Kernel.Math.log number) / (Gren.Kernel.Math.log base)


-- ANGLES


{-| Convert radians to standard Gren angles (radians).

    radians pi == 3.141592653589793

-}
radians : Float -> Float
radians angleInRadians =
    angleInRadians


{-| Convert degrees to standard Gren angles (radians).

    degrees 180 == 3.141592653589793

-}
degrees : Float -> Float
degrees angleInDegrees =
    (angleInDegrees * pi) / 180


{-| Convert turns to standard Gren angles (radians). One turn is equal to 360°.

    turns (1 / 2) == 3.141592653589793

-}
turns : Float -> Float
turns angleInTurns =
    (2 * pi) * angleInTurns


-- CONSTANTS


{-| An approximation of e.
-}
e : Float
e =
    Gren.Kernel.Math.e


{-| An approximation of pi.
-}
pi : Float
pi =
    Gren.Kernel.Math.pi


{-| The largest integer value that can be exactly represented and compared in a JavaScript environment.
Integers above this value may not work as you expect.
-}
maxSafeInteger : Int
maxSafeInteger =
    Gren.Kernel.Math.maxSafeInteger


{-| The smallest integer value that can be exactly represented and compared in a JavaScript environment.
Integers below this value may not work as you expect.
-}
minSafeInteger : Int
minSafeInteger =
    Gren.Kernel.Math.minSafeInteger


{-| The largest `Float` value.
-}
maxFloat : Float
maxFloat =
    Gren.Kernel.Math.maxFloat


{-| The smallest `Float` value.
-}
minFloat : Float
minFloat =
    -maxFloat


-- TRIGONOMETRY


{-| Figure out the cosine given an angle in radians.

    cos (degrees 60) == 0.5000000000000001

    cos (turns (1 / 6)) == 0.5000000000000001

    cos (radians (pi / 3)) == 0.5000000000000001

    cos (pi / 3) == 0.5000000000000001

-}
cos : Float -> Float
cos =
    Gren.Kernel.Math.cos


{-| Figure out the sine given an angle in radians.

    sin (degrees 30) == 0.49999999999999994

    sin (turns (1 / 12)) == 0.49999999999999994

    sin (radians (pi / 6)) == 0.49999999999999994

    sin (pi / 6) == 0.49999999999999994

-}
sin : Float -> Float
sin =
    Gren.Kernel.Math.sin


{-| Figure out the tangent given an angle in radians.

    tan (degrees 45) == 0.9999999999999999

    tan (turns (1 / 8)) == 0.9999999999999999

    tan (radians (pi / 4)) == 0.9999999999999999

    tan (pi / 4) == 0.9999999999999999

-}
tan : Float -> Float
tan =
    Gren.Kernel.Math.tan


{-| Figure out the arccosine for `adjacent / hypotenuse` in radians:

    acos (1 / 2) == 1.0471975511965979 -- 60° or pi/3 radians

-}
acos : Float -> Float
acos =
    Gren.Kernel.Math.acos


{-| Figure out the arcsine for `opposite / hypotenuse` in radians:

    asin (1 / 2) == 0.5235987755982989 -- 30° or pi/6 radians

-}
asin : Float -> Float
asin =
    Gren.Kernel.Math.asin


{-| This helps you find the angle (in radians) to an `(x,y)` coordinate, but
in a way that is rarely useful in programming. **You probably want
[`atan2`](#atan2) instead!**

This version takes `y/x` as its argument, so there is no way to know whether
the negative signs comes from the `y` or `x` value. So as we go counter-clockwise
around the origin from point `(1,1)` to `(1,-1)` to `(-1,-1)` to `(-1,1)` we do
not get angles that go in the full circle:

    atan (1 / 1) == 0.7853981633974483 --  45° or   pi/4 radians

    atan (1 / -1) == -0.7853981633974483 -- 315° or 7*pi/4 radians

    atan (-1 / -1) == 0.7853981633974483 --  45° or   pi/4 radians

    atan (-1 / 1) == -0.7853981633974483 -- 315° or 7*pi/4 radians

Notice that everything is between `pi/2` and `-pi/2`. That is pretty useless
for figuring out angles in any sort of visualization, so again, check out
[`atan2`](#atan2) instead!

-}
atan : Float -> Float
atan =
    Gren.Kernel.Math.atan


{-| This helps you find the angle (in radians) to an `(x,y)` coordinate.
So rather than saying `atan (y/x)` you say `atan2 y x` and you can get a full
range of angles:

    atan2 1 1 == 0.7853981633974483 --  45° or   pi/4 radians

    atan2 1 -1 == 2.356194490192345 -- 135° or 3*pi/4 radians

    atan2 -1 -1 == -2.356194490192345 -- 225° or 5*pi/4 radians

    atan2 -1 1 == -0.7853981633974483 -- 315° or 7*pi/4 radians

-}
atan2 : Float -> Float -> Float
atan2 =
    Gren.Kernel.Math.atan2
