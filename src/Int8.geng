module Int8 exposing
    ( minValue, maxValue
    , toInt
    , fromInt, fromIntWrap, fromIntChecked
    , toFloat
    )

{-| The bounds and the conversions of an 8-bit signed integer.

The **type** is [Basics.Int8](Basics#Int8), so `+`, `//`, `modBy` and
`Bitwise.shiftLeftBy` all work on one with no import, and wrap at its width
(`docs/arithmetic.md` A6). A literal is given the type by an annotation:
`(127 : Int8)`.

**When to use one.** For a signed byte in a binary format, or a C `int8_t` or a Java `byte` across an extern. It is not smaller in memory than an `Int`
anywhere but inside a `Bytes`, and it is not faster: every operation is `Int`'s
and a wrap (`docs/arithmetic.md` A12).

**It converts through `Int` and nothing else** (D342). An `Int64` becomes one
through [Int64.toInt](Int64#toInt) first, and a `Float` through
[Math.round](Math#round) or its siblings.


## Bounds

@docs minValue, maxValue


## To an `Int`

Every `Int8` is an `Int`, so this has one name and no variants.

@docs toInt


## From an `Int`

A10's three names: saturating, the low bits, and `Maybe`.

@docs fromInt, fromIntWrap, fromIntChecked


## To a float

@docs toFloat

-}

import Basics exposing (Float, Int, Int8, Num, Ord, (<), (>))
import Maybe exposing (Maybe(..))


-- BOUNDS


{-| `-128`.
-}
minValue : Int8
minValue =
    -128


{-| `127`.
-}
maxValue : Int8
maxValue =
    127



-- TO AN INT


{-| Widen to an `Int`. Exact.

    Int8.toInt Int8.maxValue == 127

-}
@prim("i8_to_i32")
toInt : Int8 -> Int



-- FROM AN INT


{-| Narrow an `Int`, **saturating** at both of this type's bounds.

    Int8.fromInt 42 == (42 : Int8)

    Int8.fromInt -129 == Int8.minValue

    Int8.fromInt 100000 == Int8.maxValue

-}
fromInt : Int -> Int8
fromInt n =
    if n < -128 then
        minValue

    else if n > 127 then
        maxValue

    else
        fromIntWrap n


{-| Narrow an `Int` by keeping its **low 8 bits**, read as signed.

    Int8.fromIntWrap 128 == Int8.minValue

-}
@prim("i32_to_i8")
fromIntWrap : Int -> Int8


{-| Narrow an `Int`, or `Nothing` when it does not fit.

    Int8.fromIntChecked 42 == Just (42 : Int8)

    Int8.fromIntChecked 128 == Nothing

-}
fromIntChecked : Int -> Maybe Int8
fromIntChecked n =
    if n < -128 then
        Nothing

    else if n > 127 then
        Nothing

    else
        Just (fromIntWrap n)



-- TO A FLOAT


{-| Convert to a `Float`. Exact.

    Int8.toFloat Int8.maxValue == 127.0

-}
toFloat : Int8 -> Float
toFloat n =
    Basics.toFloat (toInt n)
