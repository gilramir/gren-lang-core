module Array exposing
    ( Array
    , singleton, initialize, repeat, range
    , map, indexedMap, foldl, foldr, indexedFoldl, indexedFoldr, keepIf, indexedKeepIf, mapAndKeepJust, reverse
    , isEmpty, length, get, findFirst, findLast, member, any, all, minimum, maximum
    , set, setMany, update, insert, insertMany, remove, removeMany, pushFirst, pushLast, splice
    , prepend, append, flatten, mapAndFlatten, intersperse, map2, map3
    , first, last, slice, dropFirst, dropLast, takeFirst, takeLast, popFirst, popLast, partition
    , sort, sortBy, sortWith
    )

{-| You can create an `Array` using the `[1, 2, 3]` syntax. This module has a bunch of
functions to help you work with them.

@docs Array

@docs singleton, initialize, repeat, range


## Transform

@docs map, indexedMap, foldl, foldr, indexedFoldl, indexedFoldr, keepIf, indexedKeepIf, mapAndKeepJust, reverse


## Query

@docs isEmpty, length, get, first, last, findFirst, findLast, member, any, all, minimum, maximum


## Modify

@docs set, setMany, update, insert, insertMany, remove, removeMany, pushFirst, pushLast, splice


## Combine

@docs prepend, append, flatten, mapAndFlatten, intersperse, map2, map3


## Deconstruct

@docs slice, takeFirst, takeLast, dropFirst, dropLast, popFirst, popLast, partition


## Sort

@docs sort, sortBy, sortWith


-}

import Basics exposing (..)
import Maybe exposing (Maybe(..))
import Array.Transient as T exposing (Transient)


{-| An Array is an ordered collection of elements.
-}
type Array a
    = Array a


-- CREATE


{-| Create an array containing a single value.
-}
singleton : a -> Array a
singleton a =
    [ a ]


{-| Create an array of `n` elements, containing the elements
resulting from calling `fn` with `offset + index`.

    initialize 3 5 identity == [ 5, 6, 7 ]

In the above example, we create an array containing 3 integers
starting at 5.
-}
initialize : Int -> Int -> (Int -> a) -> Array a
initialize len offset fn =
    -- A count below one is the empty array, not a crash: the kernel's
    -- `new Array(size)` threw `RangeError: Invalid array length` for a
    -- negative one, where every other size-shaped argument in this module
    -- answers empty (D242, `m1b-arr-prim.md` §AR5.4). Stock Gren still throws.
    if lt len 1 then
        []

    else
        transientToArray (initializeHelp fn offset 0 len (T.new len))


{-| Create an array with `n` copies of a value:

    repeat 5 3 == [ 3, 3, 3, 3, 3 ]

-}
repeat : Int -> a -> Array a
repeat n val =
    initialize n 0 (\_ -> val)


{-| Create an array of numbers, every element increasing by one. You give the lowest and highest number that should be in the array.

    range 3 6 == [3, 4, 5, 6]
    range 3 3 == [3]
    range 6 3 == []

-}
range : Int -> Int -> Array Int
range from to =
    if from > to then
        []

    else if from == to then
        [from]

    else 
        initialize (to - from + 1) from identity


-- TRANSFORM


{-| Apply a function on every element in an array.

    map negate [ 1, 4, 9 ] == [ -1, -4, -9 ]

So `map func [ a, b, c ]` is the same as `[ func a, func b, func c ]`

-}
map : (a -> b) -> Array a -> Array b
map fn array =
    let
        len =
            unsafeLength array
    in
    transientToArray (mapHelp fn array 0 len (T.new len))


{-| Same as `map` but the function is also applied to the index of each element.

    indexedMap (\idx val -> [idx, val]) [ 3, 3, 3 ] == [ [ 0, 3 ], [ 1, 3 ], [ 2, 3 ] ]

-}
indexedMap : (Int -> a -> b) -> Array a -> Array b
indexedMap fn array =
    let
        len =
            unsafeLength array
    in
    transientToArray (indexedMapHelp fn array 0 len (T.new len))


{-| Reduce the array from the left.

    foldl (+) 0 [ 1, 2, 3 ] == 6

So `foldl step state [ 1, 2, 3 ]` is like saying:

    state
        |> step 1
        |> step 2
        |> step 3
-}
foldl : (a -> b -> b) -> b -> Array a -> b
foldl fn acc array =
    foldlHelp fn acc array 0 (unsafeLength array)


{-| Reduce the array from the right. Same as `foldl` but
the execution order is reversed.
-}
foldr : (a -> b -> b) -> b -> Array a -> b
foldr fn acc array =
    foldrHelp fn acc array (add (unsafeLength array) -1)


{-| Reduce the array from the left. The reducing function is 
passed the index of the current value.

    indexedFoldl (\idx val sum -> idx + val + sum) 0 [ 1, 2, 3 ] == 9

-}
indexedFoldl : (Int -> a -> b -> b) -> b -> Array a -> b
indexedFoldl fn acc array =
    indexedFoldlHelp fn acc array 0 (unsafeLength array)


{-| Reduce the array from the right. The reducing function
is passed the index of the current value. Same as `indexedFoldl`
but the execution order is reversed.
-}
indexedFoldr : (Int -> a -> b -> b) -> b -> Array a -> b
indexedFoldr fn acc array =
    indexedFoldrHelp fn acc array (add (unsafeLength array) -1)


{-| Keep values that pass the test.

    keepIf (\n -> n < 3) [ 1, 2, 3, 4 ] == [ 1, 2 ]

-}
keepIf : (a -> Bool) -> Array a -> Array a
keepIf fn array =
    let
        len =
            unsafeLength array
    in
    transientToArray (keepIfHelp fn array 0 len (T.new len))

{-| Same as `keepIf` but the test is also applied to the index of each element.

    indexedKeepIf (\idx val -> idx + val > 4) [ 1, 2, 3, 4 ] == [ 3, 4 ]
-}
indexedKeepIf : (Int -> a -> Bool) -> Array a -> Array a
indexedKeepIf fn array =
    let
        len =
            unsafeLength array
    in
    transientToArray (indexedKeepIfHelp fn array 0 len (T.new len))


{-| Remove unwanted results of a map operation.

    mapAndKeepJust String.toInt [ "3", "not a number", "-5" ] == [ 3, -5 ]
    mapAndKeepJust identity [ Just 1, Nothing ] == [ 1 ]

-}
mapAndKeepJust : (a -> Maybe b) -> Array a -> Array b
mapAndKeepJust mapper array =
    mapAndFlatten
        (\v ->
            when mapper v is
                Just newValue ->
                    [ newValue ]

                Nothing ->
                    []
        )
        array


{-| Reverse an array.

    reverse [ 1, 2, 3 ] == [ 3, 2, 1 ]

-}
reverse : Array a -> Array a
reverse array =
    let
        len =
            unsafeLength array
    in
    transientToArray (reverseHelp array (add len -1) (T.new len))


-- QUERY


{-| Check if an array is empty.

    isEmpty [] == True
    isEmpty [ 1, 2, 3 ] == False

-}
isEmpty : Array a -> Bool
isEmpty array =
    length array == 0


{-| Return the length of an array.

    length [ 1, 2, 3 ] == 3

-}
length : Array a -> Int
length array =
    unsafeLength array


{-| `arr_length`, which `length` is, under a name the helpers can call without
going through the exposed one.
-}
@prim("arr_length")
unsafeLength : Array a -> Int


{-| Retrieve the element at a given index, or `Nothing` if the index is out of bounds.
A negative index looks up an element in reverse from the end of the array.

    get 1 [ 1, 2, 3 ] == Just 2
    get 10 [ 1, 2, 3 ] == Nothing
    get -1 [ 1, 2, 3 ] == Just 3

-}
get : Int -> Array a -> Maybe a
get index array =
    let
        len =
            unsafeLength array

        actual =
            if lt index 0 then
                add len index

            else
                index
    in
    if lt actual 0 || not (lt actual len) then
        Nothing

    else
        Just (unsafeGet array actual)


{-| Find the first value that passes the test.

    findFirst (\n -> n > 0) [ -1, 0, 1, 2 ] == Just { index = 2, value = 1 }

-}
findFirst : (a -> Bool) -> Array a -> Maybe { index : Int, value : a }
findFirst fn array =
    findFirstHelp fn array 0 (unsafeLength array)


{-| Find the last value that passes the test.

    findLast (\n -> n > 0) [ -1, 0, 1, 2 ] == Just { index = 3, value = 2 }

-}
findLast : (a -> Bool) -> Array a -> Maybe { index : Int, value : a }
findLast fn array =
    findLastHelp fn array (add (unsafeLength array) -1)


{-| Figure out whether an array contains a value.

    member 9 [1,2,3,4] == False
    member 4 [1,2,3,4] == True

-}
member : Eq a => a -> Array a -> Bool
member value array =
    when findFirst (\v -> v == value) array is
        Just _ ->
            True

        Nothing ->
            False


{-| Determine if any elements pass the test.

    any isEven [2,3] == True
    any isEven [1,3] == False
    any isEven [] == False

-}
any : (a -> Bool) -> Array a -> Bool
any fn array =
    when findFirst fn array is
        Just _ ->
            True

        Nothing ->
            False


{-| Determine if all elements pass the test.

    all isEven [2,4] == True
    all isEven [2,3] == False
    all isEven [] == True

-}
all : (a -> Bool) -> Array a -> Bool
all fn array =
    when findFirst (not << fn) array is
        Just _ ->
            False

        Nothing ->
            True


{-| Find the minimum element in a non-empty array.

    minimum [3,2,1] == Just 1
    minimum []      == Nothing

-}
minimum : Ord a => Array a -> Maybe a
minimum array =
    when first array is
        Nothing ->
            Nothing

        Just val ->
            Just <|
                foldl
                    (\current lowest ->
                        if current < lowest then
                            current

                        else
                            lowest
                    )
                    val
                    array


{-| Find the maximum element in a non-empty array.

    maximum [3,2,1] == Just 3
    maximum []      == Nothing

-}
maximum : Ord a => Array a -> Maybe a
maximum array =
    when first array is
        Nothing ->
            Nothing

        Just val ->
            Just <|
                foldl
                    (\current highest ->
                        if current > highest then
                            current

                        else
                            highest
                    )
                    val
                    array


-- MODIFY


{-| Replace the element at the given index, or return the array unmodified if the index is out of bounds.
Passing a negative index means you want to replace an element counting backwards from the end of the array.

    set 1 10 [ 1, 2, 3 ] == [ 1, 10, 3 ]
    set 10 10 [ 1, 2, 3 ] == [ 1, 2, 3 ]
    set -1 10 [ 1, 2, 3 ] == [ 1, 2, 10 ]

-}
set : Int -> a -> Array a -> Array a
set index value array =
    let
        len =
            unsafeLength array

        actual =
            if lt index 0 then
                add len index

            else
                index
    in
    if lt actual 0 || not (lt actual len) then
        array

    else
        primSet array actual value


{-| This function works just like [set](#set) except it takes in an array of values to set, allowing you
to replace several values at once.

If the provided index is out of bounds, elements will be added at the beginning (negative index) or at the
end (positive index).

    setMany 1 [ 0, 0 ] [ 1, 2, 3, 4 ] == [ 1, 0, 0, 4 ]

-}
setMany : Int -> Array a -> Array a -> Array a
setMany index values array =
    splice index (length values) values array


{-| Update a value at the given index using a function. If the index is out of bounds, nothing happens.

    update 1 (\n -> n + 1) [ 1, 2, 3 ] == [ 1, 3, 3 ]
    update 10 (\n -> n + 1) [ 1, 2, 3 ] == [ 1, 2, 3 ]

-}
update : Int -> (a -> a) -> Array a -> Array a
update idx fn array =
    when get idx array is
        Nothing ->
            array

        Just val ->
            set idx (fn val) array


{-| Insert a new value into the array at the given index. The value already at the
given index, as well as all subsequent values, will be moved one space to the right.

Passing a negative index means you want to replace an element counting backwards from the end of the array.

If the provided index is out of bounds, the element will be added at the beginning (negative index) or at the
end (positive index).

    insert 1 0 [ 1, 2, 3 ] == [ 1, 0, 2, 3 ]

-}
insert : Int -> a -> Array a -> Array a
insert index value array =
    primInsert array (spliceStart index (unsafeLength array)) value


{-| This function works just like [insert](#insert) but allows you to insert multiple
values at once.

    insertMany 1 [ 0, 0 ] [ 1, 2, 3 ] == [ 1, 0, 0, 2, 3 ]

-}
insertMany : Int -> Array a -> Array a -> Array a
insertMany index values array =
    splice index 0 values array


{-| Remove an element from an array.

Passing a negative index means you want to replace an element counting backwards from the end of the array.

If the index is out of bounds, no element will be removed.

    remove 1 [ 1, 2, 3 ] == [ 1, 3 ]

-}
remove : Int -> Array a -> Array a
remove index array =
    removeMany index 1 array


{-| This function works just like [remove](#remove), except it allows you to remove multiple elements at once.

The first argument is the index from where to remove elements from, the second argument is the number of elements
to remove.

    remove 0 2 [ 1, 2, 3 ] == [ 3 ]

-}
removeMany : Int -> Int -> Array a -> Array a
removeMany index toRemove array =
    let
        len =
            unsafeLength array

        start =
            spliceStart index len

        count =
            clamp 0 (subtract len start) toRemove
    in
    if count == 0 then
        array

    else if count == 1 then
        primRemove array start

    else
        primAppend
            (primSlice array 0 start)
            (primSlice array (add start count) len)


{-| Add a value to the start of the array.

    pushFirst 1 []          == [ 1 ]
    pushFirst 5 [ 1, 4, 9 ] == [ 5, 1, 4, 9 ]

-}
pushFirst : a -> Array a -> Array a
pushFirst value array =
    primAppend [ value ] array


{-| Add a value to the end of the array.

    pushLast 1 []          == [ 1 ]
    pushLast 5 [ 1, 4, 9 ] == [ 1, 4, 9, 5 ]

-}
pushLast : a -> Array a -> Array a
pushLast value array =
    primAppend array [ value ]


{-| Allows you to perform multiple modifications in a single operation. Splice takes an index
as its first argument. This marks the point where modifications will be performed. The
second argument is the number of elements to remove. The third argument is the elements that
will be inserted. The argument order represents the order of modifications. Elements will be
removed before new elements are inserted.

Passing a negative index means you want to replace an element counting backwards from the end of the array.

If the index is out of bounds no elements will be removed, but elements will be added at the
beginning (negative index) or at the end (positive index).


    splice 2 0 [ 0 ] [ 1, 2, 3 ] == [ 1, 2, 0, 3 ]
    splice 2 1 [ 0 ] [ 1, 2, 3 ] == [ 1, 2, 0 ]
    splice 2 1 [] [ 1, 2, 3 ] == [ 1, 2 ]

-}
splice : Int -> Int -> Array a -> Array a -> Array a
splice index toRemove values array =
    let
        len =
            unsafeLength array

        start =
            spliceStart index len

        count =
            clamp 0 (subtract len start) toRemove
    in
    if unsafeLength values == 0 then
        removeMany start count array

    else
        primAppend
            (primAppend (primSlice array 0 start) values)
            (primSlice array (add start count) len)


-- COMBINE


{-| Combine two arrays so that the first array becomes the prefix,
and the second array becomes the postfix of the resulting array.

    prepend [ 1, 2, 3 ] [ 4, 5, 6 ] == [ 1, 2, 3, 4, 5, 6 ] 

You can also use the `++` operator for this purpose.

    [ 1, 2, 3 ] ++ [ 4, 5, 6 ] == [ 1, 2, 3, 4, 5, 6 ]
-}
prepend : Array a -> Array a -> Array a
prepend left right =
    primAppend left right


{-| Combine two arrays so that the first array becomes the postfix,
and the second array becomes the prefix of the resulting array.

    append [ 1, 2, 3 ] [ 4, 5, 6 ] == [ 4, 5, 6, 1, 2, 3 ]
    
-}
append : Array a -> Array a -> Array a
append fst second =
    prepend second fst


{-| Combine a bunch of arrays into a single array.

    flatten [ [ 1 ], [ 2 ], [ 4, 5 ] ] == [ 1, 2, 4, 5 ]

-}
flatten : Array (Array a) -> Array a
flatten arrays =
    transientToArray (flattenHelp arrays 0 (unsafeLength arrays) (T.new 0))


{-| Map a given function onto an array, then flatten the resulting array.

    mapAndFlatten f xs == flatten (map f xs)

-}
mapAndFlatten : (a -> Array b) -> Array a -> Array b
mapAndFlatten fn array =
    transientToArray (mapAndFlattenHelp fn array 0 (unsafeLength array) (T.new 0))


{-| Places the given value between all members of the given array.

    intersperse "on" [ "turtles", "turtles", "turtles"] == [ "turtles", "on", "turtles", "on", "turtles"]

-}
intersperse : a -> Array a -> Array a
intersperse sep xs =
    when popFirst xs is
        Nothing ->
            []

        Just { first = head, rest = tail } ->
            pushFirst head <| mapAndFlatten (\val -> [ sep, val ]) tail


{-| Combine two arrays, combining them with the given function.
If one array is longer, the extra elements are dropped.

    map2 (\x y -> { x = x, y = y }) [ 1 ] [ 2 ] == [ { x = 1, y = 2 } ]
-}
map2 : (a -> b -> result) -> Array a -> Array b -> Array result
map2 fn xs ys =
    let
        len =
            min (unsafeLength xs) (unsafeLength ys)
    in
    transientToArray (map2Help fn xs ys 0 len (T.new len))


{-| Combine three arrays, combining them with the given function.
If one array is longer, the extra elements are dropped.

    map3 (\x y z -> { x = x, y = y, z = z }) [ 1 ] [ 2 ] [ 3 ] == [ { x = 1, y = 2, z = 3 } ]
-}
map3 : (a -> b -> c -> result) -> Array a -> Array b -> Array c -> Array result
map3 fn xs ys zs =
    let
        len =
            min (min (unsafeLength xs) (unsafeLength ys)) (unsafeLength zs)
    in
    transientToArray (map3Help fn xs ys zs 0 len (T.new len))


-- DECONSTRUCT


{-| Retrieve the first element of the array, if it exists.

    first [ 1, 2, 3 ] == Just 1

-}
first : Array a -> Maybe a
first array =
    get 0 array


{-| Retrieve the last element of the array, if it exists.

    last [ 1, 2, 3 ] == Just 3

-}
last : Array a -> Maybe a
last array =
    get -1 array


{-| Get a sub section of an array: `(slice start end array)`.

The `start` is a zero-based index where we will start our slice.
The `end` is a zero-based index that indicates the end of the slice.
The slice extracts up to, but no including, the `end`.

Both `start` and `end` can be negative, indicating an offset from the end
of the array. Removing the last element of the array can be expressed as:

    `slice 0 -1 arr`.

In the case of an impossible slice, the empty array is returned.

-}
slice : Int -> Int -> Array a -> Array a
slice from to array =
    let
        len =
            unsafeLength array

        start =
            sliceBound from len

        end =
            sliceBound to len
    in
    if not (lt start end) then
        []

    else
        primSlice array start end


{-| Remove the first `n` elements of the array.

    dropFirst 5 [ 1 ] == []
    dropFirst 1 [ 1, 2, 3 ] == [ 2, 3 ]

-}
dropFirst : Int -> Array a -> Array a
dropFirst n array =
    slice n (length array) array


{-| Remove the last `n` elements of the array.

    dropLast 1 [ 1, 2, 3 ] == [ 1, 2 ]

-}
dropLast : Int -> Array a -> Array a
dropLast n array =
    slice 0 (length array - n) array


{-| Take the first `n` elements from the array.

    takeFirst 2 [ 1, 2, 3 ] == [ 1, 2 ]

-}
takeFirst : Int -> Array a -> Array a
takeFirst n array =
    slice 0 n array


{-| Take the last `n` elements from the array.

    takeLast 2 [ 1, 2, 3 ] == [ 2, 3 ]

-}
takeLast : Int -> Array a -> Array a
takeLast n array =
    let
        len =
            length array
    in
    slice (len - n) len array


{-| Split an array into its first element, and its remaining elements, if possible.

    popFirst [ 1, 2, 3 ] == Just { first = 1, rest = [ 2, 3 ] }

-}
popFirst : Array a -> Maybe { first : a, rest : Array a }
popFirst array =
    when first array is
        Just value ->
            Just
                { first = value
                , rest = dropFirst 1 array
                }

        Nothing ->
            Nothing


{-| Split an array into its last element, and its remaining elements, if possible.

    popFirst [ 1, 2, 3 ] == Just { last = 3, initial = [ 1, 2 ] }

-}
popLast : Array a -> Maybe { last : a, initial : Array a }
popLast array =
    when last array is
        Just value ->
            Just
                { last = value
                , initial = dropLast 1 array
                }

        Nothing ->
            Nothing


{-| Divide elements into two arrays based on the result of a boolean test.

    partition (\x -> x < 3) [ 0, 1, 2, 3, 4, 5 ] == { trues = [ 0, 1, 2 ], falses = [ 3, 4, 5 ] }

-}
partition : (a -> Bool) -> Array a -> { trues : Array a, falses : Array a }
partition fn array =
    foldl
        (\val { trues, falses } ->
            if fn val then
                { trues = pushLast val trues
                , falses = falses
                }

            else
                { trues = trues
                , falses = pushLast val falses
                }
        )
        { trues = [], falses = [] }
        array


-- SORT


{-| Sort values from lowest to highest

    sort [ 3, 1, 5 ] == [ 1, 3, 5 ]

-}
sort : Ord a => Array a -> Array a
sort array =
    sortWith compare array


{-| Sort values by a derived property.

    sortBy String.length [ "mouse", "cat" ] == [ "cat", "mouse" ]

-}
sortBy : Ord b => (a -> b) -> Array a -> Array a
sortBy toKey array =
    sortWith (\x y -> compare (toKey x) (toKey y)) array


{-| Sort values with a custom comparison function.

    sortWith flippedComparison [1,2,3,4,5] == [5,4,3,2,1]

    flippedComparison a b =
        when compare a b is
          LT -> GT
          EQ -> EQ
          GT -> LT

This is also the most general sort function, allowing you to define any other: `sort == sortWith compare`

-}
sortWith : (a -> a -> Order) -> Array a -> Array a
sortWith fn array =
    let
        len =
            unsafeLength array
    in
    if lt len 2 then
        array

    else
        transientToArray (sortPasses fn (transientFromArray array) (transientFromArray array) 1 len)



-- An array is ordered lexicographically by its elements, which is what the
-- kernel's structural comparison did for a `comparable` array. Written in Gren
-- rather than in the kernel because the element's ordering is the witness the
-- instance is handed, and the kernel cannot call one.


instance Eq a => Eq (Array a) where
    eq a b =
        length a == length b && eqFrom 0 a b


instance Ord a => Ord (Array a) where
    compare a b =
        compareFrom 0 a b


-- No context, unlike `Ord (Array a)`: appending two arrays does not look at an
-- element, so there is nothing for the instance to be handed.


instance Appendable (Array a) where
    append a b =
        primAppend a b


-- The lengths are checked first because they are the cheap half and because
-- unequal lengths are the common answer; what is left is an element walk that
-- stops at the first difference. `Ord`'s cannot do that — it has to say which
-- way round the difference goes — which is why the two are not one function.


eqFrom : Eq a => Int -> Array a -> Array a -> Bool
eqFrom index a b =
    when get index a is
        Nothing ->
            True

        Just x ->
            when get index b is
                Nothing ->
                    False

                Just y ->
                    -- `eq x y && eqFrom …` reads better and is a stack overflow
                    -- past about 9,000 elements: `&&` is an expression, so the
                    -- call under it is not a tail call (D241,
                    -- `m1b-arr-prim.md` §AR5.2).
                    if eq x y then
                        eqFrom (index + 1) a b

                    else
                        False


compareFrom : Ord a => Int -> Array a -> Array a -> Order
compareFrom index a b =
    when get index a is
        Nothing ->
            when get index b is
                Nothing ->
                    EQ

                Just _ ->
                    LT

        Just x ->
            when get index b is
                Nothing ->
                    GT

                Just y ->
                    when compare x y is
                        EQ ->
                            compareFrom (index + 1) a b

                        order ->
                            order


-- THE PRIMITIVES, AND THE HELPERS OVER THEM
--
-- `unsafeGet` is `arr_get`: its index is in range, which every caller here has
-- checked. `transientFromArray` and `transientToArray` are the two `tr_`
-- operations that mention `Array`, so they cannot live in `Array.Transient`.
-- `lt` and `add` are the `Int` primitives, since `<` and `+` on `Int` reach
-- `Ord Int`'s `compare` (the open item on `Int` comparisons, §O12.6).


@prim("arr_get")
unsafeGet : Array a -> Int -> a


@prim("tr_from_array")
transientFromArray : Array a -> Transient a


@prim("tr_to_array")
transientToArray : Transient a -> Array a


@prim("i32_lt")
lt : Int -> Int -> Bool


@prim("i32_add")
add : Int -> Int -> Int


@prim("i32_sub")
subtract : Int -> Int -> Int


{-| Where a splice starts: a negative index counts from the end, and an index
past either end clamps, as `toSpliced` does.
-}
spliceStart : Int -> Int -> Int
spliceStart index len =
    if lt index 0 then
        if lt (add len index) 0 then
            0

        else
            add len index

    else if lt len index then
        len

    else
        index


{-| One end of a slice, under `Array.prototype.slice`'s rules — which are, term
for term, the rules `spliceStart` writes out for `toSpliced`'s index. The two
are kept apart because they are two rules that happen to agree, not one rule
used twice: a change to either is a change to one method's behaviour.
-}
sliceBound : Int -> Int -> Int
sliceBound index len =
    if lt index 0 then
        if lt (add len index) 0 then
            0

        else
            add len index

    else if lt len index then
        len

    else
        index


initializeHelp : (Int -> a) -> Int -> Int -> Int -> Transient a -> Transient a
initializeHelp fn offset index len acc =
    if lt index len then
        initializeHelp fn offset (add index 1) len (T.push acc (fn (add offset index)))

    else
        acc


mapHelp : (a -> b) -> Array a -> Int -> Int -> Transient b -> Transient b
mapHelp fn array index len acc =
    if lt index len then
        mapHelp fn array (add index 1) len (T.push acc (fn (unsafeGet array index)))

    else
        acc


indexedMapHelp : (Int -> a -> b) -> Array a -> Int -> Int -> Transient b -> Transient b
indexedMapHelp fn array index len acc =
    if lt index len then
        indexedMapHelp fn array (add index 1) len (T.push acc (fn index (unsafeGet array index)))

    else
        acc


foldlHelp : (a -> b -> b) -> b -> Array a -> Int -> Int -> b
foldlHelp fn acc array index len =
    if lt index len then
        foldlHelp fn (fn (unsafeGet array index) acc) array (add index 1) len

    else
        acc


foldrHelp : (a -> b -> b) -> b -> Array a -> Int -> b
foldrHelp fn acc array index =
    if lt index 0 then
        acc

    else
        foldrHelp fn (fn (unsafeGet array index) acc) array (add index -1)


indexedFoldlHelp : (Int -> a -> b -> b) -> b -> Array a -> Int -> Int -> b
indexedFoldlHelp fn acc array index len =
    if lt index len then
        indexedFoldlHelp fn (fn index (unsafeGet array index) acc) array (add index 1) len

    else
        acc


indexedFoldrHelp : (Int -> a -> b -> b) -> b -> Array a -> Int -> b
indexedFoldrHelp fn acc array index =
    if lt index 0 then
        acc

    else
        indexedFoldrHelp fn (fn index (unsafeGet array index) acc) array (add index -1)


keepIfHelp : (a -> Bool) -> Array a -> Int -> Int -> Transient a -> Transient a
keepIfHelp fn array index len acc =
    if lt index len then
        let
            value =
                unsafeGet array index
        in
        keepIfHelp fn array (add index 1) len
            (if fn value then
                T.push acc value

             else
                acc
            )

    else
        acc


indexedKeepIfHelp : (Int -> a -> Bool) -> Array a -> Int -> Int -> Transient a -> Transient a
indexedKeepIfHelp fn array index len acc =
    if lt index len then
        let
            value =
                unsafeGet array index
        in
        indexedKeepIfHelp fn array (add index 1) len
            (if fn index value then
                T.push acc value

             else
                acc
            )

    else
        acc


reverseHelp : Array a -> Int -> Transient a -> Transient a
reverseHelp array index acc =
    if lt index 0 then
        acc

    else
        reverseHelp array (add index -1) (T.push acc (unsafeGet array index))


findFirstHelp : (a -> Bool) -> Array a -> Int -> Int -> Maybe { index : Int, value : a }
findFirstHelp fn array index len =
    if lt index len then
        let
            value =
                unsafeGet array index
        in
        if fn value then
            Just { index = index, value = value }

        else
            findFirstHelp fn array (add index 1) len

    else
        Nothing


findLastHelp : (a -> Bool) -> Array a -> Int -> Maybe { index : Int, value : a }
findLastHelp fn array index =
    if lt index 0 then
        Nothing

    else
        let
            value =
                unsafeGet array index
        in
        if fn value then
            Just { index = index, value = value }

        else
            findLastHelp fn array (add index -1)


flattenHelp : Array (Array a) -> Int -> Int -> Transient a -> Transient a
flattenHelp arrays index len acc =
    if lt index len then
        flattenHelp arrays (add index 1) len (pushAll (unsafeGet arrays index) 0 acc)

    else
        acc


mapAndFlattenHelp : (a -> Array b) -> Array a -> Int -> Int -> Transient b -> Transient b
mapAndFlattenHelp fn array index len acc =
    if lt index len then
        mapAndFlattenHelp fn array (add index 1) len (pushAll (fn (unsafeGet array index)) 0 acc)

    else
        acc


pushAll : Array a -> Int -> Transient a -> Transient a
pushAll array index acc =
    if lt index (unsafeLength array) then
        pushAll array (add index 1) (T.push acc (unsafeGet array index))

    else
        acc


map2Help : (a -> b -> result) -> Array a -> Array b -> Int -> Int -> Transient result -> Transient result
map2Help fn xs ys index len acc =
    if lt index len then
        map2Help fn xs ys (add index 1) len (T.push acc (fn (unsafeGet xs index) (unsafeGet ys index)))

    else
        acc


map3Help : (a -> b -> c -> result) -> Array a -> Array b -> Array c -> Int -> Int -> Transient result -> Transient result
map3Help fn xs ys zs index len acc =
    if lt index len then
        map3Help fn xs ys zs (add index 1) len (T.push acc (fn (unsafeGet xs index) (unsafeGet ys index) (unsafeGet zs index)))

    else
        acc


{-| A bottom-up merge sort: runs of `width` are merged from `src` into `dst`,
then the two swap, until a run covers the array. Stable, because a merge takes
from the left run when the two compare `EQ`.
-}
sortPasses : (a -> a -> Order) -> Transient a -> Transient a -> Int -> Int -> Transient a
sortPasses fn src dst width len =
    if not (lt width len) then
        src

    else
        sortPasses fn (mergePass fn src dst 0 width len) src (add width width) len


mergePass : (a -> a -> Order) -> Transient a -> Transient a -> Int -> Int -> Int -> Transient a
mergePass fn src dst lo width len =
    if not (lt lo len) then
        dst

    else
        let
            mid =
                min (add lo width) len

            hi =
                min (add mid width) len
        in
        mergePass fn src (mergeRuns fn src dst lo mid mid hi lo) (add lo (add width width)) width len


mergeRuns : (a -> a -> Order) -> Transient a -> Transient a -> Int -> Int -> Int -> Int -> Int -> Transient a
mergeRuns fn src dst i mid j hi out =
    if lt i mid then
        if lt j hi then
            let
                left =
                    T.get src i

                right =
                    T.get src j
            in
            when fn right left is
                LT ->
                    mergeRuns fn src (T.set dst out right) i mid (add j 1) hi (add out 1)

                _ ->
                    mergeRuns fn src (T.set dst out left) (add i 1) mid j hi (add out 1)

        else
            mergeRuns fn src (T.set dst out (T.get src i)) (add i 1) mid j hi (add out 1)

    else if lt j hi then
        mergeRuns fn src (T.set dst out (T.get src j)) i mid (add j 1) hi (add out 1)

    else
        dst


@prim("arr_set")
primSet : Array a -> Int -> a -> Array a


@prim("arr_slice")
primSlice : Array a -> Int -> Int -> Array a


@prim("arr_append")
primAppend : Array a -> Array a -> Array a


@prim("arr_insert")
primInsert : Array a -> Int -> a -> Array a


@prim("arr_remove")
primRemove : Array a -> Int -> Array a
