module Test.Result exposing (tests)

import Basics exposing (..)
import Math
import Expect
import Result exposing (Result(..))
import String
import Test exposing (..)


isEven n =
    if modBy 2 n == 0 then
        Ok n

    else
        Err "number is odd"


{-| `Ok 3` has no error type of its own, and `==` is chosen by one. -}
equalWithStringError : (Eq a, Inspect a) => Result String a -> Result String a -> Expect.Expectation
equalWithStringError =
    Expect.equal


toIntResult : String -> Result String Int
toIntResult s =
    when String.toInt s is
        Just i ->
            Ok i

        Nothing ->
            Err <| "could not convert string '" ++ s ++ "' to an Int"


add3 a b c =
    a + b + c


add4 a b c d =
    a + b + c + d


tests : Test
tests =
    describe "Result"
        [ describe "firstOk"
            [ test "Ok" <| \{} -> Expect.equal (Just 5) (Result.firstOk [ Ok 5, Err 0, Ok 10 ])
            , test "Err" <| \{} -> Expect.equal Nothing (Result.firstOk [ Err 1, Err 2, Err 3 ])
            ]
        , describe "allOk"
            [ test "Ok" <|
                \{} ->
                    let
                        oks : Array (Result String Int)
                        oks =
                            [ Ok 0, Ok 1 ]
                    in
                    Expect.equal (Ok [ 0, 1 ]) (Result.allOk oks)
            , test "Err" <| \{} -> Expect.equal (Err [ 0 ]) (Result.allOk [ Ok 5, Err 0, Ok 10 ])
            ]
        , describe "map"
            [ test "Ok" <| \{} -> equalWithStringError (Ok 3) (Result.map ((+) 1) (Ok 2))
            , test "Err" <| \{} -> Expect.equal (Err "error") (Result.map ((+) 1) (Err "error"))
            ]
        , describe "mapN"
            [ test "map2 Ok" <| \{} -> equalWithStringError (Ok 3) (Result.map2 (+) (Ok 1) (Ok 2))
            , test "map2 Err" <| \{} -> Expect.equal (Err "x") (Result.map2 (+) (Ok 1) (Err "x"))
            , test "map3 Ok" <| \{} -> equalWithStringError (Ok 6) (Result.map3 add3 (Ok 1) (Ok 2) (Ok 3))
            , test "map3 Err" <| \{} -> Expect.equal (Err "x") (Result.map3 add3 (Ok 1) (Ok 2) (Err "x"))
            , test "andMap Ok" <| \{} -> equalWithStringError (Ok 10) (Ok add4 |> Result.andMap (Ok 1) |> Result.andMap (Ok 2) |> Result.andMap (Ok 3) |> Result.andMap (Ok 4))
            , test "andMap Err" <| \{} -> Expect.equal (Err "x") (Ok add4 |> Result.andMap (Ok 1) |> Result.andMap (Ok 2) |> Result.andMap (Ok 3) |> Result.andMap (Err "x"))
            ]
        , describe "andThen"
            [ test "andThen Ok" <| \{} -> Expect.equal (Ok 42) (toIntResult "42" |> Result.andThen isEven)
            , test "andThen first Err" <|
                \{} ->
                    Expect.equal
                        (Err "could not convert string '4.2' to an Int")
                        (toIntResult "4.2" |> Result.andThen isEven)
            , test "andThen second Err" <|
                \{} ->
                    Expect.equal
                        (Err "number is odd")
                        (toIntResult "41" |> Result.andThen isEven)
            ]
        , describe "onError"
            [ test "Ok" <|
                \{} -> 
                    equalWithStringError
                        (Ok 42)
                        (toIntResult "42" |> Result.onError (\_ -> Ok 0))
            , test "Err" <|
                \{} ->
                    equalWithStringError
                        (Ok 0)
                        (toIntResult "4.2" |> Result.onError (\_ -> Ok 0))
            ]
        -- From `harness/coverage.py`'s survey (geng-lang m1b-test.md §TS9.2).
        , describe "hasValue"
            [ test "Ok with the value" <| \{} -> Expect.equal True (Result.hasValue 42 (toIntResult "42"))
            , test "Ok with another value" <| \{} -> Expect.equal False (Result.hasValue 41 (toIntResult "42"))
            , test "Err" <| \{} -> Expect.equal False (Result.hasValue 42 (toIntResult "x"))
            ]
        , describe "checkValue"
            [ test "Ok that passes" <| \{} -> Expect.equal True (Result.checkValue (\n -> n > 40) (toIntResult "42"))
            , test "Ok that fails" <| \{} -> Expect.equal False (Result.checkValue (\n -> n > 50) (toIntResult "42"))
            , test "Err" <| \{} -> Expect.equal False (Result.checkValue (\_ -> True) (toIntResult "x"))
            ]
        , describe "withDefaultLazy"
            [ test "Ok answers its value" <|
                \{} -> Expect.equal 42 (Result.withDefaultLazy (\{} -> -1) (toIntResult "42"))
            , test "Err asks for it" <|
                \{} -> Expect.equal 7 (Result.withDefaultLazy (\{} -> 7) (toIntResult "x"))
            ]
        ]
