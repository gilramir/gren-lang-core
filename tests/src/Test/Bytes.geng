module Test.Bytes exposing (tests)

import Bytes exposing (Bytes)
import Bytes.Decode as BD
import Bytes.Encode
import Expect
import Fuzz
import Int8
import Test exposing (..)


encodeInt : Int -> Bytes
encodeInt i =
    Bytes.Encode.encode <|
        Bytes.Encode.signedInt8 (Int8.fromIntWrap i)


tests : Test
tests =
    describe "Bytes"
        [ describe "Byte comparison"
            [ fuzz Fuzz.string "same strings are equal" <| \s ->
                Expect.equal (Bytes.fromString s) (Bytes.fromString s)
            , fuzz (Fuzz.intRange -128 127) "same ints are equal" <| \i ->
                Expect.equal (encodeInt i) (encodeInt i)
            , fuzz Fuzz.string "different strings are not equal" <| \s ->
                Expect.notEqual (Bytes.fromString s) (Bytes.fromString (s ++ "a"))
            , fuzz (Fuzz.intRange -100 100) "different ints are not equal" <| \i ->
                Expect.notEqual (encodeInt i) (encodeInt (i + 1))
            ]
        , describe "Flatten"
            [ fuzz Fuzz.string "Joins bytes together" <| \s ->
                Expect.equal
                    (Bytes.fromString (s ++ s ++ s))
                    (Bytes.flatten
                        [ Bytes.fromString s
                        , Bytes.fromString s
                        , Bytes.fromString s
                        ]
                    )
            ]
        , describe "String conversion"
            [ test "Byte order mark at start of bytes survives" <| \{} ->
                Expect.equal
                    (Just "\u{FEFF}a")
                    (Bytes.toString (Bytes.fromString "\u{FEFF}a"))
            , fuzz Fuzz.string "fromString -> toString ends up the same" <| \str ->
                Expect.equal
                    (Just str)
                    (Bytes.toString (Bytes.fromString str))
            , test "toHexString" <| \{} ->
                Expect.equal
                    "546865736520617265206d7920f09f988e204279746573"
                    (Bytes.toHexString { padding = False } (Bytes.fromString "These are my \u{1F60E} Bytes"))
            , test "toHexString padded" <| \{} ->
                Expect.equal
                    "54 68 65 73 65 20 61 72 65 20 6d 79 20 f0 9f 98 8e 20 42 79 74 65 73"
                    (Bytes.toHexString { padding = True } (Bytes.fromString "These are my \u{1F60E} Bytes"))
            , fuzz (Fuzz.array (Fuzz.intRange 0 0x10FFFF)) "fromCodePoints is fromString of the same characters (m4-visiterm.md D905)" <| \codePoints ->
                let
                    scalars =
                        Array.keepIf (\c -> c < 0xD800 || c > 0xDFFF) codePoints
                in
                Expect.equal
                    (Ok (Bytes.fromString (String.fromArray (Array.mapAndKeepJust Char.fromCode scalars))))
                    (Bytes.fromCodePoints scalars)
            , fuzz2 (Fuzz.array (Fuzz.intRange 0 0xD7FF)) (Fuzz.intRange 0xD800 0xDFFF) "fromCodePoints answers where the first surrogate is" <| \before surrogate ->
                Expect.equal
                    (Err (Array.length before))
                    (Bytes.fromCodePoints (before ++ [ surrogate, 0x41, -1 ]))
            , test "fromCodePoints refuses past 0x10FFFF and below 0" <| \{} ->
                Expect.equal
                    [ Err 0, Err 1, Ok (Bytes.fromString "\u{10FFFF}") ]
                    [ Bytes.fromCodePoints [ 0x110000 ], Bytes.fromCodePoints [ 0x41, -1 ], Bytes.fromCodePoints [ 0x10FFFF ] ]
            , test "toHexString empty" <| \{} ->
                Expect.equal
                    ""
                    (Bytes.toHexString { padding = True } Bytes.empty)
            ]
        , describe "Decode"
            [ test "Decode.bytes holds only the bytes it read" <| \{} ->
                let
                    original =
                        Bytes.fromString "ABCD"

                    firstThree =
                        when BD.decode (BD.bytes 3) original is
                            Just bytes ->
                                bytes

                            Nothing ->
                                Bytes.empty
                in
                Expect.all
                    [ \_ ->
                        BD.decode (BD.bytes 4) firstThree
                            |> Expect.equal Nothing
                    , \_ ->
                        Expect.equal
                            firstThree
                            (Bytes.fromString "ABC")
                    ]
                    {}
            , test "Decode.fail makes decode return Nothing" <| \{} ->
                Expect.equal
                    Nothing
                    (BD.decode (BD.fail : BD.Decoder Int) Bytes.empty)
            ]
        ]
